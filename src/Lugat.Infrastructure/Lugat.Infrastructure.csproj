    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <!-- The official vocabulary list is an Excel file (spec §2.1); MIT, reads .xls and .xlsx. -->
    <PackageReference Include="ExcelDataReader" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lugat.Application\Lugat.Application.csproj" />
  </ItemGroup>

</Project>
