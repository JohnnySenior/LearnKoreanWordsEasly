@page "/topik-yozish"
@page "/topik-yozish/{Id:guid}"
@using KoreanAiTeacher.Contracts
@using KoreanAiTeacher.Domain.Essays
@inject SessionService Api
@inject NavigationManager Nav
@inject TelegramInterop Telegram
@implements IDisposable

<PageTitle>TOPIK yozish — TOPIK yordamchi</PageTitle>

@* TOPIK II writing 51–54 (D-49): an AI-made or own question, the learner's answer, marking with the official criteria. *@
@if (Id is null)
{
    <a class="back" href="mashq">← Mashq</a>
    <header class="page-head">
        <div>
            <h1>TOPIK yozish <span lang="ko">(쓰기)</span></h1>
            <span class="muted small-text">51–54-savollar. AI TOPIK mezonlari bo‘yicha baholaydi va xatolarni tushuntiradi.</span>
        </div>
    </header>

    <section class="card">
        <span class="kicker">Savol turi</span>
        <div class="essay-tasks" role="radiogroup" aria-label="Savol turi">
            @foreach (var (task, title, note) in Tasks)
            {
                var t = task;
                <button class="essay-task @(_task == t ? "selected" : "")" role="radio" aria-checked="@(_task == t)" @onclick="() => _task = t">
                    <strong>@((int)t)</strong>
                    <span><span class="t">@title</span><span class="s">@note</span></span>
                </button>
            }
        </div>

        <span class="kicker" style="margin-top:14px">Savol</span>
        <div class="seg" role="radiogroup" aria-label="Savol manbasi">
            <button class="@(_source == EssaySource.Ai ? "selected" : "")" role="radio" aria-checked="@(_source == EssaySource.Ai)" @onclick="() => _source = EssaySource.Ai">AI tuzsin</button>
            <button class="@(_source == EssaySource.Own ? "selected" : "")" role="radio" aria-checked="@(_source == EssaySource.Own)" @onclick="() => _source = EssaySource.Own">O‘z savolim</button>
        </div>
        @if (_source == EssaySource.Own)
        {
            <label class="field">
                Savol matni (koreyscha, qog‘ozdagidek)
                <textarea class="input" lang="ko" rows="6" maxlength="3000" @bind="_ownText" @bind:event="oninput" placeholder="@(_task is EssayTask.Q51 or EssayTask.Q52 ? "Matn ichida ㉠ va ㉡ bo‘lsin" : "")"></textarea>
            </label>
            <label class="field">
                Ko‘rsatma (ixtiyoriy)
                <input class="input" lang="ko" maxlength="500" @bind="_ownInstruction" placeholder="Bo‘sh qolsa, odatdagi ko‘rsatma" />
            </label>
        }
        else
        {
            <p class="muted small-text">AI TOPIK II uslubida yangi savol tuzadi. Bu rasmiy imtihon savoli emas, mashq uchun.</p>
        }

        @if (_error is not null)
        {
            <div class="notice" role="alert">@_error</div>
        }
        <button class="button primary block" disabled="@(_busy || _source == EssaySource.Own && string.IsNullOrWhiteSpace(_ownText))" @onclick="CreateAsync">
            @(_busy ? "AI savol tuzmoqda…" : "Boshlash")
        </button>
    </section>

    @if (_list is { Count: > 0 })
    {
        <h2 class="kicker section-title">Oldingi ishlar</h2>
        <nav class="menu" aria-label="Oldingi ishlar">
            @foreach (var e in _list)
            {
                <a href="topik-yozish/@e.Id">
                    <span class="no">@((int)e.Task)</span>
                    <span><span class="t" lang="ko">@e.Preview</span><span class="s">@Format.LessonDate(e.CreatedAt) · @(e.Score is { } s ? $"{s} / {e.MaxScore} ball" : "yozilmoqda")</span></span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                </a>
            }
        </nav>
    }
    return;
}

<a class="back" href="topik-yozish">← TOPIK yozish</a>

@if (_essay is null)
{
    <p class="muted">@(_error ?? "Yuklanmoqda…")</p>
    return;
}

<div class="tags">
    <span class="pill pill-dark">@((int)_essay.Task)-savol · @_essay.MaxScore ball</span>
    <span class="pill">@(_essay.Source == EssaySource.Ai ? "TOPIK uslubida (AI)" : "O‘z savolingiz")</span>
</div>
<section class="paper essay-question" lang="ko">
    <p><strong>@_essay.InstructionKo</strong></p>
    <p class="pre">@_essay.Text</p>
</section>

@if (_essay.Status == EssayStatus.Writing)
{
    @if (Gaps)
    {
        <label class="field">㉠ <input class="input sentence" lang="ko" maxlength="200" @bind="_gapA" @bind:event="oninput" @bind:after="DraftChangedAsync" disabled="@_busy" /></label>
        <label class="field">㉡ <input class="input sentence" lang="ko" maxlength="200" @bind="_gapB" @bind:event="oninput" @bind:after="DraftChangedAsync" disabled="@_busy" /></label>
    }
    else
    {
        <label class="field">
            Javobingiz (yozma uslub: -ㄴ/는다)
            <textarea class="input essay-text" lang="ko" rows="@(_essay.Task == EssayTask.Q54 ? 14 : 8)" maxlength="2000" @bind="_text" @bind:event="oninput" @bind:after="DraftChangedAsync" disabled="@_busy"></textarea>
        </label>
        <p class="essay-count @(InRange ? "" : "off")" role="status">@Count belgi · kerak: @_essay.MinChars–@_essay.MaxChars</p>
    }
    @if (_error is not null)
    {
        <div class="notice" role="alert">@_error</div>
    }
    <p class="muted small-text" role="status">@_draftStatus</p>
    @if (_recoverableDraft is not null)
    {
        <button class="button" @onclick="RestoreLocalDraftAsync">Qurilmadagi boshqa qoralamani tiklash</button>
    }
    <button class="button primary block" disabled="@(_busy || !Ready)" @onclick="SubmitAsync">@(_busy ? "AI tekshirmoqda… (1 daqiqagacha)" : "Tekshirish")</button>
    <p class="muted small-text">Bo‘shliqlar ham belgi hisoblanadi (원고지 kabi). Matningiz tekshirishdan oldin saqlanadi.</p>
    return;
}

@if (_essay.Feedback is { } fb)
{
    <section class="card essay-score">
        <span class="kicker">Ball</span>
        <p class="big-score"><strong>@fb.Score</strong> / @fb.Max</p>
        <ul class="ladder-scores">
            @foreach (var c in fb.Criteria)
            {
                <li>
                    <span><span lang="@(c.Name.Length == 1 ? "ko" : null)">@c.Name</span><br /><span class="muted small-text">@c.CommentUz</span></span>
                    <strong>@c.Score / @c.Max</strong>
                </li>
            }
        </ul>
        <p>@fb.SummaryUz</p>
    </section>

    <h2 class="kicker section-title">Sizning javobingiz</h2>
    <div class="paper pre" lang="ko">@string.Join("\n", Gaps && _essay.Answers.Count == 2 ? [$"㉠ {_essay.Answers[0]}", $"㉡ {_essay.Answers[1]}"] : _essay.Answers)</div>
    @if (!Gaps && _essay.Answers.Count == 1)
    {
        <p class="muted small-text">@CountOf(_essay.Answers[0]) belgi · kerak: @_essay.MinChars–@_essay.MaxChars</p>
    }

    @if (fb.Corrections.Count > 0)
    {
        <h2 class="kicker section-title">Tuzatishlar</h2>
        <ul class="mistake-list">
            @foreach (var c in fb.Corrections)
            {
                <li>
                    <p class="sentence" lang="ko" style="margin:0"><s>@c.Original</s> → <strong>@c.Corrected</strong></p>
                    <p class="muted small-text" style="margin:4px 0 0">@c.ExplanationUz</p>
                </li>
            }
        </ul>
    }

    @if (fb.Improved is not null)
    {
        <h2 class="kicker section-title">Yaxshilangan variant</h2>
        <div class="paper pre" lang="ko">@fb.Improved</div>
    }

    @if (_essay.ModelAnswers.Count > 0)
    {
        <details style="margin-top:12px">
            <summary>AI namunasi</summary>
            <div class="paper pre" lang="ko">@string.Join("\n", _essay.ModelAnswers.Select((m, i) => Gaps ? (i == 0 ? "㉠ " : "㉡ ") + m : m))</div>
        </details>
    }

    @if (_error is not null)
    {
        <div class="notice" role="alert">@_error</div>
    }
    <button class="button primary block" style="margin-top:16px" disabled="@_busy" @onclick="RetryAsync">Shu savolni qayta yozish</button>
    <a class="button block" href="topik-yozish" style="margin-top:8px">Yangi savol</a>
}

@code {
    [Parameter] public Guid? Id { get; set; }

    private static readonly (EssayTask Task, string Title, string Note)[] Tasks =
    [
        (EssayTask.Q51, "Amaliy matn", "Xat, e’lon · ㉠ ㉡ · 10 ball"),
        (EssayTask.Q52, "Tushuntirish matni", "Paragraf · ㉠ ㉡ · 10 ball"),
        (EssayTask.Q53, "Ma’lumotni tasvirlash", "Grafik, so‘rovnoma · 200–300 belgi · 30 ball"),
        (EssayTask.Q54, "Insho", "Fikr bildirish · 600–700 belgi · 50 ball"),
    ];

    private List<EssaySummaryDto>? _list;
    private EssayDto? _essay;
    private EssayTask _task = EssayTask.Q53;
    private EssaySource _source = EssaySource.Ai;
    private string _ownText = "";
    private string _ownInstruction = "";
    private string _gapA = "";
    private string _gapB = "";
    private string _text = "";
    private bool _busy;
    private string? _error;
    private Guid? _pendingId;
    private CancellationTokenSource? _draftDelay;
    private int _draftRevision;
    private readonly SemaphoreSlim _draftSaveGate = new(1, 1);
    private string? _draftStatus;
    private LocalDraft? _recoverableDraft;
    private sealed record LocalDraft(IReadOnlyList<string> Answers, uint Version);
    private string? DraftKey => Id is { } id && Api.State.Me is { } me ? $"kat.essay-draft.{me.TelegramUserId}.{id}" : null;
    private IReadOnlyList<string> CurrentAnswers => Gaps ? [_gapA, _gapB] : [_text];

    private bool Gaps => _essay?.Task is EssayTask.Q51 or EssayTask.Q52;

    private static int CountOf(string text) => text.Replace("\r", "").Replace("\n", "").Length;

    private int Count => CountOf(_text);

    private bool InRange => _essay is { MinChars: { } min, MaxChars: { } max } && Count >= min && Count <= max;

    private bool Ready => Gaps ? !string.IsNullOrWhiteSpace(_gapA) && !string.IsNullOrWhiteSpace(_gapB) : Count >= 20;

    protected override async Task OnParametersSetAsync()
    {
        _draftDelay?.Cancel();
        _recoverableDraft = null;
        _error = null;
        if (Id is { } id)
        {
            var result = await Api.GetAsync<EssayDto>($"api/essays/{id}");
            Load(result.Value);
            _error = result.Ok ? null : result.Error;
            if (DraftKey is { } key)
            {
                try
                {
                    var raw = await Telegram.StorageGetAsync(key);
                    var draft = raw is null ? null : System.Text.Json.JsonSerializer.Deserialize<LocalDraft>(raw, SessionService.Json);
                    if (_essay?.Status == EssayStatus.Checked) await Telegram.StorageRemoveAsync(key);
                    else if (draft is not null && _essay is not null)
                    {
                        if (draft.Version == _essay.Version) ApplyLocalDraft(draft);
                        else if (!draft.Answers.SequenceEqual(_essay.Answers)) _recoverableDraft = draft;
                    }
                }
                catch (System.Text.Json.JsonException) { await Telegram.StorageRemoveAsync(key); }
            }
        }
        else
        {
            _essay = null;
            _list = (await Api.GetAsync<List<EssaySummaryDto>>("api/essays")).Value ?? [];
        }
    }

    private void Load(EssayDto? essay)
    {
        _essay = essay;
        var answers = essay?.Answers ?? [];
        // A text saved before a failed check comes back, so nothing is written twice.
        _gapA = answers.Count == 2 ? answers[0] : "";
        _gapB = answers.Count == 2 ? answers[1] : "";
        _text = answers.Count == 1 ? answers[0] : "";
    }

    private void ApplyLocalDraft(LocalDraft draft)
    {
        if (Gaps && draft.Answers.Count == 2) { _gapA = draft.Answers[0]; _gapB = draft.Answers[1]; }
        else if (!Gaps && draft.Answers.Count == 1) _text = draft.Answers[0];
        _draftStatus = "Qurilmadagi qoralama tiklandi.";
    }

    private async Task RestoreLocalDraftAsync()
    {
        if (_recoverableDraft is not { } draft) return;
        ApplyLocalDraft(draft);
        _recoverableDraft = null;
        await DraftChangedAsync();
    }

    private async Task DraftChangedAsync()
    {
        if (_essay is not { Status: EssayStatus.Writing } essay || DraftKey is not { } key) return;
        var answers = CurrentAnswers;
        var revision = ++_draftRevision;
        var stored = await Telegram.StorageSetAsync(key, System.Text.Json.JsonSerializer.Serialize(new LocalDraft(answers, essay.Version), SessionService.Json));
        _draftStatus = stored ? "Qoralama qurilmada saqlandi." : "Qurilma saqlashi ishlamadi; serverga saqlanmoqda…";
        _draftDelay?.Cancel();
        using var delay = new CancellationTokenSource();
        _draftDelay = delay;
        try
        {
            await Task.Delay(800, delay.Token);
            if (_busy || Id != essay.Id) return;
            await _draftSaveGate.WaitAsync(delay.Token);
            ApiResult<EssayDto> saved;
            try
            {
                if (_busy || Id != essay.Id) return;
                saved = await Api.SendJsonAsync<EssayDto>(HttpMethod.Put, $"api/essays/{essay.Id}/draft", new SaveEssayDraftRequest(answers, _essay.Version));
                if (Id == essay.Id && saved.Value is { } updated) _essay = _essay with { Version = updated.Version };
            }
            finally { _draftSaveGate.Release(); }
            if (Id != essay.Id) return;
            if (revision != _draftRevision) return;
            _draftStatus = saved.Ok ? "Qoralama serverda ham saqlandi." : saved.Error;
            if (saved.Value is { } latest)
                await Telegram.StorageSetAsync(key, System.Text.Json.JsonSerializer.Serialize(new LocalDraft(CurrentAnswers, latest.Version), SessionService.Json));
        }
        catch (OperationCanceledException) { }
        finally { if (_draftDelay == delay) _draftDelay = null; }
    }

    public void Dispose() => _draftDelay?.Cancel();

    private async Task CreateAsync()
    {
        _busy = true;
        _error = null;
        var id = _pendingId ??= Guid.NewGuid();
        var request = new CreateEssayRequest(id, _task, _source, _ownInstruction, _ownText);
        var result = await Api.SendJsonAsync<EssayDto>(HttpMethod.Post, "api/essays", request, SessionService.AiTimeout);
        _busy = false;
        if (result.Value is { } essay)
        {
            _pendingId = null;
            Nav.NavigateTo($"topik-yozish/{essay.Id}");
            return;
        }

        _pendingId = result.Status == 0 ? id : null;
        _error = result.Error;
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        _draftDelay?.Cancel();
        IReadOnlyList<string> answers = CurrentAnswers;
        var result = await Api.SendJsonAsync<EssayDto>(HttpMethod.Post, $"api/essays/{_essay!.Id}/submit", new SubmitEssayRequest(answers), SessionService.AiTimeout);
        _busy = false;
        if (result.Value is { } essay)
        {
            Load(essay);
            if (DraftKey is { } key) await Telegram.StorageRemoveAsync(key);
            return;
        }

        _error = result.Error; // the text stays in the box and was saved on the server
    }

    private async Task RetryAsync()
    {
        _busy = true;
        var id = _pendingId ??= Guid.NewGuid();
        var result = await Api.SendJsonAsync<EssayDto>(HttpMethod.Post, $"api/essays/{_essay!.Id}/retry", new RetryEssayRequest(id));
        _busy = false;
        if (result.Value is { } essay)
        {
            _pendingId = null;
            Nav.NavigateTo($"topik-yozish/{essay.Id}");
            return;
        }

        _pendingId = result.Status == 0 ? id : null;
        _error = result.Error;
    }
}

