@page "/grammatika/{ImportId:guid}"
@using KoreanAiTeacher.Contracts
@using KoreanAiTeacher.Domain.Grammar
@inject SessionService Api

<PageTitle>Grammatikani tekshirish — TOPIK yordamchi</PageTitle>

<a class="back" href="grammatika/kitob">← Kitob va betlar</a>

@if (_job is null)
{
    <h1>Tekshirish</h1>
    <p class="muted">@(_error ?? "Yuklanmoqda…")</p>
    return;
}

<h1>@_job.FromPage–@_job.ToPage-betlar</h1>
<p class="muted small-text">Koreyscha shakl va misollar kitobdan ko‘chirilgan, o‘zbekcha izohni AI yozgan. Kitob bilan solishtirib tasdiqlang. Belgilangan bandlarni albatta o‘zingiz ko‘ring.</p>

@if (_error is not null)
{
    <div class="notice" role="alert">@_error</div>
}

<div class="chips" aria-label="Betlar">
    @for (var p = _job.FromPage; p <= (_job.DonePage ?? _job.FromPage - 1); p++)
    {
        var pageNo = p;
        <button class="chip @(pageNo == _page ? "selected" : "")" aria-pressed="@(pageNo == _page)" @onclick="() => SelectPageAsync(pageNo)">@pageNo</button>
    }
</div>

@if (_items is null)
{
    <p class="muted">Yuklanmoqda…</p>
}
else if (_items.Count == 0)
{
    <p class="muted">Bu betda grammatika bandi topilmadi.</p>
}
else
{
    var ready = _items.Count(i => i.Status == GrammarItemStatus.NeedsReview && !i.Flagged);
    @if (ready > 0)
    {
        <button class="button primary" disabled="@_busy" @onclick="ApprovePageAsync">Belgilanmagan @ready ta bandni tasdiqlash</button>
    }

    @foreach (var i in _items)
    {
        <article class="card entry @(i.Status == GrammarItemStatus.Excluded ? "excluded" : "")">
            @if (_editing == i.Id)
            {
                <label class="field">Shakl <input class="input ko" lang="ko" @bind="_edit.Form" /></label>
                <label class="field">O‘xshash shakllar <input class="input ko" lang="ko" @bind="_edit.Similar" /></label>
                <label class="field">Kitobdagi ma’no <input class="input ko" lang="ko" @bind="_edit.MeaningKo" /></label>
                <label class="field">O‘zbekcha ma’no <textarea class="input" rows="3" @bind="_edit.MeaningUz"></textarea></label>
                <label class="field">Qanday qo‘shiladi <textarea class="input" rows="2" @bind="_edit.ConnectionUz"></textarea></label>
                <label class="field">Cheklov <textarea class="input" rows="2" @bind="_edit.RestrictionUz"></textarea></label>
                @for (var k = 0; k < _edit.Examples.Count; k++)
                {
                    var index = k;
                    <label class="field">Misol @(index + 1) <input class="input ko" lang="ko" @bind="_edit.Examples[index].Korean" /></label>
                    <label class="field">Tarjimasi <input class="input" @bind="_edit.Examples[index].Uzbek" /></label>
                }
                <div>
                    <button class="button primary" disabled="@_busy" @onclick="() => SaveAsync(i, GrammarItemStatus.Approved)">Saqlash va tasdiqlash</button>
                    <button class="button" disabled="@_busy" @onclick="() => SaveAsync(i, null)">Saqlash</button>
                    <button class="button" @onclick="() => _editing = null">Bekor qilish</button>
                </div>
            }
            else
            {
                <div class="row-between">
                    <div>
                        @if (i.Number is { } n)
                        {
                            <span class="muted">@n. </span>
                        }
                        <span class="ko big" lang="ko">@i.Form</span>
                    </div>
                    <span class="pill @(i.Status == GrammarItemStatus.Approved ? "pill-ok" : i.Flagged ? "pill-warn" : "")">@StatusText(i)</span>
                </div>
                @if (i.Section is not null || i.MeaningKo is not null)
                {
                    <p class="muted" lang="ko">@string.Join(" · ", new[] { i.Section, i.MeaningKo }.Where(x => x is not null))</p>
                }
                @if (i.Similar is not null)
                {
                    <p class="small-text">O‘xshash: <span lang="ko">@i.Similar</span></p>
                }
                <p>@i.MeaningUz</p>
                @if (i.ConnectionUz is not null)
                {
                    <p class="small-text"><strong>Qo‘shilishi:</strong> @i.ConnectionUz</p>
                }
                @if (i.RestrictionUz is not null)
                {
                    <p class="small-text"><strong>Cheklov:</strong> @i.RestrictionUz</p>
                }
                @foreach (var e in i.Examples)
                {
                    <p class="small-text"><span lang="ko">@e.Korean</span><br /><span class="muted">@e.Uzbek</span></p>
                }
                @if (i.Warning is not null)
                {
                    <p class="notice small-text">@i.Warning</p>
                }
                <div>
                    @if (i.Status != GrammarItemStatus.Approved)
                    {
                        <button class="button small" disabled="@_busy" @onclick="() => SetStatusAsync(i, GrammarItemStatus.Approved)">Tasdiqlash</button>
                    }
                    <button class="button small" @onclick="() => StartEdit(i)">Tahrirlash</button>
                    @if (i.Status != GrammarItemStatus.Excluded)
                    {
                        <button class="button small" disabled="@_busy" @onclick="() => SetStatusAsync(i, GrammarItemStatus.Excluded)">Chiqarish</button>
                    }
                    else
                    {
                        <button class="button small" disabled="@_busy" @onclick="() => SetStatusAsync(i, GrammarItemStatus.NeedsReview)">Qaytarish</button>
                    }
                </div>
            }
        </article>
    }
}

@code {
    [Parameter] public Guid ImportId { get; set; }

    private sealed class EditableExample
    {
        public string Korean { get; set; } = "";

        public string Uzbek { get; set; } = "";
    }

    private sealed class EditState
    {
        public string Form { get; set; } = "";
        public string Similar { get; set; } = "";
        public string MeaningKo { get; set; } = "";
        public string MeaningUz { get; set; } = "";
        public string ConnectionUz { get; set; } = "";
        public string RestrictionUz { get; set; } = "";
        public List<EditableExample> Examples { get; set; } = [];
    }

    private GrammarImportDto? _job;
    private List<GrammarItemDto>? _items;
    private int _page;
    private Guid? _editing;
    private EditState _edit = new();
    private bool _busy;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        var job = await Api.GetAsync<GrammarImportDto>($"api/grammar/imports/{ImportId}");
        _job = job.Value;
        _error = job.Ok ? null : job.Error;
        if (_job is not null)
        {
            await SelectPageAsync(_job.FromPage);
        }
    }

    private async Task SelectPageAsync(int page)
    {
        _page = page;
        _editing = null;
        var result = await Api.GetAsync<List<GrammarItemDto>>($"api/grammar/imports/{ImportId}/items?page={page}");
        _items = result.Value ?? [];
        _error = result.Ok ? null : result.Error;
    }

    private async Task ApprovePageAsync()
    {
        _busy = true;
        var result = await Api.SendJsonAsync<object>(HttpMethod.Post, $"api/grammar/imports/{ImportId}/pages/{_page}/approve");
        _busy = false;
        _error = result.Ok ? null : result.Error;
        await SelectPageAsync(_page);
    }

    private void StartEdit(GrammarItemDto i)
    {
        _editing = i.Id;
        _edit = new EditState
        {
            Form = i.Form,
            Similar = i.Similar ?? "",
            MeaningKo = i.MeaningKo ?? "",
            MeaningUz = i.MeaningUz,
            ConnectionUz = i.ConnectionUz ?? "",
            RestrictionUz = i.RestrictionUz ?? "",
            Examples = i.Examples.Select(e => new EditableExample { Korean = e.Korean, Uzbek = e.Uzbek })
                .Concat(Enumerable.Range(0, Math.Max(0, 3 - i.Examples.Count)).Select(_ => new EditableExample()))
                .ToList(),
        };
    }

    private Task SetStatusAsync(GrammarItemDto i, GrammarItemStatus status) =>
        PatchAsync(i, new UpdateGrammarItemRequest(null, null, null, null, null, null, null, status, i.Version));

    private async Task SaveAsync(GrammarItemDto i, GrammarItemStatus? status)
    {
        var examples = _edit.Examples.Where(e => !string.IsNullOrWhiteSpace(e.Korean)).Select(e => new GrammarExample(e.Korean, e.Uzbek)).ToList();
        if (await PatchAsync(i, new UpdateGrammarItemRequest(_edit.Form, _edit.Similar, _edit.MeaningKo, _edit.MeaningUz, _edit.ConnectionUz, _edit.RestrictionUz, examples, status, i.Version)))
        {
            _editing = null;
        }
    }

    private async Task<bool> PatchAsync(GrammarItemDto i, UpdateGrammarItemRequest body)
    {
        _busy = true;
        var result = await Api.SendJsonAsync<GrammarItemDto>(HttpMethod.Patch, $"api/grammar/items/{i.Id}", body);
        _busy = false;
        if (!result.Ok)
        {
            _error = result.Error;
            if (result.Status == 409)
            {
                await SelectPageAsync(_page);
            }

            return false;
        }

        _error = null;
        var index = _items!.FindIndex(x => x.Id == i.Id);
        _items[index] = result.Value!;
        return true;
    }

    private static string StatusText(GrammarItemDto i) => i.Status switch
    {
        GrammarItemStatus.Approved => "Tasdiqlangan",
        GrammarItemStatus.Excluded => "Chiqarilgan",
        _ when i.Flagged => "Ko‘rib chiqing",
        _ => "Tekshirilmagan",
    };
}
