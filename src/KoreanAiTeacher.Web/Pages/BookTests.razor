@page "/sinov/kitob"
@using KoreanAiTeacher.Contracts
@using KoreanAiTeacher.Domain.Testing
@inject SessionService Api

<PageTitle>Kitobdagi TOPIK testlari — TOPIK yordamchi</PageTitle>

<a class="back" href="sinov">← Sinov</a>
<header class="page-head">
    <div>
        <h1>Kitobdagi TOPIK testlari</h1>
        <span class="muted small-text">O‘qish (읽기) testlari imtihondagidek vaqt bilan</span>
    </div>
</header>

@if (_books is null)
{
    <p class="muted" style="margin-top:16px">@(_error ?? "Yuklanmoqda…")</p>
}
else if (_books.Count == 0)
{
    <p class="muted small-text" style="margin-top:12px">Kitobingizdagi o‘qish testlarini qo‘shing va ularni haqiqiy imtihondagidek vaqt bilan yeching.</p>
}
else
{
    <nav class="menu compact">
        @foreach (var b in _books)
        {
            <a href="@($"sinov/kitob/{b.Id}")">
                <span>
                    <span class="t">@b.Title</span>
                    <span class="s">@b.FileName · @b.FromPage–@b.ToPage-betlar</span>
                    <span class="aside @(b.Status == BookTestStatus.Ready ? "done" : "")">@Status(b)</span>
                </span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </a>
        }
    </nav>
}

<a class="button block" href="sinov/kitob/yangi" style="margin-top:12px">+ Kitobdan test qo‘shish</a>
@if (_books is { Count: > 0 })
{
    <a class="button block" href="sinov/tarix" style="margin-top:8px"><span>Natijalar tahlili</span><span class="aside">ball va savol turlari →</span></a>
}

@code {
    private List<BookTestDto>? _books;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<List<BookTestDto>>("api/book-tests");
        _books = result.Value;
        _error = result.Ok ? null : result.Error;
    }

    private static string Status(BookTestDto b) => b.Status switch
    {
        BookTestStatus.Ready => $"{b.Usable} ta savol · tayyor",
        BookTestStatus.Failed => "To‘xtadi",
        _ => "O‘qilmoqda…",
    };
}
