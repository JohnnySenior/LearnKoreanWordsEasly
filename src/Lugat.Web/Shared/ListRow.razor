@* A settings/menu row (UI handoff): label (and an optional note) left, a value and a chevron right, 1px rule below. *@
@if (Href is not null)
{
    <a class="list-row" href="@Href">@Inner</a>
}
else if (OnClick.HasDelegate)
{
    <button type="button" class="list-row" @onclick="OnClick">@Inner</button>
}
else
{
    <div class="list-row static">@Inner</div>
}

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    [Parameter] public string? Note { get; set; }

    [Parameter] public string? Value { get; set; }

    [Parameter] public string? Href { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>A control in place of the value and chevron, e.g. a toggle or a segmented choice.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private RenderFragment Inner => @<text>
        <span class="list-row-text">
            <span class="list-row-label">@Label</span>
            @if (Note is not null)
            {
                <span class="list-row-note">@Note</span>
            }
        </span>
        @if (ChildContent is not null)
        {
            <span class="list-row-control">@ChildContent</span>
        }
        else
        {
            <span class="list-row-value">
                @if (Value is not null)
                {
                    <span>@Value</span>
                }
                @if (Href is not null || OnClick.HasDelegate)
                {
                    <Icon Name="chevron-right" Size="18" />
                }
            </span>
        }
    </text>;
}
