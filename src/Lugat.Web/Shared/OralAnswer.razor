@implements IAsyncDisposable
@using Lugat.Contracts
@inject SessionService Api
@inject BrowserInterop Audio

@* Oral readiness (TEST02, D-38): the learner says the Korean word; the server hears and grades it. The verdict stays
   hidden until the end (TEST03); only what was heard is shown (AU03). *@
<div class="oral">
    @if (_state == State.Recording)
    {
        <button type="button" class="button big rec-btn" @onclick="StopAsync">
            <span class="rec-dot" aria-hidden="true"></span> To‘xtatish
        </button>
        <p class="speak-note">Koreyschasini ayting… (@MaxSeconds soniyagacha)</p>
    }
    else
    {
        <button type="button" class="button primary big" disabled="@(_state == State.Sending || Disabled)" @onclick="StartAsync">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0" /><path d="M12 18v3" /></svg>
            <span>@(_state == State.Sending ? "Tekshirilmoqda…" : Question.Given is null ? "Aytish" : "Qayta aytish")</span>
        </button>
    }

    @if (Question.Given is { Length: > 0 } heard && _state == State.Idle)
    {
        <p class="heard">Eshitildi: <strong lang="ko">@heard</strong></p>
        <p class="muted small-text">Boshqacha eshitilgan bo‘lsa, qayta ayting. To‘g‘ri yoki xatoligi oxirida ko‘rsatiladi.</p>
    }
    else if (Question.Technical)
    {
        <p class="muted small-text">Texnik xato deb belgilandi: bu savol hisobga olinmaydi.</p>
    }

    @if (_error is not null)
    {
        <p class="speak-note warn" role="alert">@_error</p>
    }

    <div class="oral-tools">
        @if (_hintShown || Question.Assisted)
        {
            <span class="hint-chip" lang="ko">Ishora: @Question.Hint</span>
        }
        else if (Question.Given is null)
        {
            <button type="button" class="button small" @onclick="() => _hintShown = true">Ishora (birinchi bo‘g‘in)</button>
        }
        @if (Question.Given is null && !Question.Technical)
        {
            <button type="button" class="button small" disabled="@(_state != State.Idle || Disabled)" @onclick="TechnicalAsync">Mikrofon ishlamayapti</button>
        }
    </div>
</div>

@code {
    private enum State { Idle, Recording, Sending }

    [Parameter, EditorRequired] public Guid TestId { get; set; }

    [Parameter, EditorRequired] public TestQuestionDto Question { get; set; } = default!;

    [Parameter] public EventCallback<TestDto> OnAnswered { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public int MaxSeconds { get; set; } = 6;

    private State _state;
    private string? _error;
    private bool _hintShown;
    private int? _for;
    private CancellationTokenSource? _watch;

    protected override void OnParametersSet()
    {
        if (_for != Question.Index)
        {
            _for = Question.Index;
            _error = null;
            _hintShown = false;
        }
    }

    private async Task StartAsync()
    {
        _error = null;
        var started = await Audio.StartSpeakingAsync(MaxSeconds * 1000);
        if (!started.Ok)
        {
            _error = started.Error + " Mikrofon bo‘lmasa, «Mikrofon ishlamayapti» ni bosing.";
            return;
        }

        _state = State.Recording;
        _watch = new CancellationTokenSource();
        _ = WatchTimeoutAsync(_watch.Token);
    }

    private async Task WatchTimeoutAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(400, ct);
                if (await Audio.IsSpeakingTimedOutAsync())
                {
                    await InvokeAsync(StopAsync);
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task StopAsync()
    {
        if (_state != State.Recording)
        {
            return;
        }

        _watch?.Cancel();
        _state = State.Sending;
        StateHasChanged();
        var rec = await Audio.StopSpeakingAsync();
        if (!rec.Ok || rec.WavBytes is not { } wav)
        {
            _state = State.Idle;
            _error = rec.Error ?? "Yozuv bo‘lmadi.";
            return;
        }

        var assisted = _hintShown || Question.Assisted;
        var result = await Api.PostSpeechAsync<TestDto>($"api/tests/{TestId}/oral/{Question.Index}", wav,
            new Dictionary<string, string> { ["assisted"] = assisted ? "1" : "0" });
        _state = State.Idle;
        if (result.Value is not { } test)
        {
            _error = result.Error;
            return;
        }

        await OnAnswered.InvokeAsync(test);
    }

    private async Task TechnicalAsync()
    {
        _state = State.Sending;
        var result = await Api.SendJsonAsync<TestDto>(HttpMethod.Post, $"api/tests/{TestId}/oral/{Question.Index}/technical");
        _state = State.Idle;
        if (result.Value is { } test)
        {
            await OnAnswered.InvokeAsync(test);
            return;
        }

        _error = result.Error;
    }

    public async ValueTask DisposeAsync()
    {
        _watch?.Cancel();
        if (_state == State.Recording)
        {
            await Audio.StopSpeakingAsync(discard: true);
        }
    }
}
