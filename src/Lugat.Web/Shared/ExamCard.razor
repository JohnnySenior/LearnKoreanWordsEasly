@using Lugat.Contracts
@using Lugat.Domain.Exams

@* Exam countdown and pace on the Today page (D-34). A pace, never a promise of a score. *@
@switch (Exam.Phase)
{
    case ExamPhase.None:
        <a class="exam-strip link" href="sozlamalar#imtihon">
            <span>TOPIK sanasini kiriting: kun sanog‘i va kunlik reja chiqadi</span><span aria-hidden="true">→</span>
        </a>
        break;

    case ExamPhase.Past:
        <section class="card exam-card">
            <span class="kicker">TOPIK</span>
            <p style="margin:4px 0 8px">@Format.Date(Exam.ExamDate!.Value) dagi imtihon o‘tdi. Keyingisiga tayyorlanayotgan bo‘lsangiz, yangi sanani kiriting.</p>
            <a class="button small" href="sozlamalar#imtihon">Yangi sana</a>
        </section>
        break;

    case ExamPhase.ExamDay:
        <section class="card exam-card">
            <span class="kicker">TOPIK II · 시험 날</span>
            <div class="countdown"><b lang="ko">화이팅!</b></div>
            <p><strong>Bugun imtihon. Omad!</strong></p>
            <p class="muted small-text">Shaxsni tasdiqlovchi hujjat va imtihon varaqasini (수험표) unutmang. Bugun yangi narsa o‘rganmang: bir-ikki kitob savolini ko‘zdan kechirish yetarli.</p>
        </section>
        break;

    default:
        <section class="exam-strip">
            @* Collapsed on Today (D-42): the count at a glance, the plan one tap away. *@
            <button type="button" class="exam-head" aria-expanded="@_open" @onclick="() => _open = !_open">
                <b>@Exam.DaysLeft</b>
                <span class="txt">
                    <strong>@(Exam.DaysLeft == 1 ? "kun · imtihon ertaga" : "kun TOPIK II gacha")</strong>
                    <small>@Format.Date(Exam.ExamDate!.Value)@(Exam.TargetLevel is { } level ? $" · maqsad {level}-daraja" : "")@(Exam.Phase == ExamPhase.FinalWeek ? " · yakuniy hafta" : "")</small>
                </span>
                <span class="chev" aria-hidden="true">@(_open ? "▴" : "▾")</span>
            </button>
            @if (_open)
            {

            @if (Exam.Phase == ExamPhase.FinalWeek)
            {
                <p style="margin-top:10px"><strong>Yakuniy hafta.</strong> Yangi material yo‘q: takrorlash va kitob testlarini imtihon rejimida yechish.</p>
                <ul class="exam-plan">
                    <li>
                        <span>Kitob testi, haftasiga</span>
                        <span class="v">@Exam.MocksLast7Days / @Exam.MocksPerWeek</span>
                    </li>
                </ul>
            }
            else
            {
                <ul class="exam-plan">
                    <li>
                        <span>Yangi so‘z, bugun</span>
                        @if (Exam.WordsPerDay > 0)
                        {
                            <span class="v @(Exam.WordsStartedToday >= Exam.WordsPerDay ? "done" : "")">@Exam.WordsStartedToday / @Exam.WordsPerDay</span>
                        }
                        else
                        {
                            <span class="v muted">hammasi boshlangan</span>
                        }
                    </li>
                    <li>
                        <span>Grammatika, haftasiga</span>
                        <span class="v">@(Exam.GrammarLeft == 0 ? "—" : $"{Exam.GrammarPerWeek} ta band")</span>
                    </li>
                    <li>
                        <span>Kitob testi, haftasiga</span>
                        <span class="v">@Exam.MocksLast7Days / @Exam.MocksPerWeek</span>
                    </li>
                </ul>
                <p class="muted small-text">
                    @Exam.NewWords ta so‘z hali boshlanmagan, @Exam.GrammarLeft ta grammatika mustaqil emas. Ular oxirgi haftadan oldingi @Exam.StudyDays kunga bo‘lindi, oxirgi hafta takrorlash uchun qoldiriladi. Kitob testi faqat imtihon rejimida (vaqt bilan) hisoblanadi.
                    @if (Exam.NewWords == 0)
                    {
                        <text> Yangi jadvallarni <a href="lugatlar">Lug‘atlar</a> bo‘limida tasdiqlang.</text>
                    }
                </p>
            }

            @if (Exam.LastMockScore is { } score)
            {
                <p class="small-text" style="margin-top:6px">Oxirgi kitob testi: <strong>@score / 100</strong> <span class="muted">· @Format.DayMonth(Exam.LastMockAt!.Value)</span> · <a href="sinov/tarix">tarix</a></p>
            }
            @if (Exam.MocksLast7Days < Exam.MocksPerWeek)
            {
                <a class="button small" href="@(Exam.BookTestsReady > 0 ? "sinov/kitob" : "sinov/kitob/yangi")">@(Exam.BookTestsReady > 0 ? "Kitob testini yechish" : "Kitobdan test qo‘shish")</a>
            }
            }
        </section>
        break;
}

@code {
    [Parameter, EditorRequired] public ExamDto Exam { get; set; } = default!;

    private bool _open;
}
