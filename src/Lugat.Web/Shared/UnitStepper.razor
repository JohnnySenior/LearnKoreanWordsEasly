@* The unit's four steps (spec §4.3, UI handoff): Jadval · Karta · Mashq · Test. A done step shows a check; the current
   one has a 3px red underline. A step with OnSelect set is a button. *@
<ol class="stepper @(Compact ? "compact" : "")">
    @for (var i = 0; i < Labels.Length; i++)
    {
        var step = i + 1;
        var state = step == Current ? "current" : Done.Contains(step) ? "done" : "";
        <li class="@state">
            @if (OnSelect.HasDelegate)
            {
                <button type="button" @onclick="() => OnSelect.InvokeAsync(step)" aria-current="@(step == Current ? "step" : null)">@Body(step, state)</button>
            }
            else
            {
                <span aria-current="@(step == Current ? "step" : null)">@Body(step, state)</span>
            }
        </li>
    }
</ol>

@code {
    private static readonly string[] Labels = ["Jadval", "Karta", "Mashq", "Test"];

    /// <summary>
    /// What the learner really did in the unit (L-42): opened its table, started every word in cards, finished a
    /// practice round, passed the test.
    /// </summary>
    public static int[] DoneOf(Lugat.Contracts.UnitSummaryDto unit) =>
        new[] { (1, unit.Opened), (2, unit.WordCount > 0 && unit.Started >= unit.WordCount), (3, unit.Practiced), (4, unit.State == Lugat.Contracts.UnitState.Passed) }
            .Where(s => s.Item2).Select(s => s.Item1).ToArray();

    [Parameter] public int Current { get; set; } = 1;

    /// <summary>Steps really done (L-42): only these get a check, never a step merely before the current one.</summary>
    [Parameter] public IReadOnlyCollection<int> Done { get; set; } = [];

    /// <summary>One line ("1 Jadval") instead of number over label with a check, as on the unit page header.</summary>
    [Parameter] public bool Compact { get; set; }

    [Parameter] public EventCallback<int> OnSelect { get; set; }

    private RenderFragment Body(int step, string state) => Compact
        ? @<text><b>@step</b> @Labels[step - 1]</text>
        : @<text>
            <span class="stepper-no">@step</span>
            <span class="stepper-label">@Labels[step - 1]</span>
            @if (state == "done")
            {
                <Icon Name="check" Size="18" Stroke="2.5" />
            }
        </text>;
}
