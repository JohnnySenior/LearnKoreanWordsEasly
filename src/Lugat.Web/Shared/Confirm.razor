<div class="confirm" role="group" aria-label="@Question">
    <span>@Question</span>
    <button class="button small @(Value == true ? "selected" : "")" aria-pressed="@(Value == true)" @onclick="() => Set(true)">Ha</button>
    <button class="button small @(Value == false ? "selected" : "")" aria-pressed="@(Value == false)" @onclick="() => Set(false)">Yo‘q</button>
</div>

@code {
    [Parameter, EditorRequired] public string Question { get; set; } = "";

    [Parameter] public bool? Value { get; set; }

    [Parameter] public EventCallback<bool?> ValueChanged { get; set; }

    private Task Set(bool value) => ValueChanged.InvokeAsync(value);
}
