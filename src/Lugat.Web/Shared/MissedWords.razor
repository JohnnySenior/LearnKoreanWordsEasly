@using Lugat.Contracts

@* Most-missed words for the teacher (spec §9.2): the word, its meaning, unit and mistake count. *@
<div class="table-wrap">
    <table class="data-table">
        <thead><tr><th>So‘z</th><th>Ma’nosi</th><th>Bo‘lim</th><th class="num">Xato</th>@if (ShowLearners) { <th class="num">O‘quvchi</th> }</tr></thead>
        <tbody>
            @foreach (var w in Words)
            {
                <tr>
                    <td lang="ko"><strong>@w.Korean</strong></td>
                    <td class="wrap">@w.Uzbek</td>
                    <td>@(w.Unit ?? "—")</td>
                    <td class="num">@w.Mistakes</td>
                    @if (ShowLearners)
                    {
                        <td class="num">@w.Learners</td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<MissedWordDto> Words { get; set; } = [];

    [Parameter] public bool ShowLearners { get; set; }
}
