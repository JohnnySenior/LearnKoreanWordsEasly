@using Lugat.Contracts
@implements IAsyncDisposable
@inject SessionService Api
@inject IJSRuntime JS
@inject BrowserInterop Browser

<div class="intro-player" @ref="_root">
    <div class="intro-top"><span><i></i> Bo‘lim bilan tanishuv</span><span>@Lesson.UnitLabel · @Lesson.TotalWords so‘z</span></div>
    <section class="intro-board" aria-label="Ovozli doska">
        <div class="intro-board-top"><span>@(_started ? $"{_word + 1}-so‘z / {Lesson.Words.Count}" : "Birinchi qadam — tanishish")</span><span>@(CurrentWord?.HasTrap == true ? "TUZOQQA E’TIBOR" : "OVOZLI DOSKA")</span></div>
        @if (!_started)
        {
            <div class="intro-welcome"><span class="intro-hand">Keling, tanishib olamiz.</span><h2>@Lesson.TotalWords ta so‘z.<br /><em>Bittadan</em> tanishamiz.</h2><p>Avval tinglang. Doskani kuzating.<br />Tuzoqlarga kelganda bir oz to‘xtalamiz.</p><button class="intro-primary" disabled="@_loading" @onclick="StartAsync">Tanishuvni boshlash →</button>
                @if (_resume > 0) { <button class="intro-link" @onclick="ResumeSavedAsync">@(_resume + 1)-so‘zdan davom etish →</button> }
            </div>
        }
        else if (_finished)
        {
            <div class="intro-welcome"><span class="intro-hand">Tanishish — birinchi qadam.</span><h2>Endi bu so‘zlar<br />sizga tanish.</h2><p>Hammasini hoziroq yodlash shart emas.<br />Jadvalda o‘z sur’atingizda mustahkamlang.</p><button class="intro-primary" @onclick="FinishAsync">Jadvalga o‘tamiz →</button></div>
        }
        else if (CurrentWord is { } word)
        {
            <div class="intro-word" @key="word.WordId"><div class="intro-word-no">SO‘Z @((_word + 1).ToString("00")) @if(word.HasTrap) { <span>✧ TUZOQ BOR</span> }</div>
                <div class="intro-word-heading"><h2 lang="ko">@word.Word</h2>@if (_beat >= 0) { <div class="intro-meaning"><strong>@word.MeaningUz</strong>@if (Api.State.Me?.ShowRomanization != false && !string.IsNullOrWhiteSpace(word.Romanization)) { <small>@word.Romanization</small> }</div> }</div>
                @if (_beat >= 0)
                {
                    <div class="intro-insight intro-hand">@word.Title</div><div class="intro-fragments">
                    @for (var n = 0; n <= _beat && n < word.Beats.Count; n++)
                    {
                        var beat = word.Beats[n];
                        <div class="intro-fragment @(beat.Kind == "trap" ? "is-trap" : "") @(n == _beat ? "speaking" : "")" @key="n">
                            <span class="intro-fragment-kind">@(beat.Kind == "trap" ? "✧ FARQIGA QARANG" : beat.Kind == "example" ? "BIRGA KO‘RAMIZ" : "MA’NOSI")</span>
                            @if (beat.Korean is not null) { <div lang="ko">@beat.Korean</div> }
                            @if (beat.Uzbek is not null) { <p>@beat.Uzbek</p> }
                            @if (beat.Korean is null && beat.Uzbek is null) { <p>@beat.NarrationUz</p> }
                        </div>
                    }
                    </div>
                }
            </div>
        }
        <div class="intro-bomi @(_playing ? "talking" : "")" aria-hidden="true"><div><i></i><i></i><b>⌣</b></div><small>Bomi</small></div><span class="intro-paper-mark">KOREYSCHA</span>
    </section>
    <div class="intro-narration"><span class="intro-wave @(_playing ? "active" : "")">ııı</span><div><small>BOMI TUSHUNTIRADI</small><p aria-live="polite">@Subtitle</p></div></div>
    @if (_error is not null) { <div class="intro-error" role="alert">@_error <button @onclick="RetryAsync">Qayta eshitish</button></div> }
    <div class="intro-controls"><button aria-label="Oldingi so‘z" disabled="@(!_started || _word == 0 || _loading)" @onclick="PreviousAsync">←</button><button class="intro-play" disabled="@(_loading || _finished)" aria-label="@(_playing ? "Pauza" : "Davom ettirish")" @onclick="ToggleAsync">@if (_loading) { <span>…</span> } else { <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true">@if (_playing) { <path d="M7 5h4v14H7zm7 0h4v14h-4z" /> } else { <path d="m9 5 11 7-11 7z" /> }</svg> }</button><button aria-label="Keyingi so‘z" disabled="@(!_started || _finished || _loading)" @onclick="NextAsync">→</button><span>@(_loading ? "Ovoz yuklanmoqda…" : _playing ? "Tinglang va kuzating" : "O‘z sur’atingizda")</span><button class="intro-speed" aria-label="Ovoz tezligi" @onclick="SpeedAsync">@(_rate.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))×</button><button aria-label="Shu so‘zni qayta eshitish" disabled="@(!_started || _loading || _finished)" @onclick="ReplayAsync">↺</button></div>
    <div class="intro-bottom"><label><input type="checkbox" @bind="_onlyTraps" @bind:after="FilterAsync" /> Faqat tuzoqlar</label><button @onclick="FinishAsync">O‘tkazib yuborish — jadval →</button></div>
    <audio preload="none"></audio>
</div>

@code {
    [Parameter, EditorRequired] public IntroductionDto Lesson { get; set; } = default!;
    [Parameter] public EventCallback OnDone { get; set; }
    [Parameter] public bool Preview { get; set; }
    private ElementReference _root;
    private IJSObjectReference? _module, _player;
    private DotNetObjectReference<IntroductionPlayer>? _reference;
    private readonly HashSet<int> _cached = [];
    private readonly Dictionary<int, Task<bool>> _loads = [];
    private int _word, _beat = -1, _clip, _resume, _epoch;
    private bool _started, _playing, _loading, _finished, _disposed, _onlyTraps;
    private double _rate = 1;
    private string? _error;
    private IntroductionWordDto? CurrentWord => _started && !_finished && _word < Lesson.Words.Count ? Lesson.Words[_word] : null;
    private string StorageKey => $"intro:{Api.State.Me?.Id}:{Lesson.Id}:position";
    private string Subtitle => !_started ? "So‘zlar bittadan ochiladi. Istalgan payt jadvalga o‘tishingiz mumkin." : _finished ? "Tanishuv yakunlandi. Endi jadvalda mustahkamlaymiz." : _beat < 0 ? $"{CurrentWord?.Word} — avval talaffuzini eshiting." : CurrentWord?.Beats.ElementAtOrDefault(_beat)?.NarrationUz ?? "";
    private List<(int Word, int Beat, string? Url)> Clips => Lesson.Words.SelectMany((w, i) => new[] { (Word: i, Beat: -1, Url: w.KoreanAudioUrl) }.Concat(w.Beats.Select((b, n) => (Word: i, Beat: n, Url: b.AudioUrl)))).ToList();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/introduction.js");
        _reference = DotNetObjectReference.Create(this);
        _player = await _module.InvokeAsync<IJSObjectReference>("create", _root, _reference);
        if (!Preview && int.TryParse(await Browser.StorageGetAsync(StorageKey), out var saved) && saved >= 0 && saved < Lesson.Words.Count) _resume = saved;
        StateHasChanged();
    }
    private async Task StartAsync() { if (_player is null) return; await _player.InvokeVoidAsync("prime"); _started = true; await GoAsync(FindWord(-1, 1)); }
    private async Task ResumeSavedAsync() { if (_player is null) return; await _player.InvokeVoidAsync("prime"); _started = true; await GoAsync(_resume); }
    private async Task<bool> LoadAsync(int clip)
    {
        if (_cached.Contains(clip)) return true;
        if (_loads.TryGetValue(clip, out var task)) return await task;
        var loading = FetchAsync(clip); _loads[clip] = loading;
        var ok = await loading;
        _loads.Remove(clip);
        return ok;
    }
    private async Task<bool> FetchAsync(int clip)
    {
        var url = Clips.ElementAtOrDefault(clip).Url;
        if (url is null) return false;
        var result = await Api.GetBytesAsync(url);
        if (_disposed || _player is null) return false;
        if (result.Value is not { Length: > 0 } bytes) return false;
        await _player.InvokeVoidAsync("put", clip, bytes); _cached.Add(clip); return true;
    }
    private async Task PlayAsync()
    {
        if (_player is null || _finished || _disposed) return;
        var epoch = ++_epoch; var clip = _clip; _loading = true; _error = null; StateHasChanged();
        var loaded = await LoadAsync(clip);
        if (_disposed || epoch != _epoch) return;
        _loading = false;
        if (!loaded) { _playing = false; _error = "Ovoz yuklanmadi. Dars shu joyda to‘xtadi; internetni tekshirib qayta eshiting."; StateHasChanged(); return; }
        var position = Clips[clip]; _word = position.Word; _beat = position.Beat;
        _playing = await _player.InvokeAsync<bool>("play", clip, _rate);
        if (!_playing) _error = "Ovozni boshlash uchun yana bir marta bosing. Keyingi qadamga o‘tilmadi.";
        StateHasChanged();
        if (_playing && clip + 1 < Clips.Count) _ = PreloadAsync(clip + 1);
    }
    private async Task PreloadAsync(int clip) { try { await LoadAsync(clip); } catch (JSDisconnectedException) { } catch (ObjectDisposedException) { } }
    [JSInvokable] public async Task OnIntroductionEnded(int clip)
    {
        if (_disposed || !_playing || clip != _clip) return;
        _playing = false;
        var clips = Clips;
        if (_clip + 1 < clips.Count && clips[_clip + 1].Word == _word) { _clip++; await PlayAsync(); }
        else await GoAsync(FindWord(_word, 1));
    }
    [JSInvokable] public void OnIntroductionError(int clip)
    {
        if (_disposed || clip != _clip) return;
        _playing = false; _error = "Ovoz ijro etilmadi. Dars shu joyda to‘xtadi. Qayta eshitishni bosing."; StateHasChanged();
    }
    private int FindWord(int from, int direction)
    {
        for (var n = from + direction; n >= 0 && n < Lesson.Words.Count; n += direction)
            if (!_onlyTraps || Lesson.Words[n].HasTrap) return n;
        return direction > 0 ? Lesson.Words.Count : 0;
    }
    private async Task GoAsync(int word)
    {
        _epoch++; if (_player is not null) await _player.InvokeVoidAsync("stop"); _playing = false; _error = null; _loading = false;
        if (word >= Lesson.Words.Count) { _finished = true; StateHasChanged(); return; }
        _finished = false; _word = word; _beat = -1; _clip = Clips.FindIndex(c => c.Word == word);
        if (!Preview) await Browser.StorageSetAsync(StorageKey, word.ToString());
        await PlayAsync();
    }
    private async Task ToggleAsync()
    {
        if (!_started) { await StartAsync(); return; }
        if (_player is null) return;
        if (_playing) { await _player.InvokeVoidAsync("pause"); _playing = false; }
        else await PlayAsync();
    }
    private Task PreviousAsync() => GoAsync(FindWord(_word, -1));
    private Task NextAsync() => GoAsync(FindWord(_word, 1));
    private Task ReplayAsync() => GoAsync(_word);
    private Task FilterAsync() => _started && _onlyTraps && CurrentWord?.HasTrap != true ? GoAsync(FindWord(_word, 1)) : Task.CompletedTask;
    private async Task RetryAsync() { if (_player is not null) await _player.InvokeVoidAsync("rewind"); await PlayAsync(); }
    private async Task SpeedAsync() { _rate = _rate == 1 ? 1.25 : _rate == 1.25 ? 1.5 : _rate == 1.5 ? .75 : 1; if (_player is not null) await _player.InvokeVoidAsync("rate", _rate); }
    private async Task FinishAsync()
    {
        _epoch++; _playing = false; if (_player is not null) await _player.InvokeVoidAsync("stop");
        if (!Preview) await Browser.StorageSetAsync($"intro:{Api.State.Me?.Id}:{Lesson.Id}:seen", "yes");
        await OnDone.InvokeAsync();
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _epoch++;
        try { if (_player is not null) { await _player.InvokeVoidAsync("dispose"); await _player.DisposeAsync(); } if (_module is not null) await _module.DisposeAsync(); }
        catch (JSDisconnectedException) { }
        _reference?.Dispose();
    }
}
