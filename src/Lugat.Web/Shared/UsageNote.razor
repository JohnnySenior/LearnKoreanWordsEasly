@using Lugat.Contracts
@* How a word is used (D-46): common phrases, the trap for an Uzbek speaker, one example. *@
<div class="usage-note">
    @if (Usage.TrapUz is not null)
    {
        <p class="usage-trap"><strong>O‘zbekcha tuzoq.</strong> @Usage.TrapUz</p>
    }
    @if (Usage.Phrases.Count > 0)
    {
        <ul class="usage-phrases">
            @foreach (var p in Usage.Phrases)
            {
                <li><span lang="ko">@p.Korean</span> — @p.Uzbek</li>
            }
        </ul>
    }
    @if (Usage.Example is { } e)
    {
        <p class="usage-example"><span lang="ko">@e.Korean</span><br /><span class="muted">@e.Uzbek</span></p>
    }
    @if (Usage.Warning is not null)
    {
        <p class="muted small-text">@Usage.Warning</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public WordUsageDto Usage { get; set; } = default!;
}
