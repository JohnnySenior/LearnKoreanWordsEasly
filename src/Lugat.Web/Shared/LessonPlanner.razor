@using Lugat.Contracts
@using Lugat.Domain.Lessons
@inject SessionService Api

@* Lessons (PLAN01, PLAN02, D-42): planned lessons and the app's suggestion for the next one. Moved here from Today so
   Today only shows what to do now. Nothing is created until "Shu darsga belgilash" is pressed. *@
<section class="card" id="darslar">
    <h2>Darslar</h2>
    @if (_planned is { Count: > 0 })
    {
        <ul class="plain-list lesson-list">
            @foreach (var lesson in _planned)
            {
                var l = lesson;
                <li>
                    <div class="row-between">
                        <strong>@l.Title</strong>
                        <span class="muted small-text">@Format.LessonDate(l.DueAt)</span>
                    </div>
                    <span class="muted small-text">@l.WordCount ta so‘z · @l.ApprovedWords tasdiqlangan</span>
                    <button class="button small" disabled="@_busy" @onclick="() => MarkDoneAsync(l)">Dars topshirildi</button>
                </li>
            }
        </ul>
    }
    else if (_planned is not null)
    {
        <p class="muted small-text">Rejada dars yo‘q.</p>
    }

    @if (_suggestion is { } s)
    {
        <span class="kicker" style="margin-top:12px">@(_planned is { Count: > 0 } ? "Keyingi darsni oldindan belgilash" : "Keyingi darsni belgilash")</span>
        <p style="margin:4px 0"><strong>@TablesText(s.Tables)</strong> <span class="muted">· @s.WordCount ta so‘z</span></p>
        <label class="field">
            Topshirish vaqti (Koreya vaqti)
            <input class="input" type="datetime-local" @bind="_dueLocal" />
        </label>
        @if (s.ApprovedWords < s.WordCount)
        {
            <p class="muted small-text">@(s.WordCount - s.ApprovedWords) ta so‘z hali tasdiqlanmagan; ular tasdiqlangach mashqqa qo‘shiladi.</p>
        }
        <button class="button" disabled="@_busy" @onclick="() => AssignAsync(s)">Shu darsga belgilash</button>
        <p class="muted small-text"><a href="sozlamalar#lugat-rejasi">Darsdagi jadval soni va dars kunlari →</a></p>
    }
    @if (_error is not null)
    {
        <div class="notice" role="alert" style="margin-top:8px">@_error</div>
    }
</section>

@code {
    private List<AssignmentDto>? _planned;
    private AssignmentSuggestionDto? _suggestion;
    private DateTime _dueLocal;
    private bool _busy;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var assignments = await Api.GetAsync<List<AssignmentDto>>("api/assignments");
        _planned = assignments.Value?.Where(a => a.Status == AssignmentStatus.Planned).OrderBy(a => a.DueAt).ToList() ?? [];
        _suggestion = (await Api.GetAsync<AssignmentSuggestionDto>("api/assignments/suggestion")).Value;
        if (_suggestion is not null)
        {
            _dueLocal = Format.ToKorea(_suggestion.DueAt).DateTime;
        }
    }

    private async Task AssignAsync(AssignmentSuggestionDto s)
    {
        _busy = true;
        var dueAt = new DateTimeOffset(DateTime.SpecifyKind(_dueLocal, DateTimeKind.Unspecified), Format.KoreaOffset);
        var result = await Api.SendJsonAsync<AssignmentDto>(HttpMethod.Post, "api/assignments", new CreateAssignmentRequest(s.SourceDocumentId, s.Tables, dueAt, null));
        _error = result.Ok ? null : result.Error;
        await LoadAsync();
        _busy = false;
    }

    private async Task MarkDoneAsync(AssignmentDto lesson)
    {
        _busy = true;
        var result = await Api.SendJsonAsync<AssignmentDto>(HttpMethod.Patch, $"api/assignments/{lesson.Id}", new UpdateAssignmentRequest(null, null, AssignmentStatus.Done, null));
        _error = result.Ok ? null : result.Error;
        await LoadAsync();
        _busy = false;
    }

    private static string TablesText(int[] tables) =>
        tables.Length == 1 ? $"{tables[0]}-jadval" : $"{string.Join(", ", tables)}-jadvallar";
}
