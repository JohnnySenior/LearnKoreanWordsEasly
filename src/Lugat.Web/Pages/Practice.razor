@page "/mashq/kartochka"
@page "/takrorlash"
@page "/sessiya"
@using System.Text.Json
@using Lugat.Contracts
@using Lugat.Domain.Learning
@using Lugat.Domain.Study
@implements IDisposable
@inject SessionService Api
@inject BrowserInterop Browser

<PageTitle>Mashq — Koreyscha</PageTitle>

@if (_loading)
{
    <a class="back" href="mashq">← Mashqlar</a>
    <h1>Kartochka</h1>
    <p class="muted">Yuklanmoqda…</p>
}
else if (_session is null)
{
    <a class="back" href="mashq">← Mashqlar</a>
    <h1>Kartochka</h1>
    @if (_error is not null)
    {
        <div class="notice" role="alert">@_error</div>
    }
    <p class="muted">Hozir faol mashg‘ulot yo‘q. Takrorlash barcha ochilgan bo‘limlarning vaqti kelgan kartalarini oladi, yangi so‘zlar esa joriy bo‘limdan.</p>
    <button class="button primary block" disabled="@_busy" @onclick="StartReviewAsync">Takrorlashni boshlash</button>
    @if (_startMessage is not null)
    {
        <p role="status" style="margin-top:8px">@_startMessage</p>
    }
}
else if (_session.Current is not { } card)
{
    <div class="session-bar">
        <a class="close" href="" aria-label="Bugunga qaytish"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="M18 6 6 18" /><path d="m6 6 12 12" /></svg></a>
        <div class="progress"><div style="width:100%"></div></div>
        <span class="count">@_session.Total / @_session.Total</span>
    </div>
    <section class="card" style="border-top:0">
        <span class="kicker accent">Mashg‘ulot tugadi</span>
        <h1>@_session.Summary.Answered ta karta ko‘rildi</h1>
        <dl class="facts stats">
            <dt>@Format.Rating(ReviewAnswer.Easy)</dt><dd>@_session.Summary.Easy</dd>
            <dt>@Format.Rating(ReviewAnswer.Hard)</dt><dd>@_session.Summary.Hard</dd>
            <dt>@Format.Rating(ReviewAnswer.Forgot) — qisqa vaqtdan keyin qaytadi</dt><dd>@_session.Summary.Forgot</dd>
            <dt>Yangi so‘zlar</dt><dd>@_session.Summary.NewSeen</dd>
        </dl>
        <p class="muted" style="margin-top:12px">Ikki yo‘nalish alohida hisoblanadi. Keyingi takrorlash vaqtini dastur o‘zi belgilaydi.</p>
    </section>
    <div class="actions">
        <a class="button primary big" href="">Bugunga qaytish</a>
        @if (_session.UndoableEventId is { } lastEvent)
        {
            <button class="button big" disabled="@_busy" @onclick="() => UndoAsync(lastEvent)">Oxirgi javobni bekor qilish</button>
        }
    </div>
}
else
{
    @* UI handoff 1e: close, a 4px ink progress and "7 / 25"; the card; the answer behind one button; three ratings. *@
    <div class="session-bar">
        <a class="close" href="" aria-label="Mashqdan chiqish (joyi saqlanadi)"><Icon Name="x" Size="22" /></a>
        <div class="progress ink" role="progressbar" aria-valuemin="0" aria-valuemax="@_session.Total" aria-valuenow="@_session.Position">
            <span style="width:@(Percent(_session.Position, _session.Total))%"></span>
        </div>
        <span class="count">@(_session.Position + 1) / @_session.Total</span>
    </div>

    <section class="flashcard" aria-live="polite">
        <div class="flashcard-meta">
            <Tag Kind="outline">@(card.Direction == ReviewDirection.KoreanToUzbek ? "KO → UZ" : "UZ → KO")</Tag>
            <span class="muted small-text">@Format.Kind(card.Kind)@(card.Unit is null ? "" : $" · {card.Unit}-bo‘lim")</span>
        </div>
        <div class="flashcard-word">
            <div>
                @if (card.Direction == ReviewDirection.KoreanToUzbek)
                {
                    <p class="prompt ko" lang="ko">@card.Prompt</p>
                    @if (card.PromptNote is not null)
                    {
                        <p class="muted flashcard-note" lang="ko">@card.PromptNote</p>
                    }
                }
                else
                {
                    <p class="prompt">@card.Prompt</p>
                }
            </div>
            @if (card.Direction == ReviewDirection.KoreanToUzbek)
            {
                <Speak Text="@card.Prompt" />
            }
        </div>
        @if (card.Direction == ReviewDirection.KoreanToUzbek)
        {
            <SayIt Reference="@card.Prompt" />
        }
    </section>

    @if (!_revealed)
    {
        <section class="flashcard-hidden">
            <p class="muted">@(card.Direction == ReviewDirection.KoreanToUzbek ? "Ma’nosini eslang, keyin tekshiring." : "Koreyschasini eslang, keyin tekshiring.")</p>
            <button class="btn btn-primary block reveal-btn" @onclick="Reveal"><span>Javobni ko‘rsatish</span><Icon Name="eye" /></button>
        </section>
    }
    else
    {
        <section class="reveal">
            @if (card.Direction == ReviewDirection.UzbekToKorean)
            {
                <div class="flashcard-word">
                    <div>
                        <p class="answer ko" lang="ko">@card.Answer</p>
                        @if (card.AnswerNote is not null)
                        {
                            <p class="muted flashcard-note" lang="ko">@card.AnswerNote</p>
                        }
                    </div>
                    <Speak Text="@card.Answer" />
                </div>
                <SayIt Reference="@card.Answer" />
            }
            else
            {
                <p class="answer">@card.Answer</p>
            }
            @if (card.UsageTrap is not null)
            {
                <div class="trap"><span class="trap-title"><Icon Name="triangle-alert" Size="14" Stroke="2.2" /> O‘zbekcha tuzoq</span><p>@card.UsageTrap</p></div>
            }
        </section>
    }

    @if (!card.IsDue && card.Kind != SessionItemKind.New)
    {
        <p class="muted small-text">Bu so‘zning takrorlash vaqti hali kelmagan: baho keyingi muddatni uzaytirmaydi.</p>
    }

    @if (_pending is not null)
    {
        <div class="notice" role="alert">@_error</div>
        <button class="btn btn-secondary block" disabled="@_busy" @onclick="RetryAsync"><span>Qayta yuborish</span></button>
    }
    else if (_error is not null)
    {
        <div class="notice" role="alert">@_error</div>
    }

    @if (_revealed)
    {
        @* Spec's three answers (SRS); the middle one is set in ink as in the design. Times come from the server. *@
        <div class="rate-grid">
            @foreach (var preview in card.Previews)
            {
                <button class="rate-cell @(preview.Answer == ReviewAnswer.Hard ? "middle" : "")" disabled="@(_busy || _pending is not null)" @onclick="() => AnswerAsync(card, preview.Answer)">
                    <b>@Format.Rating(preview.Answer)</b>
                    <span>@(preview.ChangesSchedule ? Format.Interval(preview.IntervalSeconds) : "muddat o‘zgarmaydi")</span>
                </button>
            }
        </div>
    }

    @if (_session.UndoableEventId is { } undoable && _showUndo)
    {
        <div class="toast" role="status">
            Javob saqlandi.
            <button class="btn btn-ghost small" disabled="@_busy" @onclick="() => UndoAsync(undoable)">Bekor qilish</button>
        </div>
    }
}

@code {
    private SessionDto? _session;
    private bool _loading = true;
    private bool _revealed;
    private bool _busy;
    private bool _showUndo;
    private string? _error;
    private DateTime _shownAt;
    private int? _responseMs;
    private AnswerRequest? _pending;
    private Timer? _undoTimer;

    /// <summary>An answer that was not confirmed by the server survives closing the app (spec REL03).</summary>
    private const string PendingKey = "lugat.pending-answer";

    private sealed record StoredAnswer(Guid SessionId, AnswerRequest Request);

    private Guid? _pendingSessionId;

    private string? _startMessage;

    /// <summary>"Takrorlash" (spec §4.6): plans a 20-minute review, or says there is nothing due yet.</summary>
    private async Task StartReviewAsync()
    {
        _busy = true;
        var result = await Api.SendJsonAsync<StartSessionResponse>(HttpMethod.Post, "api/sessions", new StartSessionRequest(20, false));
        _busy = false;
        _startMessage = result.Value?.Session is null ? result.Value?.Message ?? result.Error : null;
        if (result.Value?.Session is { } session)
        {
            _session = session;
            ShowCard();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<SessionDto>("api/sessions/current");
        _error = result.Ok ? null : result.Error;
        _session = result.Value;
        _loading = false;
        ShowCard();

        // Resend an answer left over from last time. The server knows its event id, so it never counts twice.
        if (await LoadStoredAnswerAsync() is { } stored)
        {
            _pending = stored.Request;
            _pendingSessionId = stored.SessionId;
            await SendPendingAsync();
        }
    }

    private async Task<StoredAnswer?> LoadStoredAnswerAsync()
    {
        try
        {
            return await Browser.StorageGetAsync(PendingKey) is { Length: > 0 } json
                ? JsonSerializer.Deserialize<StoredAnswer>(json, SessionService.Json)
                : null;
        }
        catch (JsonException)
        {
            await Browser.StorageRemoveAsync(PendingKey);
            return null;
        }
    }

    private void ShowCard()
    {
        _revealed = false;
        _responseMs = null;
        _shownAt = DateTime.UtcNow;
    }

    private void Reveal()
    {
        _revealed = true;
        _responseMs = (int)(DateTime.UtcNow - _shownAt).TotalMilliseconds;
    }

    private async Task AnswerAsync(CardPromptDto card, ReviewAnswer answer)
    {
        if (_session is null || _pending is not null)
        {
            return;
        }

        // The event id is fixed here, so a retry after a network error cannot count twice (spec REL03).
        _pending = new AnswerRequest(Guid.NewGuid(), card.Position, answer, false, _responseMs);
        _pendingSessionId = _session.Id;
        await Browser.StorageSetAsync(PendingKey, JsonSerializer.Serialize(new StoredAnswer(_session.Id, _pending), SessionService.Json));
        await SendPendingAsync();
    }

    private Task RetryAsync() => SendPendingAsync();

    private async Task SendPendingAsync()
    {
        if (_pending is null || _pendingSessionId is not { } sessionId)
        {
            return;
        }

        ApiResult<AnswerResultDto> result;
        _busy = true;
        try
        {
            result = await Api.SendJsonAsync<AnswerResultDto>(HttpMethod.Post, $"api/sessions/{sessionId}/answers", _pending);
        }
        finally
        {
            _busy = false;
        }

        if (result.Ok)
        {
            await ForgetPendingAsync();
            _error = null;
            _session = result.Value!.Session;
            await Browser.VibrateAsync();
            ShowCard();
            FlashUndo();
            return;
        }

        if (result.Status is 409 or 404)
        {
            // Answered elsewhere, the word was removed or the session moved on: take the server's state.
            await ForgetPendingAsync();
            _error = result.Error;
            await ReloadAsync();
            return;
        }

        // Network or server trouble: keep the answer (also on the device) and offer a retry with the same id.
        _error = result.Error;
    }

    private async Task ForgetPendingAsync()
    {
        _pending = null;
        _pendingSessionId = null;
        await Browser.StorageRemoveAsync(PendingKey);
    }

    private async Task UndoAsync(Guid eventId)
    {
        _busy = true;
        var result = await Api.SendJsonAsync<SessionDto>(HttpMethod.Post, $"api/reviews/{eventId}/undo");
        _busy = false;
        _showUndo = false;
        if (result.Ok)
        {
            _session = result.Value;
            _error = null;
            ShowCard();
        }
        else
        {
            _error = result.Error;
        }
    }

    private async Task ReloadAsync()
    {
        var result = await Api.GetAsync<SessionDto>($"api/sessions/{_session!.Id}");
        _session = result.Value ?? _session;
        ShowCard();
    }

    private void FlashUndo()
    {
        _showUndo = true;
        _undoTimer?.Dispose();
        _undoTimer = new Timer(_ => InvokeAsync(() => { _showUndo = false; StateHasChanged(); }), null, 6000, Timeout.Infinite);
    }

    private static int Percent(int value, int total) => total == 0 ? 0 : value * 100 / total;

    public void Dispose() => _undoTimer?.Dispose();
}
