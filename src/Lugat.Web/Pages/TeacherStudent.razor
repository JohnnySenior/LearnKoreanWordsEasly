@page "/oqituvchi/oquvchi/{Id:guid}"
@using Lugat.Contracts
@using Lugat.Domain.Catalog
@inject SessionService Api

<PageTitle>O‘quvchi — Koreyscha</PageTitle>

@* One learner of the teacher's group (spec §9.2): scores by unit and the most-missed words. Nothing else. *@
<a class="back" href="oqituvchi">← O‘qituvchi paneli</a>

@if (_student is null)
{
    <p class="muted">@(_error ?? "Yuklanmoqda…")</p>
    return;
}

<h1>@(_student.Name ?? "O‘quvchi")</h1>
<p class="muted">Joriy bo‘lim: @(_student.CurrentUnit ?? "—")</p>

@if (_student.Week is { } week)
{
    <section class="card">
        <h2>Oxirgi 7 kun</h2>
        <div class="figures">
            <div><strong>@week.Reviewed</strong><span>kartochka takrorladi</span></div>
            <div><strong>@week.DueNow</strong><span>takror kutyapti</span></div>
        </div>
        @if (week.Practice.Count == 0)
        {
            <p class="muted">Mashq qilinmagan.</p>
        }
        else
        {
            <ul class="teacher-practice">
                @foreach (var p in week.Practice)
                {
                    <li><span>@p.Name</span><b>@p.Count @(p.Words ? "ta so‘z" : "marta")</b></li>
                }
            </ul>
        }
    </section>
}

@if (_student.Decks is { Count: > 0 } decks)
{
    @* L-68: the teacher's own decks for this learner. *@
    <section class="card">
        <h2>Sizning lug‘atlaringiz</h2>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Lug‘at</th><th class="num">O‘rgandi</th><th class="num">Oxirgi sinov</th><th>Vazifa</th></tr></thead>
                <tbody>
                    @foreach (var d in decks)
                    {
                        <tr>
                            <td class="wrap"><a href="@($"oqituvchi/lugat/{d.DeckId}")">@d.Name</a></td>
                            <td class="num">@d.Learned / @d.Words</td>
                            <td class="num">@(d.LastTestPercent is { } p ? $"{p}% · {Format.DayMonth(d.LastTestAt!.Value)}" : "—")</td>
                            <td class="wrap">@(d.Done is not { } h ? "—" : h.Done ? $"✓ Bajardi · {Format.DayMonth(h.DoneAt!.Value)}" : $"{h.Seen}/{h.Words} so‘z · {(h.TestTaken ? "sinov bor" : "sinov yo‘q")}")@(d.DueOn is { } due ? $" (muddat {Format.Day(due)})" : "")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

<section class="card">
    <h2>Bo‘limlar</h2>
    @if (_student.Units.Count == 0)
    {
        <p class="muted">Hali bo‘lim boshlanmagan.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Bo‘lim</th><th>Holat</th><th class="num">Eng yaxshi</th><th class="num">Urinish</th></tr></thead>
                <tbody>
                    @foreach (var u in _student.Units)
                    {
                        <tr>
                            <td>@u.Unit</td>
                            <td>@Status(u)</td>
                            <td class="num">@(u.BestScorePercent is { } p ? $"{p}%" : "—")</td>
                            <td class="num">@u.Attempts</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card">
    <h2>Eng ko‘p xato qilgan so‘zlar</h2>
    @if (_student.TopMistakes.Count == 0)
    {
        <p class="muted">Hali xato yo‘q.</p>
    }
    else
    {
        <MissedWords Words="_student.TopMistakes" />
    }
</section>

@code {
    [Parameter] public Guid Id { get; set; }

    private StudentDetailDto? _student;
    private string? _error;

    protected override async Task OnParametersSetAsync()
    {
        var result = await Api.GetAsync<StudentDetailDto>($"api/teacher/students/{Id}");
        (_student, _error) = (result.Value, result.Error);
    }

    private static string Status(StudentUnitDto u) => u.Status switch
    {
        UnitProgressStatus.Passed when u.PassedBy == UnitPassedBy.SkipTest => "O‘tdi («Bilaman»)",
        UnitProgressStatus.Passed => "O‘tdi",
        _ => "Ochiq",
    };
}
