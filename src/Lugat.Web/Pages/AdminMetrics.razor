@page "/admin/korsatkichlar"
@using Lugat.Domain.Premium
@using Lugat.Contracts
@using Lugat.Domain.Users
@inject SessionService Api

<PageTitle>Ko‘rsatkichlar — Koreyscha</PageTitle>

@* Key figures (spec §10): plain tables. "Faol" = opened the app that day (Korea time). *@
<a class="back" href="admin">← Admin panel</a>
<h1>Ko‘rsatkichlar</h1>

@if (!IsAdmin)
{
    <p class="muted">Bu sahifa admin uchun.</p>
    return;
}

@if (_m is null)
{
    <p class="muted">@(_error ?? "Yuklanmoqda…")</p>
    return;
}

<section class="card">
    <div class="figures">
        <div><strong>@_m.Users</strong><span>foydalanuvchi</span></div>
        <div><strong>@_m.NewLast7Days</strong><span>yangi, 7 kunda</span></div>
        <div><strong>@_m.NewLast30Days</strong><span>yangi, 30 kunda</span></div>
        <div><strong>@(_m.DailyActive.FirstOrDefault()?.Users ?? 0)</strong><span>bugun faol</span></div>
        <div><strong>@Percent(_m.D1)</strong><span>D1 retention (@_m.D1.Returned/@_m.D1.Cohort)</span></div>
        <div><strong>@Percent(_m.D7)</strong><span>D7 retention (@_m.D7.Returned/@_m.D7.Cohort)</span></div>
        <div><strong>@_m.PremiumNow</strong><span>Premium hozir</span></div>
    </div>
    <p class="muted small-text">D1/D7: oxirgi 30 kunda ro‘yxatdan o‘tganlardan ro‘yxatdan o‘tgan kunidan 1 (7) kun keyin ilovani ochganlar ulushi.</p>
</section>

<section class="card">
    @* L-40: every ad channel gets its own link; which one brings learners who stay. *@
    <h2>Reklama kanallari (30 kun)</h2>
    @if (_sources is not { Count: > 0 })
    {
        <p class="muted">Hali kanal havolasi bilan kelgan yo‘q.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Kanal</th><th class="num">Tashrif</th><th class="num">Ro‘yxatdan o‘tdi</th><th class="num">D7</th><th class="num">To‘ladi</th></tr></thead>
                <tbody>
                    @foreach (var r in _sources)
                    {
                        <tr><td>@r.Source</td><td class="num">@r.Visits</td><td class="num">@r.SignUps</td><td class="num">@Percent(r.D7) <span class="muted">(@r.D7.Returned/@r.D7.Cohort)</span></td><td class="num">@r.Paying</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <p class="muted small-text">Har kanalga o‘z havolasi: <b>koreyscha.com/?src=tg</b>, <b>?src=ig</b>, <b>?src=fb</b>, <b>?src=yt</b>, <b>?src=tiktok</b> yoki kanal nomi (lotin harflari, raqam, «-», «_»). Tashrif — havolani ochgan qurilmalar; ro‘yxatdan o‘tgan — shu havola bilan kelib 2 kun ichida hisob ochganlar.</p>
</section>

<section class="card">
    <h2>Kunlik faol</h2>
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr>@foreach (var d in _m.DailyActive) { <th class="num">@Format.Day(d.Day)</th> }</tr></thead>
            <tbody><tr>@foreach (var d in _m.DailyActive) { <td class="num">@d.Users</td> }</tr></tbody>
        </table>
    </div>
</section>

<section class="card">
    <h2>Tushum</h2>
    @if (_m.Revenue.Count == 0)
    {
        <p class="muted">Oxirgi 6 oyda to‘lov yo‘q.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Oy</th><th class="num">To‘lov</th><th class="num">Summa</th><th class="num">Komissiya</th></tr></thead>
                <tbody>
                    @foreach (var r in _m.Revenue)
                    {
                        <tr><td>@Format.Month(r.Month)</td><td class="num">@r.Payments</td><td class="num">@Format.Money(r.Amount, r.Currency)</td><td class="num">@Format.Money(r.Commission, r.Currency)</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="card">
    <h2>Bo‘lim testidan o‘tish</h2>
    @if (_m.Units.Count == 0)
    {
        <p class="muted">Hali bo‘lim testi topshirilmagan.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Bo‘lim</th><th class="num">Urinish</th><th class="num">O‘tdi</th><th class="num">%</th></tr></thead>
                <tbody>
                    @foreach (var u in _m.Units)
                    {
                        <tr><td>@u.Unit</td><td class="num">@u.Attempts</td><td class="num">@u.Passed</td><td class="num">@(u.Percent is { } p ? $"{p}%" : "—")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (_m.Channels is { } ch)
{
    @* L-63: can a reminder reach the learners who use the app, and does push bring them back after the first unit. *@
    <section class="card">
        <h2>Eslatma kanali (30 kunda faollar)</h2>
        <div class="figures">
            <div><strong>@Share(ch.Push, ch.Active)</strong><span>push (@ch.Push)</span></div>
            <div><strong>@Share(ch.Telegram, ch.Active)</strong><span>faqat Telegram (@ch.Telegram)</span></div>
            <div><strong>@Share(ch.None, ch.Active)</strong><span>kanal yo‘q (@ch.None)</span></div>
        </div>
        <p class="muted small-text">@ch.Active ta faol o‘quvchi. Push va Telegram ikkalasi bor bo‘lsa — push (eslatma o‘sha yerga ketadi). Eslatmani o‘chirganlar «kanal yo‘q».</p>
    </section>
}

@if (_m.FirstUnitReturn is { Count: > 0 } back)
{
    <section class="card">
        <h2>Birinchi bo‘limdan keyin takrorlashga qaytish</h2>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>O‘quvchilar</th><th class="num">1-kun</th><th class="num">7-kun</th></tr></thead>
                <tbody>
                    @foreach (var r in back)
                    {
                        <tr>
                            <td>@(r.WithPush ? "Push obunasi bor" : "Push obunasi yo‘q")</td>
                            <td class="num">@Percent(r.Day1) <span class="muted small-text">(@r.Day1.Returned/@r.Day1.Cohort)</span></td>
                            <td class="num">@Percent(r.Day7) <span class="muted small-text">(@r.Day7.Returned/@r.Day7.Cohort)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted small-text">Oxirgi 60 kunda birinchi bo‘limni tugatganlar: shundan 1 (7) kun keyin kartochka takrorlaganlar ulushi. Obuna — hozirgi holat.</p>
    </section>
}

<section class="card">
    <h2>Guruhlar: 2-haftada faol</h2>
    @if (_m.Groups.Count == 0)
    {
        <p class="muted">Hali guruh yo‘q.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Guruh</th><th>O‘qituvchi</th><th class="num">A’zo</th><th class="num">14+ kun</th><th class="num">Faol</th><th class="num">%</th></tr></thead>
                <tbody>
                    @foreach (var g in _m.Groups)
                    {
                        <tr><td class="wrap">@g.Group</td><td>@(g.Teacher ?? "—")</td><td class="num">@g.Members</td><td class="num">@g.Eligible</td><td class="num">@g.ActiveSecondWeek</td><td class="num">@(g.Percent is { } p ? $"{p}%" : "—")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
    <p class="muted small-text">Pilot ko‘rsatkichi: kamida 14 kun oldin qo‘shilganlardan qo‘shilganining 8–14-kunlarida ilovani ochganlar.</p>
</section>

@code {
    private MetricsDto? _m;
    private List<SourceRowDto>? _sources;
    private string? _error;

    private bool IsAdmin => Api.State.Me?.Roles.Contains(nameof(UserRoles.Admin)) == true;

    protected override async Task OnInitializedAsync()
    {
        if (IsAdmin)
        {
            var result = await Api.GetAsync<MetricsDto>("api/admin/metrics");
            (_m, _error) = (result.Value, result.Error);
            _sources = (await Api.GetAsync<List<SourceRowDto>>("api/admin/sources?days=30")).Value;
        }
    }

    private static string Percent(RetentionDto r) => r.Percent is { } p ? $"{p}%" : "—";

    private static string Share(int part, int all) => all == 0 ? "—" : $"{(int)Math.Round(part * 100.0 / all)}%";
}
