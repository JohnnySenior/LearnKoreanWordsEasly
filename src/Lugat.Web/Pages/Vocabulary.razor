@page "/lugatlar"
@using Lugat.Contracts
@inject SessionService Api

<PageTitle>Lug‘atlar — Lug‘at</PageTitle>

<h1>Lug‘atlar</h1>

@if (_error is not null)
{
    <div class="notice" role="alert">@_error <button class="button small" @onclick="LoadAsync">Qayta urinish</button></div>
}
else if (_tables is null)
{
    <p class="muted">Yuklanmoqda…</p>
}
else if (_tables.Count == 0)
{
    @* Words come from the shared catalog in stages 2–3 (spec §2, §5); until then there is nothing to list here. *@
    <p class="muted">Hali so‘z yo‘q. So‘zlar bo‘limlar bilan birga qo‘shiladi.</p>
}
else
{
    <section class="card" id="jadvallar">
        <h2>Jadvalni yodlash</h2>
        <p class="muted small-text">Jadvalni ko‘ring va 10 daqiqa yodlang, keyin kartochkada eslab ko‘ring. Yangi so‘zni birdan kartochkada uchratishdan ko‘ra osonroq.</p>
        <nav class="menu compact table-list">
            @foreach (var t in _tables)
            {
                <a href="@($"lugatlar/jadval/{t.TableNumber}")">
                    <span>
                        <span class="t">@t.TableNumber-jadval</span>
                        <span class="s">@t.Words ta so‘z · @(t.Started == 0 ? "hali boshlanmagan" : $"{t.Started} tasi boshlangan")</span>
                    </span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                </a>
            }
        </nav>
    </section>
}

@code {
    private List<VocabTableDto>? _tables;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var result = await Api.GetAsync<List<VocabTableDto>>("api/vocabulary/tables");
        _error = result.Ok ? null : result.Error;
        _tables = result.Value ?? _tables;
    }
}
