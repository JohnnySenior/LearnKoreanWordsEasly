@page "/bolimlar"
@using Lugat.Contracts
@using Lugat.Domain.Catalog
@inject SessionService Api
@inject NavigationManager Nav

<PageTitle>Bo‘limlar — Koreyscha</PageTitle>

@* The units of a level (spec §4.2, UI handoff 1c): passed with the best score, open with progress, the next locked
   one with "Bilaman", the rest locked. What is open is decided by the server only. *@
<h1 class="units-title">Bo‘limlar</h1>

@if (_levels is not null)
{
    <div class="level-pick" role="tablist" aria-label="Daraja">
        @foreach (var l in _levels)
        {
            var level = l.Level;
            <button class="@(_level == level ? "selected" : "")" role="tab" aria-selected="@(_level == level)" @onclick="() => SelectAsync(level)">
                <b>@level</b>
                <span>@(l.PublishedUnits == 0 ? "Tez orada" : $"{l.PublishedUnits} bo‘lim")</span>
            </button>
        }
    </div>
}

@if (_error is not null)
{
    <div class="notice" role="alert">@_error</div>
    <button class="btn btn-secondary block" @onclick="LoadAsync"><span>Qayta urinish</span></button>
}
else if (_units is null)
{
    <div class="unit-rows" aria-busy="true">
        @for (var i = 0; i < 4; i++)
        {
            <div class="unit-item"><span class="skeleton" style="width:40px;height:28px"></span><span class="skeleton" style="width:60%"></span><span></span></div>
        }
    </div>
}
else if (_units.Units.Count == 0)
{
    <p class="muted" style="margin-top:16px">Bu darajaning bo‘limlari tez orada chiqadi.</p>
}
else
{
    <div class="unit-rows">
        @foreach (var u in _units.Units)
        {
            var unit = u;
            var no = u.Number.ToString("00");
            @if (u.State == UnitState.Passed)
            {
                <a class="unit-item passed" href="@($"bolimlar/{u.Id}")">
                    <span class="unit-no">@no</span>
                    <span class="unit-text"><b>@u.Number-bo‘lim · @u.WordCount ta so‘z</b>@if (u.Themes.Count > 0) {<span class="unit-sub">@string.Join(" · ", u.Themes)</span>}</span>
                    <span class="unit-end">@if (u.BestScorePercent is { } best) {<b>@best%</b>}<Icon Name="check" Size="22" /></span>
                </a>
            }
            else if (u.State == UnitState.Open)
            {
                <a class="unit-item open" href="@($"bolimlar/{u.Id}")">
                    <span class="unit-no">@no</span>
                    <span class="unit-text">
                        <b>@u.Number-bo‘lim · @u.WordCount ta so‘z</b>
                        <span class="unit-sub">@u.Started/@u.WordCount boshlangan</span>
                        <span class="progress unit-progress"><span style="width:@(u.WordCount == 0 ? 0 : u.Started * 100 / u.WordCount)%"></span></span>
                    </span>
                    <span class="unit-end"><Icon Name="arrow-right" Size="22" /></span>
                </a>
            }
            else if (u.CanSkip)
            {
                <div class="unit-item next">
                    <span class="unit-no">@no</span>
                    <span class="unit-text">
                        <b>@u.Number-bo‘lim · @u.WordCount ta so‘z</b>
                        <span class="unit-sub">Avval @(u.Number - 1)-bo‘limni tugating</span>
                    </span>
                    <span class="unit-end"><Icon Name="lock" /></span>
                    @* "Bilaman — testni topshirish" (spec §4.5): only the next locked unit, 3 times a day. *@
                    <button class="btn btn-secondary block unit-skip" disabled="@_busy" @onclick="() => SkipAsync(unit)">
                        <span>Bilaman — testni topshirish</span>
                    </button>
                    <span class="unit-skip-note">80% to‘g‘ri bo‘lsa bo‘lim o‘tiladi. Kuniga 3 marta.</span>
                </div>
            }
            else
            {
                <div class="unit-item locked" aria-label="@($"{u.Number}-bo‘lim, qulflangan")">
                    <span class="unit-no">@no</span>
                    <span class="unit-text">@u.Number-bo‘lim · @u.WordCount ta so‘z</span>
                    <span class="unit-end"><Icon Name="lock" /></span>
                </div>
            }
        }
    </div>
    @if (_units.ComingSoon > 0)
    {
        <p class="muted small-text" style="margin-top:12px">Yana @_units.ComingSoon ta bo‘lim tez orada.</p>
    }
    <p class="muted small-text" style="margin-top:12px">Manba: 국립국어원 한국어 학습용 어휘 목록 (KOGL 1-tur).</p>
}

@code {
    private IReadOnlyList<LevelDto>? _levels;
    private CatalogLevel _level = CatalogLevel.A;
    private LevelUnitsDto? _units;
    private string? _error;

    private bool _busy;

    private async Task SkipAsync(UnitSummaryDto unit)
    {
        _busy = true;
        var result = await Api.SendJsonAsync<TestDto>(HttpMethod.Post, $"api/units/{unit.Id}/tests", new StartUnitTestRequest(Guid.NewGuid(), UnitTestKind.Skip));
        _busy = false;
        if (result.Value is { } test)
        {
            Nav.NavigateTo($"sinov/{test.Id}");
            return;
        }

        _error = result.Error;
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task SelectAsync(CatalogLevel level)
    {
        _level = level;
        _units = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _levels ??= (await Api.GetAsync<List<LevelDto>>("api/levels")).Value;
        var result = await Api.GetAsync<LevelUnitsDto>($"api/levels/{_level}/units");
        _error = result.Ok ? null : result.Error;
        _units = result.Value;
    }
}
