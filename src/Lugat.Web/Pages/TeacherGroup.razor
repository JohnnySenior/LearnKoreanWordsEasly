@page "/oqituvchi/guruh/{Id:guid}"
@using Lugat.Contracts
@using Lugat.Domain.Teaching
@inject SessionService Api
@inject BrowserInterop Browser
@inject NavigationManager Nav

<PageTitle>Guruh — Koreyscha</PageTitle>

@* One group (spec §9.2): the summary, trends, scores and "E'tibor bering" (L-73), the learners table and the group's
   hardest words. Every number comes from the server; the page only lays them out. *@
<a class="back" href="oqituvchi">← O‘qituvchi paneli</a>

@if (_group is null)
{
    <p class="muted">@(_error ?? "Yuklanmoqda…")</p>
    return;
}

<h1>@_group.Name</h1>
@if (_error is not null)
{
    <div class="notice" role="alert">@_error</div>
}

@if (_insights is { } ins)
{
    <div class="insight-tiles" role="list" aria-label="Guruh xulosasi">
        <div class="insight-tile" role="listitem">
            <strong>@ins.ActiveToday<small> / @ins.Members</small></strong>
            <span>Bugun faol</span>
        </div>
        @if (ins.Homework is { } hw)
        {
            <div class="insight-tile" role="listitem" title="@($"«{hw.Name}» · muddat {Format.Day(hw.DueOn)}: {hw.Done} / {hw.Members}")">
                <strong>@hw.Percent%</strong>
                <span>Vazifani bajardi<small>«@hw.Name» · @(hw.DuePassed ? "muddat o‘tdi" : $"muddat {Format.Day(hw.DueOn)}")</small></span>
            </div>
        }
        <div class="insight-tile" role="listitem">
            <strong>@(ins.AverageTestPercent is { } avg ? $"{avg}%" : "—")@if (ins.AverageTestChange is { } ch) {<small class="@(ch > 0 ? "up" : ch < 0 ? "down" : null)"> @(ch > 0 ? $"+{ch}" : ch < 0 ? $"−{-ch}" : "±0")</small>}</strong>
            <span>O‘rtacha test<small>@(ins.AverageTestChange is null ? "oxirgi bo‘lim testlari" : "o‘tgan haftaga nisbatan")</small></span>
        </div>
        <div class="insight-tile @(ins.Attention.Count > 0 ? "alert" : null)" role="listitem">
            <strong>@ins.Attention.Count</strong>
            <span>E’tibor bering</span>
        </div>
    </div>

    @if (ins.Attention.Count > 0)
    {
        <section class="card">
            <h2>E’tibor bering</h2>
            <ul class="attention-list">
                @foreach (var a in ins.Attention)
                {
                    <li><a href="@($"oqituvchi/oquvchi/{a.UserId}")">@(a.Name ?? "—")</a><RiskFlags Flags="a.Flags" /></li>
                }
            </ul>
        </section>
    }

    <section class="card">
        <h2>Oxirgi 8 hafta</h2>
        <h3 class="chart-title">Takrorlangan kartochkalar</h3>
        <TrendChart Label="Guruh har hafta takrorlagan kartochkalar, oxirgi 8 hafta" Points="@Trend(ins.Weeks, w => w.Reviewed, "karta")" />
        <h3 class="chart-title">Faol o‘quvchilar</h3>
        <TrendChart Label="Har hafta faol bo‘lgan o‘quvchilar, oxirgi 8 hafta" Points="@Trend(ins.Weeks, w => w.Active, "o‘quvchi")" />
        <p class="muted small-text">Haftalar dushanbadan (Koreya vaqti). Kartochka haftasiga bir marta sanaladi; oxirgi nuqta — shu hafta hozirgacha.</p>
    </section>

    @if (ins.Scores.Count > 0)
    {
        <section class="card">
            <h2>Test ballari</h2>
            <ScoreBars Scores="ins.Scores" LowPercent="ins.LowScorePercent" />
            <p class="muted small-text">Har o‘quvchining oxirgi bo‘lim testi. @ins.LowScorePercent% dan pasti boshqa rangda.</p>
        </section>
    }
}

<section class="card">
    <h2>Taklif havolasi</h2>
    <p class="muted small-text">O‘quvchi havolani ochib, rozilik bersa guruhga qo‘shiladi.</p>
    <span class="invite-link">@InviteUrl</span>
    <button class="button small" @onclick="CopyAsync">@(_copied ? "Nusxa olindi" : "Nusxa olish")</button>
    @if (_confirmRenew)
    {
        <button class="button small" disabled="@_busy" @onclick="RenewAsync">Ha, yangi havola</button>
        <button class="link-btn muted" @onclick="() => _confirmRenew = false">Bekor</button>
    }
    else
    {
        <button class="link-btn muted" @onclick="() => _confirmRenew = true">Yangi havola</button>
    }
    @if (_confirmRenew)
    {
        <p class="muted small-text">Eski havola ishlamay qoladi; guruhdagilar qoladi.</p>
    }
</section>

<section class="card">
    <h2>O‘quvchilar (@_group.Students.Count)</h2>
    @if (_group.Students.Count == 0)
    {
        <p class="muted">Hali hech kim qo‘shilmagan.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th>Ism</th><th>Joriy</th><th class="num">Tugallangan</th><th class="num">Oxirgi test</th><th class="num">7 kunda faol</th><th class="num">Takrorladi (7 kun)</th><th class="num">Takror kutyapti</th><th>Oxirgi kirish</th></tr>
                </thead>
                <tbody>
                    @foreach (var s in _group.Students)
                    {
                        <tr>
                            <td class="wrap"><a href="@($"oqituvchi/oquvchi/{s.UserId}")">@(s.Name ?? "—")</a>@if (Flagged(s.UserId) is { } flags) {<span class="risk-mark" role="img" aria-label="@($"E’tibor bering: {flags}")" title="@flags">⚠</span>}</td>
                            <td>@(s.CurrentUnit ?? "—")</td>
                            <td class="num">@s.PassedUnits</td>
                            <td class="num">@(s.LastTestPercent is { } p ? $"{p}%" : "—")</td>
                            <td class="num">@s.ActiveDays7</td>
                            <td class="num">@s.Reviewed7</td>
                            <td class="num">@s.DueNow</td>
                            <td>@Format.Ago(s.LastSeenAt, DateTimeOffset.UtcNow)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="muted small-text">«Takrorladi» — oxirgi 7 kunda javob bergan kartochkalari (har biri bir marta). «Takror kutyapti» — vaqti kelgan, hali takrorlanmagan kartochkalar.</p>
    }
</section>

<section class="card">
    <h2>Lug‘atlar</h2>
    <p class="muted small-text">O‘z kitobingizdagi darsning so‘zlari (L-67): faylni yuklaysiz, tekshirasiz, guruhga berasiz — o‘quvchilarda kartochka bo‘lib chiqadi.</p>
    @if (_decks is null)
    {
        <p class="muted">Yuklanmoqda…</p>
    }
    else
    {
        @foreach (var d in _decks)
        {
            <a class="button block" href="@($"oqituvchi/lugat/{d.Id}")">
                <span>@d.Name</span>
                <span class="aside">@d.Words so‘z · @(d.Status == GroupDeckStatus.Published ? "berilgan" : "qoralama") →</span>
            </a>
        }
    }
    <div class="row-between" style="margin-top:12px;align-items:center">
        <input class="input" style="flex:1;min-width:0" maxlength="60" placeholder="Yangi lug‘at nomi, masalan: 3-dars" aria-label="Yangi lug‘at nomi" @bind="_deckName" @bind:event="oninput" />
        <button class="button small" disabled="@(_busy || string.IsNullOrWhiteSpace(_deckName))" @onclick="CreateDeckAsync">Yaratish</button>
    </div>
</section>

<section class="card">
    <h2>Eng qiyin 10 so‘z</h2>
    @if (_group.HardestWords.Count == 0)
    {
        <p class="muted">Hali xato yo‘q.</p>
    }
    else
    {
        <MissedWords Words="_group.HardestWords" ShowLearners="true" />
    }
</section>

<section class="card danger-zone">
    @if (_confirmClose)
    {
        <p><strong>Guruhni yopasizmi?</strong> O‘quvchilar ro‘yxati sizga ko‘rinmay qoladi, havola ishlamaydi. O‘quvchilarning o‘z ma’lumotlari o‘zida qoladi.</p>
        <button class="button" disabled="@_busy" @onclick="CloseAsync">Ha, yopish</button>
        <button class="button" @onclick="() => _confirmClose = false">Bekor qilish</button>
    }
    else
    {
        <button class="button" @onclick="() => _confirmClose = true">Guruhni yopish</button>
    }
</section>

@code {
    [Parameter] public Guid Id { get; set; }

    private GroupDetailDto? _group;
    private GroupInsightsDto? _insights;
    private List<GroupDeckSummaryDto>? _decks;
    private string _deckName = "";
    private string? _error;
    private bool _busy;
    private bool _copied;
    private bool _confirmRenew;
    private bool _confirmClose;

    private string InviteUrl => Nav.ToAbsoluteUri($"join/{_group!.InviteCode}").ToString();

    protected override async Task OnParametersSetAsync()
    {
        var result = await Api.GetAsync<GroupDetailDto>($"api/teacher/groups/{Id}");
        (_group, _error) = (result.Value, result.Error);
        _decks = (await Api.GetAsync<List<GroupDeckSummaryDto>>($"api/teacher/groups/{Id}/decks")).Value;
        _insights = (await Api.GetAsync<GroupInsightsDto>($"api/teacher/groups/{Id}/insights")).Value;
    }

    /// <summary>The learner's flags as one line for the table's warning mark, or null when there are none.</summary>
    private string? Flagged(Guid userId) =>
        _insights?.Attention.FirstOrDefault(a => a.UserId == userId) is { } a ? string.Join(" · ", a.Flags.Select(f => f.Detail)) : null;

    private static IReadOnlyList<TrendChart.TrendPoint> Trend(IReadOnlyList<WeekPointDto> weeks, Func<WeekPointDto, int> value, string unit) =>
        weeks.Select(w => new TrendChart.TrendPoint(Format.Day(w.WeekStart), value(w), $"{Format.Day(w.WeekStart)} haftasi: {value(w)} {unit}")).ToList();

    private async Task CreateDeckAsync()
    {
        _busy = true;
        var result = await Api.SendJsonAsync<GroupDeckDto>(HttpMethod.Post, $"api/teacher/groups/{Id}/decks", new CreateGroupDeckRequest(Guid.NewGuid(), _deckName.Trim()));
        _busy = false;
        if (result.Value is { } deck)
        {
            Nav.NavigateTo($"oqituvchi/lugat/{deck.Id}");
            return;
        }

        _error = result.Error;
    }

    private async Task CopyAsync() => _copied = await Browser.CopyTextAsync(InviteUrl);

    private async Task RenewAsync()
    {
        _busy = true;
        var result = await Api.SendJsonAsync<TeacherGroupDto>(HttpMethod.Post, $"api/teacher/groups/{Id}/invite");
        (_busy, _confirmRenew, _copied, _error) = (false, false, false, result.Error);
        if (result.Value is { } renewed && _group is not null)
        {
            _group = _group with { InviteCode = renewed.InviteCode };
        }
    }

    private async Task CloseAsync()
    {
        _busy = true;
        var result = await Api.SendJsonAsync<object>(HttpMethod.Delete, $"api/teacher/groups/{Id}");
        _busy = false;
        if (result.Ok)
        {
            Nav.NavigateTo("oqituvchi");
        }

        _error = result.Error;
    }
}
