@page "/profil"
@page "/sozlamalar"
@using Lugat.Contracts
@using Lugat.Domain.Premium
@using Lugat.Domain.Users
@inject SessionService Api
@inject BrowserInterop Browser

<PageTitle>Profil — Koreyscha</PageTitle>

@* UI handoff 2a/2b: only what belongs to the learner. Admins, editors and teachers get a "Boshqaruv" block; the system
   settings (AI, spend, backups) live in Admin → Tizim. Every group is closed by a 2px rule. *@
@if (_me is null)
{
    <div class="profile-head" aria-busy="true"><span class="skeleton" style="width:56px;height:56px"></span><span class="skeleton" style="width:50%"></span></div>
    return;
}

<header class="profile-head">
    <span class="profile-avatar" aria-hidden="true">@Initials</span>
    <div>
        <h1>@(_me.DisplayName ?? "Foydalanuvchi")</h1>
        <div class="tags">
            @if (IsAdmin)
            {
                <Tag Kind="accent">Admin</Tag>
            }
            @if (IsEditor && !IsAdmin)
            {
                <Tag>Muharrir</Tag>
            }
            @if (IsTeacher)
            {
                <Tag>O‘qituvchi</Tag>
            }
            @if (!IsAdmin && !IsEditor && !IsTeacher)
            {
                @foreach (var login in _me.Logins)
                {
                    <Tag>@login.Provider</Tag>
                }
            }
        </div>
    </div>
</header>

@if (IsAdmin || IsEditor || IsTeacher)
{
    <SectionLabel Text="Boshqaruv" Accent="true" />
    <div class="manage-grid">
        @if (IsAdmin)
        {
            <a class="manage-cell primary" href="admin">
                <b>Admin panel</b>
                <span>Foydalanuvchilar, to‘lovlar, kontent, tizim</span>
                <Icon Name="arrow-right" />
            </a>
        }
        else if (IsEditor)
        {
            <a class="manage-cell primary" href="kontent">
                <b>Kontent</b>
                <span>Import, AI qoralama, tekshirish, nashr</span>
                <Icon Name="arrow-right" />
            </a>
        }
        @if (IsTeacher)
        {
            <a class="manage-cell" href="oqituvchi">
                <b>O‘qituvchi paneli</b>
                <span>@(_teacherGroups is { } g ? $"{g.Count} guruh · {g.Sum(x => x.Members)} o‘quvchi" : "Guruhlar, komissiya")</span>
                <Icon Name="arrow-right" />
            </a>
        }
    </div>
}

<div class="profile-plan">
    <div>
        <span class="kicker">Tarif</span>
        <b>@PlanText</b>
    </div>
    @if (_premium is { IsPremium: false })
    {
        <a class="btn btn-primary" href="premium">Premium</a>
    }
</div>

<SectionLabel Text="O‘qish" />
<ListRow Label="Statistika" Note="O‘rganilgan so‘zlar, qiyin so‘zlar" Href="natijalar" />
<ListRow Label="Oldingi sinovlar" Note="Natijalar grafigi" Href="sinov/oldingi" />
@if (_groups is { Count: > 0 } groups)
{
    <ListRow Label="O‘qituvchi guruhi" Value="@(groups[0].TeacherName ?? groups[0].Name)" Href="profil/hisob" />
}

<SectionLabel Text="Sozlamalar" />
<ListRow Label="Mavzu">
    <div class="seg" role="radiogroup" aria-label="Mavzu">
        @foreach (var (value, label) in Themes)
        {
            var v = value;
            <button class="@(_me.Theme == v ? "selected" : "")" role="radio" aria-checked="@(_me.Theme == v)" disabled="@_busy" @onclick="() => SaveAsync(theme: v)">@label</button>
        }
    </div>
</ListRow>
<ListRow Label="Lotincha o‘qilish">
    <Toggle Value="_me.ShowRomanization" ValueChanged="v => SaveAsync(romanization: v)" Label="Lotincha o‘qilishni ko‘rsatish" Disabled="_busy" />
</ListRow>
@if (_prefs is { RemindersAvailable: true, HasTelegram: true } prefs)
{
    <ListRow Label="Eslatma" Value="@(prefs.RemindersEnabled ? prefs.ReminderTime.ToString("HH:mm") : "O‘chiq")" Href="profil/eslatma" />
}
@if (_status is not null)
{
    <p role="status" class="small-text" style="margin-top:8px">@_status</p>
}

<SectionLabel Text="Ilova" />
<ListRow Label="Telefonga o‘rnatish" Href="ornatish" />
<ListRow Label="Hisobni bog‘lash" Note="@string.Join(" · ", _me.Logins.Select(l => l.Provider.ToString()))" Href="profil/hisob" />
<ListRow Label="Qurilmani tekshirish" Note="Ovoz va mikrofon" Href="diagnostika" />
<ListRow Label="Haqida" Note="Manba, litsenziya, maxfiylik" Href="profil/haqida" />

<section class="profile-bottom">
    <button class="btn btn-secondary block small" disabled="@_busy" @onclick="LogoutAsync"><span>Chiqish</span></button>
    @if (_confirmDelete)
    {
        <p class="small-text" style="margin:12px 0 4px"><strong>Rostdan ham o‘chirasizmi?</strong> Kirish usullari, so‘zlaringiz, kartochkalar, javoblar va sinov natijalari butunlay o‘chiriladi. Buni qaytarib bo‘lmaydi.</p>
        <button class="btn btn-ghost small danger" disabled="@_busy" @onclick="DeleteAsync">Ha, hisobni o‘chirish</button>
        <button class="btn btn-ghost small" disabled="@_busy" @onclick="() => _confirmDelete = false">Bekor qilish</button>
    }
    else
    {
        <button class="btn btn-ghost small danger" @onclick="() => _confirmDelete = true">Hisobni o‘chirish</button>
    }
    @if (_deleteError is not null)
    {
        <div class="notice" role="alert">@_deleteError</div>
    }
    <p class="muted small-text">Chiqish barcha qurilmalarda sessiyani tugatadi.</p>
</section>

@code {
    // The sign-in screen that follows says when the other devices could not be signed out (SessionService).
    private async Task LogoutAsync()
    {
        _busy = true;
        try
        {
            await Api.LogoutAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private static readonly (ThemeChoice Value, string Label)[] Themes =
        [(ThemeChoice.Light, "Yorug‘"), (ThemeChoice.Dark, "Qorong‘i"), (ThemeChoice.Device, "Qurilma")];

    private MeDto? _me;
    private PreferencesDto? _prefs;
    private PremiumStatusDto? _premium;
    private List<MyGroupDto>? _groups;
    private List<TeacherGroupDto>? _teacherGroups;
    private bool _busy;
    private bool _confirmDelete;
    private string? _status;
    private string? _deleteError;

    private bool IsAdmin => _me?.Roles.Contains(nameof(UserRoles.Admin)) == true;

    private bool IsEditor => IsAdmin || _me?.Roles.Contains(nameof(UserRoles.Editor)) == true;

    private bool IsTeacher => _me?.Roles.Contains(nameof(UserRoles.Teacher)) == true;

    private string Initials => string.Concat((_me?.DisplayName ?? "?").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpperInvariant(w[0])));

    private string PlanText => _premium switch
    {
        { IsPremium: true, EndsAt: { } end } => $"Premium · {Format.DayMonth(end).Split(", ").Last()}gacha",
        { IsPremium: true } => "Premium",
        _ => "Bepul",
    };

    protected override async Task OnInitializedAsync()
    {
        _me = await Api.ReloadMeAsync();
        _premium = (await Api.GetAsync<PremiumStatusDto>("api/me/premium")).Value;
        _prefs = (await Api.GetAsync<PreferencesDto>("api/me/preferences")).Value;
        _groups = (await Api.GetAsync<List<MyGroupDto>>("api/me/groups")).Value;
        if (IsTeacher)
        {
            _teacherGroups = (await Api.GetAsync<List<TeacherGroupDto>>("api/teacher/groups")).Value;
        }
    }

    // Theme and romanization save at once (no "Saqlash" in the design).
    private async Task SaveAsync(ThemeChoice? theme = null, bool? romanization = null)
    {
        _busy = true;
        var result = await Api.SendJsonAsync<MeDto>(HttpMethod.Patch, "api/me", new UpdateMeRequest(null, romanization, theme));
        _busy = false;
        _status = result.Ok ? null : result.Error;
        if (result.Ok)
        {
            _me = await Api.ReloadMeAsync() ?? _me;
            if (theme is { } t)
            {
                await Browser.SetThemeAsync(t);
            }
        }
    }

    private async Task DeleteAsync()
    {
        _busy = true;
        var result = await Api.DeleteAccountAsync();
        _busy = false;
        _deleteError = result.Ok ? null : result.Error;
    }
}
