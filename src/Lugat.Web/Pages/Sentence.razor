@page "/gap"
@using Lugat.Contracts
@inject SessionService Api
@inject NavigationManager Nav

<PageTitle>Gap tuzish — Lug‘at</PageTitle>

<a class="back" href="mashq">← Mashqlar</a>
<h1>Gap tuzish</h1>
<p class="muted small-text">So‘z bilan bitta koreyscha gap yozing. AI avval barcha xatolar qayerdaligini aytadi, to‘g‘ri variantni esa siz so‘raganda ko‘rsatadi. Bu mashq so‘zning takrorlash jadvaliga ta’sir qilmaydi.</p>

@if (_error is not null)
{
    <div class="notice" role="alert">@_error</div>
}

@if (_target is null)
{
    @if (_error is null)
    {
        <p class="muted">Yuklanmoqda…</p>
    }
}
else
{
    <section class="card">
        <div class="row-between">
            <span class="ko big" lang="ko">@_target.Korean</span>
            <span class="muted">@(_target.Unit is null ? "" : $"{_target.Unit}-bo‘lim")</span>
        </div>
        @if (_target.KoreanNote is not null)
        {
            <p class="muted" lang="ko">@_target.KoreanNote</p>
        }
        <p>@_target.Uzbek</p>
        <button class="button small" disabled="@_busy" @onclick="NextWordAsync">Boshqa so‘z</button>
    </section>

    <section class="card">
        <label class="field">
            Gapingiz (koreyscha)
            <textarea class="input sentence" rows="3" lang="ko" maxlength="500" @bind="_answer" @bind:event="oninput" disabled="@_busy"></textarea>
        </label>
        <button class="button primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_answer))" @onclick="CheckAsync">
            @(_busy ? "Tekshirilmoqda…" : "Tekshirish")
        </button>
    </section>

    @if (_check is { } c)
    {
        <SentenceResult Check="c" Busy="_busy" OnRetry="Retry" OnRecheck="RecheckAsync" />
    }
}

@code {
    [SupplyParameterFromQuery(Name = "soz")] public Guid? LearningItemId { get; set; }

    private SentenceTargetDto? _target;
    private SentenceCheckDto? _check;
    private string _answer = "";
    private Guid _attemptId = Guid.NewGuid();
    private string? _attemptText;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadTargetAsync(LearningItemId);

    private async Task LoadTargetAsync(Guid? id)
    {
        var result = await Api.GetAsync<SentenceTargetDto>(id is null ? "api/practice/target" : $"api/practice/target?learningItemId={id}");
        _error = result.Ok ? null : result.Error;
        _target = result.Value ?? _target;
    }

    private async Task NextWordAsync()
    {
        _check = null;
        _answer = "";
        await LoadTargetAsync(null);
    }

    private async Task CheckAsync()
    {
        var text = _answer.Trim();
        if (_attemptText != text)
        {
            // A new text is a new attempt; the same text after a network error reuses its id (spec API01).
            _attemptId = Guid.NewGuid();
            _attemptText = text;
        }

        await SendAsync(_attemptId, text);
    }

    private Guid? _recheckFor;

    private Task RecheckAsync()
    {
        if (_recheckFor != _check?.Id)
        {
            _recheckFor = _check?.Id;
            _attemptId = Guid.NewGuid();
        }
        return SendAsync(_attemptId, _attemptText ?? _answer.Trim());
    }

    private async Task SendAsync(Guid id, string text)
    {
        _busy = true;
        try
        {
            var result = await Api.SendJsonAsync<SentenceCheckDto>(HttpMethod.Post, "api/practice/check", new SentenceCheckRequest(id, _target?.LearningItemId, text), SessionService.AiTimeout);
            _error = result.Ok ? null : result.Error;
            _check = result.Value ?? _check;
        }
        finally
        {
            _busy = false;
        }
    }

    private void Retry()
    {
        _check = null;
    }
}

