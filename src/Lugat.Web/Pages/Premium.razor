@page "/premium"
@using Lugat.Contracts
@using Lugat.Domain.Premium
@inject SessionService Api
@inject BrowserInterop Browser

<PageTitle>Premium — Koreyscha</PageTitle>

@* Premium (spec §7): what it gives, the plans, how to pay by bank transfer, the learner's payment code. Whether the
   learner has Premium is decided by the server only. *@
<AppHeader Title="Premium" Back="profil" />

@if (_status is null || _plans is null)
{
    @if (_error is not null)
    {
        <div class="notice" role="alert">@_error</div>
    }
    else
    {
        <div aria-busy="true" style="margin-top:16px"><span class="skeleton" style="width:80%"></span><span class="skeleton" style="width:60%;margin-top:10px"></span></div>
    }
    return;
}

@if (!_status.IsPremium && Wanted is { } wanted)
{
    @* L-64: what the learner tried to open, in one sentence, with their own number where there is one. *@
    <section class="premium-wanted">
        <span class="kicker accent">Premium</span>
        <h2>Siz «@wanted.Name»ni ochmoqchi edingiz</h2>
        <p>@wanted.Gives</p>
        @if (_mistakes is { Count: > 0 } m && F is PremiumFeatures.Mistakes or PremiumFeatures.WeakPoints)
        {
            <p class="premium-wanted-number">So‘nggi @m.Days kunda <strong>@m.Count ta so‘zda</strong> adashgansiz — Premium ularni bir joyga yig‘ib, qayta mashq qildiradi.</p>
        }
    </section>
}

<section class="premium-intro">
    @if (_status.IsPremium)
    {
        <span class="kicker accent">Premium faol</span>
        <p><strong>@Format.DayMonth(_status.EndsAt!.Value) gacha</strong>@(_status.Plan == SubscriptionPlan.Trial ? " (sinov muddati)" : ""). Muddatni uzaytirish uchun yana to‘lashingiz mumkin: yangi muddat hozirgisi tugagan kundan boshlanadi.</p>
    }
    else
    {
        <p>Barcha bo‘limlar, testlar va takrorlash <strong>bepul</strong>. Premium — talaffuz baholash, «Xatolarim» va AI mashqlari.</p>
    }
    @if (_status.TrapNotesFree)
    {
        <p class="muted small-text">So‘z kartasidagi tayyor «o‘zbekcha tuzoq» izohi hammaga bepul.</p>
    }
</section>

@if (_trialStarted && Wanted is { } opened)
{
    <a class="btn btn-primary block" href="@opened.Path"><span>«@opened.Name»ni ochish</span><Icon Name="arrow-right" /></a>
}
else if (!_status.IsPremium && _trial is { Eligible: true } trial)
{
    @* L-64: earned after the first unit; once per learner, nothing to pay, it simply ends. *@
    <section class="trial-offer">
        <b>Premium’ni @trial.Days kun bepul sinab ko‘ring</b>
        <span class="muted small-text">Birinchi bo‘limni tugatganingiz uchun. Karta yoki to‘lov kerak emas — muddat tugagach o‘zi to‘xtaydi.</span>
        <button class="btn btn-secondary" disabled="@_trialBusy" @onclick="StartTrialAsync"><span>Sinovni boshlash</span></button>
        @if (_trialError is not null)
        {
            <div class="notice" role="alert">@_trialError</div>
        }
    </section>
}

@if (_plans.BankUz is not null)
{
    @* L-48: learners in Uzbekistan pay in so‘m to a card there; prices are set on their own. *@
    <div class="seg" role="radiogroup" aria-label="Qayerdan to‘laysiz">
        @foreach (var (currency, label) in new[] { (Currency.Krw, "Koreyadan (₩)"), (Currency.Uzs, "O‘zbekistondan (so‘m)") })
        {
            var choice = currency;
            <button class="@(_currency == choice ? "selected" : "")" role="radio" aria-checked="@(_currency == choice)" @onclick="() => SelectCurrencyAsync(choice)">@label</button>
        }
    </div>
}

<div class="plan-grid" role="radiogroup" aria-label="Tarif">
    @foreach (var p in _plans.Plans)
    {
        var plan = p;
        var price = plan.Price(_currency);
        var monthly = _plans.Plans.FirstOrDefault(x => x.Months == 1)?.Price(_currency);
        var saving = monthly is { } m && plan.Months > 1 && m * plan.Months > price ? 100 - price * 100 / (m * plan.Months) : 0;
        <button class="plan @(_plan == plan.Plan ? "selected" : "")" role="radio" aria-checked="@(_plan == plan.Plan)" @onclick="() => SelectAsync(plan.Plan)">
            <span class="plan-head"><span>@plan.Title</span>@if (saving > 0) {<span class="plan-save">−@saving%</span>}</span>
            <b>@Format.Money(price, _currency)</b>
            <span class="plan-note">@(plan.Months == 1 ? "30 kun" : $"{Format.Money(price / plan.Months, _currency)} / oy")</span>
        </button>
    }
</div>

<section class="pay-code">
    <span class="kicker">To‘lov kodi — o‘tkazma izohiga yozing</span>
    <div class="pay-code-row">
        <code>@_status.PaymentCode</code>
        <button class="btn btn-ghost" @onclick="CopyAsync">@(_copied ? "Nusxalandi" : "Nusxalash")</button>
    </div>
</section>

<dl class="bank-facts">
    <dt>Bank</dt><dd>@(Bank?.BankName ?? "Tez orada")</dd>
    <dt>@(Bank?.Kind is { } kind ? $"{kind} karta" : "Hisob")</dt><dd>@(Bank?.AccountNumber ?? "Tez orada")</dd>
    @if (Bank is { } bank)
    {
        <dt>Egasi</dt><dd>@bank.AccountHolder</dd>
        <dt>Summa</dt><dd><strong>@(_busy ? "Hisoblanmoqda…" : Format.Money(Price, _currency))</strong></dd>
    }
</dl>

<section class="promo">
    <label class="muted small-text" for="promo">Promo-kod</label>
    <div class="promo-row">
        <input id="promo" class="input" maxlength="32" autocapitalize="characters" @bind="_promo" @bind:event="oninput" />
        <button class="btn btn-secondary" disabled="@(_busy || string.IsNullOrWhiteSpace(_promo))" @onclick="CheckPromoAsync"><span>Tekshirish</span></button>
    </div>
    @if (_check is { } c && (!c.Valid || HasCurrentDiscount))
    {
        <p class="promo-result" role="status">@(c.Valid ? $"Chegirma {c.DiscountPercent}% · {Format.Money(c.FinalPrice, c.Currency)}" : c.Message)</p>
    }
</section>

@if (!_busy && Bank is not null && _plans.ContactTelegram is { } contact)
{
    <div class="sticky-space"></div>
    <div class="sticky-action">
        <a class="btn btn-primary block big" href="@($"https://t.me/{contact}")" target="_blank" rel="noopener"><span>Chekni Telegramda yuborish</span><Icon Name="arrow-right" /></a>
    </div>
    <p class="muted small-text">To‘lov tekshirilgach Premium yoqiladi va shu sahifada ko‘rinadi; Telegram orqali kirgan bo‘lsangiz, bot ham xabar beradi.</p>
}

@code {
    /// <summary>The feature the learner wanted (L-64), e.g. "xatolar"; an unknown key shows nothing.</summary>
    [SupplyParameterFromQuery(Name = "f")] public string? F { get; set; }

    private static readonly Dictionary<string, (string Name, string Gives, string Path)> Features = new()
    {
        [PremiumFeatures.Mistakes] = ("Xatolarim", "Adashgan so‘zlaringiz bir joyda turadi va ular bilan alohida mashq qilasiz.", "xatolar"),
        [PremiumFeatures.WeakPoints] = ("Zaif joylar", "Qaysi turdagi xatolar ko‘p uchrashini ko‘rsatadi va shu so‘zlarni qayta mashq qildiradi.", "zaif-joylar"),
        [PremiumFeatures.Ladder] = ("Gap zinapoyasi", "So‘zni gapda to‘ldirasiz, tartiblaysiz va tarjima qilasiz — AI tekshiradi.", "gap/zinapoya"),
        [PremiumFeatures.Traps] = ("Tuzoqlar daftari", "So‘zma-so‘z tarjimada adashgan joylaringiz to‘g‘ri varianti bilan saqlanadi.", "tuzoqlar"),
        [PremiumFeatures.Listening] = ("Tinglash", "Qisqa dialoglarni eshitib, savollarga javob berasiz.", "tinglash"),
        [PremiumFeatures.Sentence] = ("O‘z gapingiz", "Gapni o‘zingiz yozasiz, AI xatoni ko‘rsatib tushuntiradi.", "gap"),
        [PremiumFeatures.Speaking] = ("Talaffuz", "So‘zni ovoz chiqarib aytasiz, Azure talaffuzingizni baholaydi.", "sinov/ogzaki"),
    };

    private TrialOfferDto? _trial;
    private bool _trialBusy;
    private bool _trialStarted;
    private string? _trialError;

    private async Task StartTrialAsync()
    {
        (_trialBusy, _trialError) = (true, null);
        var result = await Api.SendJsonAsync<PremiumStatusDto>(HttpMethod.Post, "api/premium/trial");
        if (result.Value is { } status)
        {
            (_status, _trialStarted) = (status, true);
        }
        else
        {
            _trialError = result.Error;
        }

        _trialBusy = false;
    }

    private (string Name, string Gives, string Path)? Wanted => F is { } f && Features.TryGetValue(f, out var w) ? w : null;

    private MistakeCountDto? _mistakes;
    private PremiumStatusDto? _status;
    private PremiumPlansDto? _plans;
    private SubscriptionPlan _plan = SubscriptionPlan.Monthly;
    private Currency _currency = Currency.Krw;
    private const string CurrencyKey = "koreyscha.currency";

    private BankDetailsDto? Bank => _currency == Currency.Uzs ? _plans?.BankUz : _plans?.Bank;
    private string? _promo;
    private PromoCheckDto? _check;
    private string? _error;
    private bool _busy;
    private bool _copied;
    private long _promoRequest;
    private SubscriptionPlan? _checkedPlan;
    private string? _checkedCode;

    private async Task CopyAsync() => _copied = await Browser.CopyTextAsync(_status!.PaymentCode);

    private bool HasCurrentDiscount => _check is { Valid: true } c && c.Currency == _currency
        && _checkedPlan == _plan && _checkedCode == (_promo ?? "").Trim();

    private int Price => HasCurrentDiscount ? _check!.FinalPrice : _plans?.Plans.FirstOrDefault(p => p.Plan == _plan)?.Price(_currency) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        var status = await Api.GetAsync<PremiumStatusDto>("api/me/premium");
        var plans = await Api.GetAsync<PremiumPlansDto>("api/premium/plans");
        (_status, _plans) = (status.Value, plans.Value);
        if (_status is { IsPremium: false })
        {
            _trial = (await Api.GetAsync<TrialOfferDto>("api/premium/trial")).Value;
            if (Wanted is not null)
            {
                await Api.SendJsonAsync<object>(HttpMethod.Post, "api/premium/views", new PremiumViewRequest(F!));
            }

            if (F is PremiumFeatures.Mistakes or PremiumFeatures.WeakPoints)
            {
                _mistakes = (await Api.GetAsync<MistakeCountDto>("api/mistakes/count")).Value;
            }
        }
        _error = status.Error ?? plans.Error;
        _plan = _plans?.Plans.FirstOrDefault()?.Plan ?? _plan;
        if (_plans?.BankUz is not null)
        {
            // The last choice on this device, else so‘m for a learner on Tashkent time.
            _currency = await Browser.StorageGetAsync(CurrencyKey) switch
            {
                nameof(Currency.Uzs) => Currency.Uzs,
                nameof(Currency.Krw) => Currency.Krw,
                _ => Api.State.Me?.TimeZone == "Asia/Tashkent" ? Currency.Uzs : Currency.Krw,
            };
        }

        if (_status?.PromoCode is { } teacherCode && _plans is not null)
        {
            // The teacher's code the learner came with (spec §9.1): filled in, with the discount shown.
            _promo = teacherCode;
            await CheckPromoAsync();
        }
    }

    private async Task SelectAsync(SubscriptionPlan plan)
    {
        var recheck = _check is { Valid: true } || _busy;
        _promoRequest++;
        _check = null;
        _plan = plan;
        if (recheck)
        {
            await CheckPromoAsync();
        }
    }

    private async Task SelectCurrencyAsync(Currency currency)
    {
        var recheck = _check is { Valid: true } || _busy;
        _promoRequest++;
        _check = null;
        _currency = currency;
        await Browser.StorageSetAsync(CurrencyKey, currency.ToString());
        if (_currency == currency && recheck)
        {
            await CheckPromoAsync();
        }
    }

    private async Task CheckPromoAsync()
    {
        var sequence = ++_promoRequest;
        var request = new PromoCheckRequest((_promo ?? "").Trim(), _plan, _currency);
        _check = null;
        _busy = true;
        var result = await Api.SendJsonAsync<PromoCheckDto>(HttpMethod.Post, "api/premium/promo/check", request);
        if (sequence != _promoRequest)
        {
            return;
        }

        if (request.Plan == _plan && request.Currency == _currency && request.Code == (_promo ?? "").Trim())
        {
            _checkedPlan = request.Plan;
            _checkedCode = request.Code;
            _check = result.Value is { } value && value.Currency == request.Currency ? value
                : new PromoCheckDto(false, request.Code, 0, 0, 0, result.Error, request.Currency);
        }
        _busy = false;
    }
}
