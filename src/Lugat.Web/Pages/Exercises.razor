@page "/mashq"
@using Lugat.Contracts
@inject SessionService Api

<PageTitle>Mashqlar — Koreyscha</PageTitle>

@* One practice page in three groups (L-47): words, sentences, and the learner's mistakes. Cards are the "Takror"
   tab; the unit test is in the unit. Premium ones keep a tag and lead to the Premium page (spec §4.7). *@
<header class="practice-head">
    <h1>Mashq</h1>
    <p class="muted">Ochilgan bo‘limlar so‘zlari bilan</p>
</header>

@if (_tests?.FirstOrDefault(r => r.Status == Lugat.Domain.Testing.TestRunStatus.InProgress) is { } open)
{
    <a class="btn btn-primary block" href="@($"sinov/{open.Id}")" style="margin-bottom:12px;justify-content:space-between;gap:12px">
        <span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">Davom etish: @open.Title</span>
        <span style="flex:none">@open.Answered / @open.Total</span>
    </a>
}

<SectionLabel Text="So‘zlar" />
<nav class="practice-list" aria-label="So‘z mashqlari">
    @Row("01", "Yozma mashq", "O‘zbekchadan koreyschaga yozing", "mashq/yozish", false)
    @Row("02", "Qaysi so‘z to‘g‘ri?", "Gapdagi bo‘sh joyga mos so‘zni tanlang", "mashq/qollanish", false)
    @Row("03", "Talaffuz", "So‘zlarni mikrofon bilan ayting — Azure baholaydi", "sinov/ogzaki", true)
    @Row("04", "Aralash sinov", "Ma’no, koreyscha va bo‘sh joy savollari · baho bilan", "sinov/lugat", false)
    @Row("05", "Krossvord", _crossword is { } c && c.OpenUnits < c.UnitsNeeded
        ? $"🔒 {c.UnitsNeeded}-bo‘limni ochganingizda ochiladi"
        : _crossword?.Active is { } a ? $"Davom etish · {a.Found + a.Revealed} / {a.Clues.Count} so‘z" : "Ma’nosiga qarab so‘zlarni panjaraga yozing", "mashq/krossvord", false)
</nav>

<SectionLabel Text="Gaplar" />
<nav class="practice-list" aria-label="Gap mashqlari">
    @Row("06", "Gap zinapoyasi", "AI bergan gapni to‘ldiring, tartiblang, tarjima qiling", "gap/zinapoya", true)
    @Row("07", "O‘z gapingiz", "Gapni o‘zingiz yozing — AI tekshiradi", "gap", true)
</nav>

<SectionLabel Text="Xatolarim" />
<nav class="practice-list" aria-label="Xatolar">
    @Row("08", "Xatolarim", "Xato qilgan so‘zlar, xato turlari va tuzoqlar", "xatolar", true)
</nav>

@if (_message is not null)
{
    <p class="notice" role="status">@_message</p>
}

@code {
    private PremiumStatusDto? _premium;

    /// <summary>Premium features stay visible with a lock and lead to the Premium page (spec §4.7).</summary>
    private bool Premium => _premium?.IsPremium != false;

    private RenderFragment Row(string no, string title, string note, string href, bool premium) =>
        @<a class="practice-row" href="@(premium && !Premium ? "premium" : href)">
            <span class="practice-no">@no</span>
            <span class="practice-text"><b>@title</b><span>@note</span></span>
            <span class="practice-end">@if (premium && !Premium) {<Tag Kind="accent">Premium</Tag>}<Icon Name="arrow-right" /></span>
        </a>;
    private string? _message;
    private List<TestSummaryDto>? _tests;
    private CrosswordHomeDto? _crossword;

    protected override async Task OnInitializedAsync()
    {
        _premium = (await Api.GetAsync<PremiumStatusDto>("api/me/premium")).Value;
        var tests = await Api.GetAsync<List<TestSummaryDto>>("api/tests");
        _tests = tests.Value;
        _crossword = (await Api.GetAsync<CrosswordHomeDto>("api/crosswords")).Value;
        _message = tests.Ok ? null : tests.Error;
    }
}
