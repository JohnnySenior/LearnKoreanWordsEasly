@page "/mashq"
@using Lugat.Contracts
@inject SessionService Api
@inject NavigationManager Nav

<PageTitle>Mashqlar — Lug‘at</PageTitle>

<header class="page-head">
    <div>
        <h1>Mashq</h1>
        <span class="muted small-text">Har bir mashq alohida hisoblanadi</span>
    </div>
</header>

<nav class="menu" aria-label="Mashqlar">
    <a href="bolimlar">
        <span class="no">01</span>
        <span><span class="t">Bo‘lim jadvali</span><span class="s">Bo‘limni jadvalda ko‘rib yodlash, keyin kartochka</span></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </a>
    @if (_today?.ActiveSession is { Current: not null } active)
    {
        <a href="mashq/kartochka">
            <span class="no">02</span>
            <span><span class="t">Tez kartochka</span><span class="s">Ikki yo‘nalish aralash · o‘zini baholash</span><span class="aside">Tugallanmagan: @active.Position / @active.Total — davom etish</span></span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </a>
    }
    else
    {
        <a href="mashq" @onclick="StartCardsAsync" @onclick:preventDefault>
            <span class="no">02</span>
            <span><span class="t">Tez kartochka</span><span class="s">Ikki yo‘nalish aralash · o‘zini baholash · 20 daq</span></span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </a>
    }
    <a href="mashq/qollanish">
        <span class="no">03</span>
        <span><span class="t">So‘z qo‘llanishi</span><span class="s">Qaysi so‘z to‘g‘ri? 데려오다 yoki 가져오다 · o‘zbekcha tuzoqlar</span></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </a>
    <a href="@(Premium ? "gap/zinapoya" : "premium")">
        <span class="no">04</span>
        <span><span class="t">Gap zinapoyasi@(PremiumMark)</span><span class="s">To‘ldirish → yig‘ish → tarjima · qo‘shimcha va fe’l shakllari</span></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </a>
    <a href="@(Premium ? "tuzoqlar" : "premium")">
        <span class="no">05</span>
        <span><span class="t">Tuzoqlar daftari@(PremiumMark)</span><span class="s">So‘zma-so‘z tarjima xatolari va to‘g‘risi</span></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </a>
    <a href="@(Premium ? "zaif-joylar" : "premium")">
        <span class="no">06</span>
        <span><span class="t">Zaif joylar@(PremiumMark)</span><span class="s">Nimada ko‘p adashyapsiz · shu xatolardan zinapoya</span></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </a>
    <a href="@(Premium ? "gap" : "premium")">
        <span class="no">07</span>
        <span><span class="t">Gap tuzish@(PremiumMark)</span><span class="s">So‘z bilan gap yozing — AI avval ishora beradi</span></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </a>
    <a href="mashq/yozish">
        <span class="no">08</span>
        <span><span class="t">Yozma javob</span><span class="s">Koreyscha yoki o‘zbekcha yozish · kartochka jadvaliga ta’sir qilmaydi</span></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </a>
    <a href="@(Premium ? "xatolar" : "premium")">
        <span class="no">09</span>
        <span><span class="t">Xatolar daftari@(PremiumMark)</span><span class="s">Xato qilingan so‘zlarni kartochkada takrorlash</span></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </a>
    <a href="sinov">
        <span class="no">10</span>
        <span><span class="t">Sinovlar</span><span class="s">Lug‘at va og‘zaki sinov · oldingi natijalar</span></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </a>
</nav>

<p class="muted small-text" style="margin-top:16px">Mashg‘ulot vaqtini <a href="">Bosh sahifa</a>da ham tanlash mumkin.</p>

@if (_message is not null)
{
    <p class="notice" role="status">@_message</p>
}

@code {
    private TodayDto? _today;
    private PremiumStatusDto? _premium;

    /// <summary>Premium features stay visible with a lock and lead to the Premium page (spec §4.7).</summary>
    private bool Premium => _premium?.IsPremium != false;

    private RenderFragment PremiumMark => Premium ? _ => { } : @<span class="pill pill-accent" style="margin-left:6px">Premium</span>;
    private string? _message;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _premium = (await Api.GetAsync<PremiumStatusDto>("api/me/premium")).Value;
        var today = await Api.GetAsync<TodayDto>("api/today");
        _today = today.Value;
        _message = today.Ok ? null : today.Error;
    }

    private async Task StartCardsAsync()
    {
        if (_busy)
        {
            return; // a double tap must not start two sessions
        }

        _busy = true;
        var result = await Api.SendJsonAsync<StartSessionResponse>(HttpMethod.Post, "api/sessions", new StartSessionRequest(20, false));
        _busy = false;
        if (result.Value?.Session is not null)
        {
            Nav.NavigateTo("mashq/kartochka");
            return;
        }

        _message = result.Value?.Message ?? result.Error;
    }
}
