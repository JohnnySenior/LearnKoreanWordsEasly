@page "/grammatika"
@using Lugat.Contracts
@using Lugat.Domain.Grammar
@inject SessionService Api

<PageTitle>Grammatika — TOPIK yordamchi</PageTitle>

<header class="page-head">
    <div>
        <h1>Grammatika</h1>
        @if (_items is { Count: > 0 })
        {
            <span class="muted small-text">@_items.Count ta band · @_items.Count(i => i.Mastery == GrammarMastery.Independent) mustaqil · @_items.Count(i => i.Mastery == GrammarMastery.Practising) mashqda</span>
        }
    </div>
</header>

@if (_error is not null)
{
    <div class="notice" role="alert">@_error</div>
}

@if (_sets is not null && _items is { Count: > 0 })
{
    <section class="card sets">
        <div class="row-between">
            <span class="kicker">To‘plamlar</span>
            @if (_items.Any(i => i.Status == GrammarItemStatus.Approved && i.SetNumber is null))
            {
                <a class="button small" href="grammatika/toplam/yangi">+ Yangi to‘plam</a>
            }
        </div>
        @if (_sets.Count == 0)
        {
            <p class="muted small-text">O‘qituvchi bergan bandlarni to‘plamga yig‘ing: muddat qo‘ysangiz, dastur ularni kunlarga bo‘lib, Bugun sahifasida eslatadi.</p>
        }
        else
        {
            <nav class="menu compact">
                @foreach (var set in _sets)
                {
                    <a href="@($"grammatika/toplam/{set.Id}")">
                        <span>
                            <span class="t">@set.Number-to‘plam</span>
                            <span class="s">@set.Total band · @set.Started tasi mashqda · @set.Independent tasi mustaqil</span>
                            @if (set.DueDate is { } due)
                            {
                                <span class="aside @(set.Overdue ? "" : "done")">@Format.Date(due) · @Format.DueIn(due)</span>
                            }
                        </span>
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                    </a>
                }
            </nav>
        }
    </section>
}

@if (_items is null)
{
    @if (_error is null)
    {
        <p class="muted" style="margin-top:16px">Yuklanmoqda…</p>
    }
}
else if (_items.Count == 0)
{
    <section class="card">
        <p>Hali grammatika bandlari yo‘q.</p>
        <p class="muted small-text">Kitobni yuklang va grammatika ro‘yxati bor betlarni ajrating. Tasdiqlangan bandlar shu yerda chiqadi.</p>
        <a class="button primary" href="grammatika/kitob">Kitob va betlar</a>
    </section>
}
else
{
    <div class="search">
        <input class="input" type="search" placeholder="Qidirish: -(으)ㄹ수록 yoki “sabab”" aria-label="Grammatikani qidirish" @bind="_query" @bind:event="oninput" />
    </div>

    <div class="chips filter-row" role="group" aria-label="Holat bo‘yicha">
        @foreach (var (value, label) in Filters)
        {
            var v = value;
            <button class="chip wide @(_filter == v ? "selected" : "")" aria-pressed="@(_filter == v)" @onclick="() => _filter = v">@label (@Count(v))</button>
        }
    </div>

    @foreach (var group in Groups())
    {
        <h2 class="kicker section-title" lang="ko">@(group.Key ?? "Boshqa")</h2>
        <nav class="menu grammar-list" aria-label="@(group.Key ?? "Boshqa")">
            @foreach (var i in group)
            {
                <a href="@($"grammatika/band/{i.Id}")">
                    <span class="no">@(i.Number is { } n ? n.ToString("00") : "·")</span>
                    <span>
                        <span class="t" lang="ko">@i.Form</span>
                        <span class="s clamp">@i.MeaningUz</span>
                        @if (i.Status != GrammarItemStatus.Approved)
                        {
                            <span class="aside">@(i.Flagged ? "Tekshirish kerak" : "Hali tasdiqlanmagan")</span>
                        }
                        else if (i.Mastery == GrammarMastery.Independent)
                        {
                            <span class="aside strong">✓ Mustaqil qo‘llayapti</span>
                        }
                        else if (i.Mastery == GrammarMastery.Practising)
                        {
                            <span class="aside done">Mashq qilinyapti · @i.GoodDays/@GrammarProgress.RequiredGoodDays kun · @i.Sentences ta gap</span>
                        }
                        else if (i.Mastery == GrammarMastery.Seen)
                        {
                            <span class="aside done">Ko‘rib chiqildi</span>
                        }
                    </span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
                </a>
            }
        </nav>
    }

    @if (!Groups().Any())
    {
        <p class="muted" style="margin-top:16px">Bu tanlov bo‘yicha band topilmadi.</p>
    }
}

<nav class="menu compact" aria-label="Kitob" style="margin-top:24px">
    <a href="grammatika/kitob">
        <span><span class="t">Kitob va betlar</span><span class="s">PDF yuklash, yangi betlarni ajratish va tekshirish</span></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
    </a>
</nav>

@code {
    private List<GrammarListItemDto>? _items;
    private List<GrammarSetDto>? _sets;
    private string? _error;
    private string _query = "";
    private GrammarMastery? _filter;

    private static readonly (GrammarMastery? Value, string Label)[] Filters =
    [
        (null, "Hammasi"),
        (GrammarMastery.New, "Yangi"),
        (GrammarMastery.Seen, "Ko‘rilgan"),
        (GrammarMastery.Practising, "Mashqda"),
        (GrammarMastery.Independent, "Mustaqil"),
    ];

    private static bool Matches(GrammarListItemDto i, GrammarMastery? filter) => filter is null || i.Mastery == filter;

    private int Count(GrammarMastery? filter) => _items!.Count(i => Matches(i, filter));

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<List<GrammarListItemDto>>("api/grammar/items");
        _items = result.Value;
        _error = result.Ok ? null : result.Error;
        _sets = (await Api.GetAsync<List<GrammarSetDto>>("api/grammar/sets")).Value;
    }

    /// <summary>Book order is kept; sections appear in the order the book introduces them.</summary>
    private IEnumerable<IGrouping<string?, GrammarListItemDto>> Groups()
    {
        var q = _query.Trim();
        var items = _items!.Where(i => Matches(i, _filter));
        items = q.Length == 0
            ? items
            : items.Where(i => i.Form.Contains(q, StringComparison.OrdinalIgnoreCase) || i.MeaningUz.Contains(q, StringComparison.OrdinalIgnoreCase));
        return items.GroupBy(i => i.Section);
    }
}
