@page "/sinov/tarix"
@using System.Globalization
@using Lugat.Contracts
@using Lugat.Domain.Testing
@inject SessionService Api
@inject NavigationManager Nav

<PageTitle>Kitob testlari tarixi — TOPIK yordamchi</PageTitle>

<a class="back" href="sinov/kitob">← Kitob testlari</a>
<header class="page-head">
    <div>
        <h1>Kitob testlari tarixi</h1>
        <span class="muted small-text">Ball qayerda yo‘qolayotganini savol turlari bo‘yicha ko‘ring</span>
    </div>
</header>

@if (_error is not null)
{
    <div class="notice" role="alert">@_error</div>
}

@if (_history is null)
{
    @if (_error is null)
    {
        <p class="muted" style="margin-top:16px">Yuklanmoqda…</p>
    }
}
else if (_history.Runs.Count == 0)
{
    <section class="card">
        <p>Hali yakunlangan kitob testi yo‘q.</p>
        <p class="muted small-text">Kitobdagi testni yeching: natija shu yerda ball va savol turlari bo‘yicha chiqadi.</p>
        <a class="button primary" href="sinov/kitob">Kitob testlariga</a>
    </section>
}
else
{
    var exams = _history.Runs.Where(r => r.Exam).OrderBy(r => r.FinishedAt).ToList();
    var latest = exams.LastOrDefault();

    <section class="card" style="border-top:0">
        <span class="kicker">Imtihon rejimi · 100 ballik</span>
        @if (latest is null)
        {
            <p class="muted small-text">Hali imtihon rejimida (vaqt bilan) test yechilmagan. Grafik faqat shunday testlardan tuziladi, qisqa mashqlar pastdagi ro‘yxatda.</p>
        }
        else
        {
            <div class="countdown">
                <b>@latest.Score</b>
                <span>
                    oxirgi natija
                    @if (exams.Count > 1)
                    {
                        var delta = latest.Score - exams[^2].Score;
                        <text> · @(delta > 0 ? $"+{delta}" : delta.ToString(CultureInfo.InvariantCulture)) oldingisiga nisbatan</text>
                    }
                </span>
            </div>
            @if (exams.Count >= 2)
            {
                <ScoreChart Label="Imtihon rejimidagi natijalar grafigi"
                            Points="@exams.Select(r => new ScoreChart.ScorePoint(r.FinishedAt, r.Score, $"{Format.DayMonth(r.FinishedAt)}: {r.Score} / 100 ({r.Correct} / {r.Total})")).ToList()" />
            }
            else
            {
                <p class="muted small-text">Grafik ikkinchi imtihon rejimidagi testdan keyin chiqadi.</p>
            }
        }
    </section>

    @if (_history.Categories.Count > 0)
    {
        <h2 class="kicker section-title">Savol turlari bo‘yicha · eng zaifi tepada</h2>
        <ul class="cat-bars">
            @foreach (var c in _history.Categories)
            {
                var category = c.Category;
                <li>
                    <div class="row-between">
                        <span class="t">@c.Label</span>
                        <span class="v">@c.Percent% <span class="muted">· @c.Correct / @c.Total</span></span>
                    </div>
                    <div class="bar" role="img" aria-label="@($"{c.Label}: {c.Percent} foiz to‘g‘ri")"><div style="width:@(c.Percent)%"></div></div>
                    @if (c.Total < MinSample)
                    {
                        <span class="muted small-text">Kam savol, xulosa uchun erta</span>
                    }
                    @if (c.Available > 0 && c.Category != BookCategory.Other)
                    {
                        <button class="button small" disabled="@_busy" @onclick="() => PracticeAsync(category)">Shu turdagi @Math.Min(PracticeCount, c.Available) ta savolni ishlash</button>
                    }
                </li>
            }
        </ul>
        <p class="muted small-text">Tur kitobdagi ko‘rsatma va savol matnidan aniqlanadi (masalan “(    )에 들어갈 가장 알맞은 것”). Javobsiz qolgan savol xato hisoblanadi. Mashqda avval oldin xato qilingan savollar beriladi, vaqt cheklanmaydi.</p>
    }

    <h2 class="kicker section-title">Barcha testlar (@_history.Runs.Count)</h2>
    <nav class="menu compact">
        @foreach (var r in _history.Runs)
        {
            <a href="@($"sinov/{r.Id}")">
                <span>
                    <span class="t">@r.Title</span>
                    <span class="s">@Format.DayMonth(r.FinishedAt) · @r.Correct / @r.Total to‘g‘ri@(r.Exam ? $" · imtihon rejimi, {r.Minutes}/{r.TimeLimitMinutes} daq" : " · mashq")</span>
                    <span class="aside done">@r.Score / 100</span>
                </span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
            </a>
        }
    </nav>
}

@code {
    private const int MinSample = 5;
    private const int PracticeCount = 10;

    private BookHistoryDto? _history;
    private string? _error;
    private bool _busy;
    /// <summary>Kept only after a network error, so pressing again cannot make two tests (API01).</summary>
    private Guid? _pendingId;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<BookHistoryDto>("api/book-tests/history");
        _history = result.Value;
        _error = result.Ok ? null : result.Error;
    }

    private async Task PracticeAsync(BookCategory category)
    {
        _busy = true;
        _error = null;
        var id = _pendingId ??= Guid.NewGuid();
        var result = await Api.SendJsonAsync<TestDto>(HttpMethod.Post, "api/tests",
            new CreateTestRequest(id, null, null, false, PracticeCount, null, null, false, category));
        _busy = false;
        if (result.Value is { } test)
        {
            Nav.NavigateTo($"sinov/{test.Id}");
            return;
        }

        _pendingId = result.Status == 0 ? id : null;
        _error = result.Error;
    }
}
