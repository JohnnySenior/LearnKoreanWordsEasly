@page "/mashq/qollanish"
@using Lugat.Contracts
@inject SessionService Api
@inject NavigationManager Nav

<PageTitle>So‘z qo‘llanishi — Lug‘at</PageTitle>

@* "Which word is right?" (D-46): the Uzbek meaning of a word does not tell where the Korean word fits. *@
<a class="back" href="mashq">← Mashq</a>
<header class="page-head">
    <div>
        <h1>So‘z qo‘llanishi</h1>
        <span class="muted small-text">Qaysi so‘z to‘g‘ri? O‘zbekcha gapga mos koreyscha so‘zni tanlaysiz: <span lang="ko" style="white-space:nowrap">데려오다</span> yoki <span lang="ko" style="white-space:nowrap">가져오다</span>, <span lang="ko">입다</span> yoki <span lang="ko">신다</span>.</span>
    </div>
</header>

@if (_tables is null)
{
    <p class="muted">@(_error ?? "Yuklanmoqda…")</p>
    return;
}

@if (_error is not null)
{
    <div class="notice" role="alert">@_error</div>
}

@if (_tables.Count == 0)
{
    <p class="muted">Hali so‘z yo‘q.</p>
    return;
}

<section class="card">
    <span class="kicker">1. Jadvallarni tayyorlash</span>
    <p class="muted small-text">Har so‘z uchun AI bir marta qo‘llanish, o‘zbekcha tuzoq va savollarni tayyorlaydi. Natija saqlanadi, mashq paytida AI ishlatilmaydi. 25 so‘zlik bo‘lim taxminan 1–2 daqiqa tayyorlanadi.</p>
    <ul class="usage-tables">
        @foreach (var t in _tables)
        {
            var table = t;
            var ready = t.Ready == t.Total;
            <li>
                <button class="chip @(_chosen.Contains(t.UnitId) ? "selected" : "")" aria-pressed="@_chosen.Contains(t.UnitId)" disabled="@(t.Ready == 0)" @onclick="() => Toggle(table.UnitId)">@t.Unit</button>
                <span class="grow">
                    @if (ready)
                    {
                        <span>Tayyor · @t.Questions savol</span>
                    }
                    else if (_preparing == t.UnitId)
                    {
                        <span role="status">Tayyorlanmoqda: @t.Ready / @t.Total so‘z…</span>
                    }
                    else
                    {
                        <span class="muted">@t.Ready / @t.Total so‘z tayyor</span>
                    }
                </span>
                @if (!ready)
                {
                    <button class="button small" disabled="@(_preparing is not null)" @onclick="() => PrepareAsync(table)">Tayyorlash</button>
                }
                <a class="small-text" href="bolimlar/@t.UnitId">Ko‘rish</a>
            </li>
        }
    </ul>
</section>

<section class="card">
    <span class="kicker">2. Mashq</span>
    <div class="seg" role="radiogroup" aria-label="Savollar soni">
        @foreach (var n in Counts)
        {
            var count = n;
            <button class="@(_count == count ? "selected" : "")" role="radio" aria-checked="@(_count == count)" @onclick="() => _count = count">@count ta</button>
        }
    </div>
    <p class="muted small-text">@(_chosen.Count == 0 ? "Bo‘lim tanlanmagan: barcha tayyor bo‘limlardan" : $"{string.Join(", ", _tables!.Where(t => _chosen.Contains(t.UnitId)).Select(t => t.Unit))}-bo‘limdan") · javoblar oxirida izoh bilan ko‘rsatiladi · xatolar Xatolar daftariga tushadi</p>
    <button class="button primary block" disabled="@(_busy || _tables.All(t => t.Ready == 0))" @onclick="StartAsync">Boshlash</button>
</section>

@code {
    private static readonly int[] Counts = [10, 20, 30];

    private List<UsageTableSummaryDto>? _tables;
    private readonly HashSet<Guid> _chosen = [];
    private int _count = 10;
    private bool _busy;
    private string? _error;
    private Guid? _preparing;
    private Guid? _pendingId;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetAsync<List<UsageTableSummaryDto>>("api/vocabulary/usage");
        _tables = result.Value ?? [];
        _error = result.Ok ? null : result.Error;
    }

    private void Toggle(Guid table)
    {
        if (!_chosen.Remove(table))
        {
            _chosen.Add(table);
        }
    }

    /// <summary>One batch of words per request until the table is ready, so the page shows progress as it goes.</summary>
    private async Task PrepareAsync(UsageTableSummaryDto table)
    {
        _preparing = table.UnitId;
        _error = null;
        var url = $"api/vocabulary/units/{table.UnitId}/usage";
        var ready = table.Ready;
        while (true)
        {
            var result = await Api.SendJsonAsync<TableUsageDto>(HttpMethod.Post, url, null, SessionService.AiTimeout);
            if (result.Value is not { } usage)
            {
                _error = result.Error;
                break;
            }

            Replace(table, usage);
            StateHasChanged();
            if (usage.Ready >= usage.Total || usage.Ready == ready)
            {
                break; // done, or the AI could not add any word this round
            }

            ready = usage.Ready;
        }

        _preparing = null;
    }

    private void Replace(UsageTableSummaryDto table, TableUsageDto usage)
    {
        var i = _tables!.FindIndex(t => t.UnitId == table.UnitId);
        if (i >= 0)
        {
            _tables[i] = _tables[i] with { Ready = usage.Ready, Total = usage.Total, Questions = usage.Usages.Sum(u => u.Questions) };
        }
    }

    private async Task StartAsync()
    {
        _busy = true;
        _error = null;
        var id = _pendingId ??= Guid.NewGuid();
        var request = new CreateTestRequest(id, _chosen.Count == 0 ? null : _chosen.ToList(), _count, Usage: true);
        var result = await Api.SendJsonAsync<TestDto>(HttpMethod.Post, "api/tests", request);
        _busy = false;
        if (result.Value is { } test)
        {
            Nav.NavigateTo($"sinov/{test.Id}");
            return;
        }

        _pendingId = result.Status == 0 ? id : null;
        _error = result.Error;
    }
}
