@page "/"
@using Lugat.Contracts
@inject SessionService Api
@inject NavigationManager Nav

<PageTitle>Bugun — Koreyscha</PageTitle>

@* The home page (spec §4.6, §12.3; UI handoff 1b): today's review across all opened units, then the current unit
   with its four steps. *@
<AppHeader><Right>@Format.DayMonth(DateTimeOffset.UtcNow)</Right></AppHeader>

@if (_signIn is null || (_signIn.Status == SessionStatus.SignedIn && _today is null && _error is null))
{
    <section class="home-due" aria-busy="true">
        <span class="kicker accent">Bugun takrorlash</span>
        <span class="skeleton" style="width:120px;height:80px"></span>
        <span class="skeleton" style="width:220px;margin-top:12px"></span>
    </section>
}
else if (_signIn.Status != SessionStatus.SignedIn)
{
    <div class="notice" role="alert">@(_signIn.Message ?? "Kirish tasdiqlanmadi.")</div>
}
else if (_error is not null)
{
    <div class="notice" role="alert">@_error</div>
    <button class="btn btn-secondary block" @onclick="LoadAsync"><span>Qayta urinish</span></button>
}
else if (_today is not null)
{
    <section class="home-due">
        <span class="kicker accent">Bugun takrorlash</span>
        @if (_today.ActiveSession is { Current: not null } active)
        {
            <div class="home-due-figure">
                <b>@(active.Total - active.Position + 1)</b>
                <span>ta karta qoldi<br />~@Minutes(active.Total - active.Position + 1) daqiqa</span>
            </div>
            <p class="muted small-text">Boshlangan mashg‘ulot: @active.Position / @active.Total.</p>
            <a class="btn btn-primary block big" href="mashq/kartochka"><span>Davom etish</span><Icon Name="arrow-right" /></a>
            <button class="btn btn-ghost small" disabled="@_busy" @onclick="() => StartAsync(restart: true)">Yangidan boshlash</button>
        }
        else if (_today.DueNow > 0)
        {
            <div class="home-due-figure">
                <b>@_today.DueNow</b>
                <span>ta karta<br />~@Minutes(_today.DueNow) daqiqa</span>
            </div>
            <p class="muted small-text">Ochilgan bo‘limlardan muddati kelgan so‘zlar.</p>
            <button class="btn btn-primary block big" disabled="@_busy" @onclick="() => StartAsync(restart: false)"><span>Boshlash</span><Icon Name="arrow-right" /></button>
        }
        else
        {
            <h3 class="home-due-empty">Bugun takrorlash yo‘q</h3>
            <p class="muted small-text">@(_today.NewAvailable > 0
                ? $"Ochiq bo‘limlarda {_today.NewAvailable} ta yangi so‘z bor: jadvaldan boshlang."
                : "Takrorlash vaqti kelgan so‘zlar shu yerda chiqadi.")</p>
        }
        @if (_startMessage is not null)
        {
            <p role="status" class="small-text">@_startMessage</p>
        }
    </section>

    @if (_today.CurrentUnit is { } unit)
    {
        var step = StepOf(unit);
        <section class="home-unit">
            <div class="home-unit-head">
                <span class="kicker">Joriy bo‘lim</span>
                <span class="muted small-text">@unit.Started / @unit.WordCount</span>
            </div>
            <h3>@unit.Number-bo‘lim</h3>
            @if (unit.Themes.Count > 0)
            {
                <div class="tags">
                    @foreach (var theme in unit.Themes)
                    {
                        <Tag>@theme</Tag>
                    }
                </div>
            }
        </section>
        <UnitStepper Current="step" Done="UnitStepper.DoneOf(unit)" />
        <a class="btn btn-secondary block home-continue" href="@($"bolimlar/{unit.Id}?qadam={step}")">
            <span>Davom etish — @ContinueLabel(step)</span><Icon Name="arrow-right" />
        </a>
    }
    else
    {
        <section class="home-unit">
            <span class="kicker">Joriy bo‘lim</span>
            <p class="small-text">Hali ochiq bo‘lim yo‘q.</p>
            <a class="btn btn-secondary block" href="bolimlar"><span>Bo‘limlar</span><Icon Name="arrow-right" /></a>
        </section>
    }
}

@code {
    private SessionState? _signIn;
    private TodayDto? _today;
    // The home page has no time choice (UI handoff 1b): a review session of up to 20 minutes, as before by default.
    private const int SessionMinutes = 20;
    private string? _error;
    private string? _startMessage;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _signIn = await Api.EnsureSignedInAsync();
        if (_signIn.Status == SessionStatus.SignedIn)
        {
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        var today = await Api.GetAsync<TodayDto>("api/today");
        _error = today.Ok ? null : today.Error;
        _today = today.Value;
    }

    private int Minutes(int cards) => Math.Max(1, (int)Math.Round(cards * (_today?.SecondsPerCard ?? 10) / 60.0));

    // Where the learner is in the unit (spec §4.3): nothing started → the table, some cards → the cards, all → the test.
    // L-42: the step to continue with and the checks follow what the learner really did, not a guess from the cards.
    private static int StepOf(UnitSummaryDto unit) =>
        !unit.Opened ? 1 : unit.Started < unit.WordCount ? 2 : !unit.Practiced ? 3 : 4;

    private static string ContinueLabel(int step) => step switch
    {
        1 => "jadval",
        2 => "kartochka",
        3 => "mashq",
        _ => "test",
    };

    private async Task StartAsync(bool restart)
    {
        _busy = true;
        var result = await Api.SendJsonAsync<StartSessionResponse>(HttpMethod.Post, "api/sessions", new StartSessionRequest(SessionMinutes, restart));
        _busy = false;
        if (!result.Ok)
        {
            _startMessage = result.Error;
            return;
        }

        if (result.Value?.Session is null)
        {
            _startMessage = result.Value?.Message;
            return;
        }

        Nav.NavigateTo("mashq/kartochka");
    }
}
