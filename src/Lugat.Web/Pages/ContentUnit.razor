@page "/kontent/{Id:guid}"
@using Lugat.Contracts
@using Lugat.Domain.Catalog
@inject SessionService Api

<PageTitle>Bo‘lim kontenti — Koreyscha</PageTitle>

<a class="back" href="kontent">← Kontent</a>

@if (_unit is null)
{
    <p class="muted">@(_error ?? "Yuklanmoqda…")</p>
    return;
}

<header class="page-head">
    <div>
        <h1>@_unit.Unit.Level · @_unit.Unit.Number-bo‘lim</h1>
        <span class="muted small-text">@_unit.Unit.Words so‘z · @_unit.Unit.Drafted qoralama · @_unit.Unit.Reviewed tekshirilgan</span>
    </div>
    <span class="pill @(Published ? "pill-ok" : "pill-warn")">@(Published ? "Nashrda" : "Qoralama")</span>
</header>

@if (_error is not null)
{
    <div class="notice" role="alert">@_error</div>
}
@if (_status is not null)
{
    <p role="status">@_status</p>
}

<div class="actions">
    @if (Api.State.Me?.Roles.Contains(nameof(Lugat.Domain.Users.UserRoles.Admin)) == true)
    {
        <a class="button" href="@($"kontent/{Id}/tanishuv")">Tanishtirish darsi</a>
    }
    @if (NeedsPreparation)
    {
        <button class="button primary" disabled="@_busy" @onclick="PrepareAsync">Bo‘limni tayyorlash</button>
    }
    @if (_preparing)
    {
        <button class="button" disabled="@_stopPreparation" @onclick="() => _stopPreparation = true">@(_stopPreparation ? "To‘xtatilmoqda…" : "To‘xtatish")</button>
    }
    @if (!Published)
    {
        <button class="button" disabled="@(_busy || _unit.Unit.Reviewed < _unit.Unit.Words)" @onclick="PublishAsync">Nashr qilish</button>
    }
</div>
<p class="muted small-text">Yetishmayotgan qoralama, tuzoq va talaffuzlar birgalikda tayyorlanadi. Tayyor ma’lumot qayta yozilmaydi.</p>
<PronunciationReviewPanel WordUrlPrefix="api/admin/catalog/words" ShowDraftButton="false" Words="@PronunciationWords" Url="@($"api/admin/units/{Id}/pronunciations")" Disabled="_busy" Changed="RefreshPronunciationsAsync" BusyChanged="v => _busy = v" />
@if (_unit.HintsNeeded > 0)
{
    @* L-74: shared meanings without a hint, so the editor looks only at these. *@
    <div class="notice" role="status">
        <strong>Ishora kerak: @_unit.HintsNeeded so‘z.</strong> Ma’nosi boshqa so‘z bilan bir xil, farqi yozilmagan:
        @foreach (var w in _unit.Words.Where(w => w.SameMeaning is { Count: > 0 }))
        {
            <a class="hint-link" href="@($"kontent/{Id}#w-{w.Id}")" lang="ko">@w.Word</a>
        }
    </div>
}
<p class="muted small-text">
    AI qoralamasi 10 tadan so‘z yozadi; tekshiruvdan o‘tmagan javob saqlanmaydi. Har so‘zni o‘qib, tuzatib, «Tekshirildi» qiling.
    Barcha so‘z tekshirilgach bo‘limni nashr qilish mumkin; nashrdan keyin so‘zlar boshqa bo‘limga ko‘chmaydi.
</p>

@{
    var withNote = _unit.Words.Count(w => w.TrapUz is not null);
    var pending = _unit.Words.Where(w => w.TrapScenePending).ToList();
    var approved = _unit.Words.Count(w => w.TrapWrong is not null && !w.TrapScenePending);
    var none = _unit.Words.Count(w => w.TrapUz is not null && w.TrapWrong is null && w.TrapSceneAsked);
}
@* L-52: what the AI did with each trap note, and the drafts to confirm, in one place. *@
<section class="card scene-panel">
    <div class="row-between">
        <strong>Tuzoq sahnalari</strong>
        <span class="muted small-text">@withNote ta so‘zda tuzoq izohi bor</span>
    </div>
    <ul class="scene-counts">
        <li class="@(pending.Count > 0 ? "warn" : "")"><b>@pending.Count</b> tekshirish kutmoqda</li>
        <li><b>@approved</b> tasdiqlangan</li>
        <li><b>@none</b> AI xato topmadi</li>
        <li><b>@_unit.ScenesRemaining</b> hali so‘ralmagan</li>
    </ul>
    <p class="muted small-text">AI tuzoq izohidan «o‘zbek odatda shunday deydi → to‘g‘risi» juftini yozadi. Izohda chalkashlik bo‘lmasa, sahna yozmaydi va so‘z «AI xato topmadi» bo‘lib qoladi. Sahna siz tasdiqlaguningizcha o‘quvchiga ko‘rinmaydi; nashrni esa to‘xtatmaydi.</p>
    <div class="actions">
        @if (_unit.ScenesRemaining > 0)
        {
            <button class="button primary" disabled="@_busy" @onclick="DraftScenesAsync">AI’dan so‘rash (@_unit.ScenesRemaining so‘z)</button>
        }
        @if (none > 0)
        {
            <button class="button" disabled="@_busy" @onclick="RetryScenesAsync">Topilmaganlarni qayta so‘rash (@none)</button>
        }
        @if (approved + pending.Count + none > 0)
        {
            @if (_confirmRedo)
            {
                <button class="button" disabled="@_busy" @onclick="RedoScenesAsync">Ha, hammasini qayta yozdirish</button>
                <button class="link-btn muted" @onclick="() => _confirmRedo = false">Bekor</button>
                <p class="muted small-text">AI har bir sahnani aniq juft gap va bitta gaplik izoh bilan qaytadan yozadi. Yangi sahnalar siz tasdiqlaguningizcha o‘quvchilar oddiy tuzoq izohini ko‘radi.</p>
            }
            else
            {
                <button class="button" disabled="@_busy" @onclick="() => _confirmRedo = true">Barcha sahnalarni qayta yozdirish</button>
            }
        }
        @if (pending.Count > 0)
        {
            <button class="button @(_reviewScenes ? "selected" : "")" aria-pressed="@_reviewScenes" @onclick="() => _reviewScenes = !_reviewScenes">Tekshirish (@pending.Count)</button>
        }
    </div>
    @if (_reviewScenes && pending.Count > 0)
    {
        <ul class="scene-review">
            @foreach (var w in pending)
            {
                var word = w;
                <li>
                    <div class="row-between"><span><strong class="ko" lang="ko">@w.Word</strong> — @w.TranslationUz</span><span class="pill pill-warn">AI qoralamasi</span></div>
                    <p class="muted small-text">Izoh: @w.TrapUz</p>
                    <div class="scene-preview">
                        @if (w.TrapCue is not null)
                        {
                            <span class="small-text">@w.TrapCue</span>
                        }
                        <span lang="ko"><s>@w.TrapWrong</s> ✗ → <strong>@w.TrapRight</strong> ✓</span>
                        @if (w.TrapWhy is not null)
                        {
                            <span class="small-text">@w.TrapWhy</span>
                        }
                    </div>
                    <div class="actions">
                        <button class="button small primary" disabled="@_busy" @onclick="() => ApproveSceneAsync(word)">Tasdiqlash</button>
                        <a class="button small" href="@($"kontent/{Id}#w-{word.Id}")">Tahrirlash</a>
                        <button class="button small" disabled="@_busy" @onclick="() => RejectSceneAsync(word)">Olib tashlash</button>
                    </div>
                    @if (_wordErrors.GetValueOrDefault(word.Id) is { } sceneError)
                    {
                        <div class="notice" role="alert">@sceneError</div>
                    }
                </li>
            }
        </ul>
        <button class="button primary block" disabled="@_busy" @onclick="ApproveAllScenesAsync">Hammasini tasdiqlash (@pending.Count)</button>
        <p class="muted small-text">Har birini o‘qib chiqqaningizdan keyin bosing.</p>
    }
</section>

<fieldset class="preparation-words" disabled="@_busy">
@foreach (var w in _unit.Words)
{
    var word = w;
    var edit = _edits[word.Id];
    <section class="card" id="@($"w-{word.Id}")">
        <div class="row-between">
            <span><span class="muted small-text">@word.Order.</span> <strong class="ko" lang="ko">@word.Word</strong><sup class="muted">@word.Homonym</sup>
                <span class="muted small-text">@word.PosUz @(word.FreqRank is { } rank ? $"· №{rank}" : "· ro‘yxatda o‘rni yo‘q")@(word.Gloss is null ? "" : $" · {word.Gloss}")</span></span>
            <span class="pills">
                @if (SceneLabel(word) is { } scene)
                {
                    <span class="pill @scene.Css">@scene.Text</span>
                }
                @if (word.SameMeaning is { Count: > 0 })
                {
                    <span class="pill pill-warn">Ishora kerak</span>
                }
                <span class="pill @(word.Status == CatalogWordStatus.Reviewed ? "pill-ok" : "pill-warn")">@(word.Status == CatalogWordStatus.Reviewed ? "Tekshirildi" : "Qoralama")</span>
            </span>
        </div>
        <label class="field">Tarjima (1–3 ma’no, «;» bilan)<input class="input" maxlength="300" @bind="edit.TranslationUz" /></label>
        @if (word.SameMeaning is { Count: > 0 } same)
        {
            @* L-37, L-74: asked from Uzbek, both words are right; a hint in parentheses after the shared meaning tells them apart. *@
            <p class="notice small-text">⚠ Ishora kerak: bu ma’no <span lang="ko">@string.Join(", ", same)</span> so‘zida ham bor. Shu ma’nodan keyin qavsda farqini yozing, masalan «juda (ijobiy: juda yaxshi)». Ishora bo‘lmasa, ilova o‘zi «@string.Join(", ", same) emas» deb ko‘rsatadi.</p>
        }
        <PronunciationEditor @key="word.Id" Url="@($"api/admin/catalog/words/{word.Id}/pronunciation")" Review="word.PronunciationReview" Changed="r => PronunciationChanged(word.Id, r)" />
        <label class="field">Lotincha o‘qilishi<input class="input" maxlength="100" @bind="edit.Romanization" /></label>
        <label class="field">Misol (koreyscha, ≤ 8 so‘z)<input class="input" lang="ko" maxlength="200" @bind="edit.ExampleKo" /></label>
        <label class="field">Misol tarjimasi<input class="input" maxlength="300" @bind="edit.ExampleUz" /></label>
        <label class="field">Tuzoq (bo‘lmasa bo‘sh qoldiring)<textarea class="input" maxlength="1000" @bind="edit.TrapUz"></textarea></label>
        <fieldset class="scene-fields">
            <legend>Tuzoq sahnasi
                @if (word.TrapScenePending)
                {
                    <span class="pill pill-warn">AI qoralamasi — tekshiring</span>
                }
            </legend>
            <label class="field">Vaziyat (ixtiyoriy, masalan «Ishga boraman» deyishda:)<input class="input" maxlength="120" @bind="edit.TrapCue" /></label>
            <label class="field">Xato (o‘zbek odatda shunday deydi)<input class="input" lang="ko" maxlength="60" @bind="edit.TrapWrong" /></label>
            <label class="field">To‘g‘ri<input class="input" lang="ko" maxlength="60" @bind="edit.TrapRight" /></label>
            <label class="field">Qisqa izoh (bitta gap: nimasi xato, nima deyiladi)<input class="input" maxlength="160" @bind="edit.TrapWhy" /></label>
            <p class="muted small-text">Ikkalasi bo‘sh bo‘lsa, kartochkada tuzoq oddiy matn bo‘lib chiqadi. Saqlash sahnani ham tasdiqlaydi.</p>
            @if (word.TrapScenePending)
            {
                <button class="button small" disabled="@_busy" @onclick="() => ApproveSceneAsync(word)">Sahnani shundayicha tasdiqlash</button>
            }
        </fieldset>
        <label class="field">Mavzu<input class="input" maxlength="40" @bind="edit.Theme" /></label>
        @if (edit.Questions.Count > 0)
        {
            <span class="kicker">«Qaysi so‘z to‘g‘ri?» savollari</span>
            <ul class="plain-list small-text">
                @foreach (var q in edit.Questions.ToList())
                {
                    var question = q;
                    <li>
                        <div>@q.Uzbek</div>
                        <div lang="ko">@q.Sentence — <strong>@q.Answer</strong> <span class="muted">(noto‘g‘ri: @string.Join(", ", q.Wrong))</span></div>
                        <div class="muted">@q.ExplanationUz</div>
                        <button class="link-btn muted" @onclick="() => edit.Questions.Remove(question)">Savolni olib tashlash</button>
                    </li>
                }
            </ul>
        }
        <p class="muted small-text">
            @(word.AiProvider is null ? "" : $"Qoralama: {word.AiProvider}. ")@(word.ReviewedBy is null ? "" : $"Tekshirdi: {word.ReviewedBy}.")
        </p>
        <div class="actions">
            @if (word.Status == CatalogWordStatus.Reviewed)
            {
                <button class="button primary" disabled="@_busy" @onclick="() => SaveAsync(word, review: false)">Saqlash</button>
            }
            else
            {
                <button class="button" disabled="@_busy" @onclick="() => SaveAsync(word, review: false)">Saqlash</button>
                <button class="button primary" disabled="@_busy" @onclick="() => SaveAsync(word, review: true)">Saqlash va «Tekshirildi»</button>
            }
        </div>
        @if (_wordErrors.GetValueOrDefault(word.Id) is { } wordError)
        {
            <div class="notice" role="alert">@wordError</div>
        }
    </section>
}

</fieldset>

@code {
    [Parameter] public Guid Id { get; set; }

    private sealed class Edit
    {
        public string? TranslationUz { get; set; }
        public string? Romanization { get; set; }
        public string? ExampleKo { get; set; }
        public string? ExampleUz { get; set; }
        public string? TrapUz { get; set; }
        public string? TrapCue { get; set; }
        public string? TrapWrong { get; set; }
        public string? TrapRight { get; set; }
        public string? TrapWhy { get; set; }
        public string? Theme { get; set; }
        public List<CatalogQuestionDto> Questions { get; set; } = [];
    }

    private UnitAdminDto? _unit;
    private bool _reviewScenes;
    private bool _confirmRedo;

    /// <summary>The trap scene's state on the word card (L-52); null when the word has no trap note.</summary>
    private static (string Text, string Css)? SceneLabel(CatalogWordAdminDto w) =>
        w.TrapScenePending ? ("Sahna: AI qoralamasi", "pill-warn")
        : w.TrapWrong is not null ? ("Sahna ✓", "pill-ok")
        : w.TrapUz is null ? null
        : w.TrapSceneAsked ? ("Sahna: AI topmadi", "")
        : ("Sahna: so‘ralmagan", "");
    private readonly Dictionary<Guid, Edit> _edits = [];
    private readonly Dictionary<Guid, string> _wordErrors = [];
    private string? _error;
    private string? _status;
    private bool _busy;

    private bool Published => _unit?.Unit.Status == UnitStatus.Published;

    protected override async Task OnParametersSetAsync()
    {
        var result = await Api.GetAsync<UnitAdminDto>($"api/admin/units/{Id}");
        _error = result.Error;
        if (result.Value is { } unit)
        {
            Show(unit);
        }
    }

    private void Show(UnitAdminDto unit)
    {
        _unit = unit;
        foreach (var w in unit.Words)
        {
            Replace(w);
        }
    }

    /// <summary>Takes the server's copy of a word; unsaved typing in other words stays.</summary>
    private void Replace(CatalogWordAdminDto w) => _edits[w.Id] = new Edit
    {
        TranslationUz = w.TranslationUz,
        Romanization = w.Romanization,
        ExampleKo = w.ExampleKo,
        ExampleUz = w.ExampleUz,
        TrapUz = w.TrapUz,
        TrapCue = w.TrapCue,
        TrapWrong = w.TrapWrong,
        TrapRight = w.TrapRight,
        TrapWhy = w.TrapWhy,
        Theme = w.Theme,
        Questions = w.Questions.ToList(),
    };

    private bool _preparing, _stopPreparation;
    private bool NeedsPreparation => _unit is not null && (_unit.Remaining > 0 || _unit.ScenesRemaining > 0 || _unit.Words.Any(w =>
        w.PronunciationReview is null || w.PronunciationReview is { Reviewed: false, Reading: null, AskedAt: null }));
    private IReadOnlyList<PronunciationReviewPanel.Word> PronunciationWords => _unit?.Words
        .Select(w => new PronunciationReviewPanel.Word(w.Id, w.Word, w.TranslationUz, w.PronunciationReview)).ToList() ?? [];

    private async Task PrepareAsync()
    {
        (_busy, _preparing, _stopPreparation, _error) = (true, true, false, null);
        _status = "Bo‘lim tayyorlanmoqda…";
        while (!_stopPreparation)
        {
            StateHasChanged();
            var result = await Api.SendJsonAsync<UnitPreparationDto>(HttpMethod.Post, $"api/admin/units/{Id}/prepare", timeout: TimeSpan.FromMinutes(3));
            if (result.Value is not { } prepared) { _error = result.Error; break; }
            Show(prepared.Unit);
            _status = $"{prepared.Step} saqlandi. Davom etmoqda…";
            if (prepared.Done) break;
        }
        _status = _error is not null ? null : _stopPreparation ? "To‘xtatildi. Tayyor qoralamalar saqlangan; keyin davom ettirishingiz mumkin." : "Bo‘lim tayyor. Takliflarni tekshirib, tasdiqlang.";
        (_busy, _preparing) = (false, false);
    }

    private async Task RefreshPronunciationsAsync()
    {
        var result = await Api.GetAsync<UnitAdminDto>($"api/admin/units/{Id}");
        if (result.Value is { } unit)
        {
            // Preserve unsaved typing when only pronunciation metadata changed.
            foreach (var w in unit.Words)
            {
                var old = _unit?.Words.FirstOrDefault(v => v.Id == w.Id);
                if (old is null || old.TranslationUz != w.TranslationUz || old.Romanization != w.Romanization || old.ExampleKo != w.ExampleKo
                    || old.ExampleUz != w.ExampleUz || old.TrapUz != w.TrapUz || old.TrapCue != w.TrapCue || old.TrapWrong != w.TrapWrong
                    || old.TrapRight != w.TrapRight || old.TrapWhy != w.TrapWhy || old.Theme != w.Theme
                    || System.Text.Json.JsonSerializer.Serialize(old.Questions) != System.Text.Json.JsonSerializer.Serialize(w.Questions)) Replace(w);
            }
            _unit = unit;
        }
        else _error = result.Error;
    }

    private void PronunciationChanged(Guid wordId, PronunciationReviewDto review)
    {
        if (_unit is not null) _unit = _unit with { Words = _unit.Words.Select(w => w.Id == wordId ? w with { Version = review.Version, PronunciationReview = review } : w).ToList() };
    }

    private async Task SaveAsync(CatalogWordAdminDto word, bool review)
    {
        _busy = true;
        _wordErrors.Remove(word.Id);
        var edit = _edits[word.Id];
        var saved = await Api.SendJsonAsync<CatalogWordAdminDto>(HttpMethod.Put, $"api/admin/catalog/words/{word.Id}", new UpdateCatalogWordRequest(
            edit.TranslationUz, edit.Romanization, edit.ExampleKo, edit.ExampleUz, edit.TrapUz, edit.Theme, edit.Questions, word.Version,
            edit.TrapCue, edit.TrapWrong, edit.TrapRight, edit.TrapWhy));
        var current = saved.Value;
        if (current is not null && review && current.Status != CatalogWordStatus.Reviewed)
        {
            var reviewed = await Api.SendJsonAsync<CatalogWordAdminDto>(HttpMethod.Post, $"api/admin/catalog/words/{word.Id}/review", new ReviewCatalogWordRequest(current.Version));
            current = reviewed.Value ?? current;
            if (reviewed.Error is { } e)
            {
                _wordErrors[word.Id] = e;
            }
        }

        if (saved.Error is { } error)
        {
            _wordErrors[word.Id] = error;
        }

        Apply(current);
        _busy = false;
    }

    private async Task ApproveSceneAsync(CatalogWordAdminDto word)
    {
        _busy = true;
        _wordErrors.Remove(word.Id);
        var result = await Api.SendJsonAsync<CatalogWordAdminDto>(HttpMethod.Post, $"api/admin/catalog/words/{word.Id}/trap-scene/approve", new ReviewCatalogWordRequest(word.Version));
        if (result.Error is { } error)
        {
            _wordErrors[word.Id] = error;
        }

        Apply(result.Value);
        _busy = false;
    }

    /// <summary>One AI call per 10 words with a trap note, until none is left; each draft waits for an editor (L-52).</summary>
    private async Task DraftScenesAsync()
    {
        _busy = true;
        _error = null;
        while (_unit is { ScenesRemaining: > 0 })
        {
            _status = $"AI tuzoq sahnalarini yozmoqda… qoldi: {_unit.ScenesRemaining} so‘z";
            StateHasChanged();
            var before = _unit.ScenesRemaining;
            var result = await Api.SendJsonAsync<UnitAdminDto>(HttpMethod.Post, $"api/admin/units/{Id}/trap-scenes", timeout: TimeSpan.FromMinutes(3));
            if (result.Value is not { } unit)
            {
                _error = result.Error;
                break;
            }

            Show(unit);
            if (unit.ScenesRemaining >= before)
            {
                _error = "AI javob bermadi. Keyinroq qayta urinib ko‘ring.";
                break;
            }
        }

        var pending = _unit?.Words.Count(w => w.TrapScenePending) ?? 0;
        var none = _unit?.Words.Count(w => w.TrapUz is not null && w.TrapWrong is null && w.TrapSceneAsked) ?? 0;
        _status = _error is null ? $"AI ko‘rib chiqdi: {pending} ta sahna yozdi (tekshirishni kutmoqda), {none} tasida xato topmadi." : null;
        _reviewScenes = pending > 0;
        _busy = false;
    }

    private async Task ApproveAllScenesAsync()
    {
        _busy = true;
        var result = await Api.SendJsonAsync<UnitAdminDto>(HttpMethod.Post, $"api/admin/units/{Id}/trap-scenes/approve");
        _error = result.Error;
        if (result.Value is { } unit)
        {
            Show(unit);
            _status = "Sahnalar tasdiqlandi: endi o‘quvchilar kartochkada ko‘radi.";
            _reviewScenes = false;
        }

        _busy = false;
    }

    private async Task RejectSceneAsync(CatalogWordAdminDto word)
    {
        _busy = true;
        _wordErrors.Remove(word.Id);
        var result = await Api.SendJsonAsync<CatalogWordAdminDto>(HttpMethod.Post, $"api/admin/catalog/words/{word.Id}/trap-scene/reject", new ReviewCatalogWordRequest(word.Version));
        if (result.Error is { } error)
        {
            _wordErrors[word.Id] = error;
        }

        Apply(result.Value);
        _busy = false;
    }

    /// <summary>L-83: every scene of the unit again under the clearer rules; the drafts then wait for review.</summary>
    private async Task RedoScenesAsync()
    {
        (_busy, _confirmRedo) = (true, false);
        var result = await Api.SendJsonAsync<UnitAdminDto>(HttpMethod.Post, $"api/admin/units/{Id}/trap-scenes/redo");
        _error = result.Error;
        if (result.Value is { } unit)
        {
            Show(unit);
            await DraftScenesAsync();
        }

        _busy = false;
    }

    /// <summary>Lets the AI look again at the words it found nothing for, then asks it (L-52).</summary>
    private async Task RetryScenesAsync()
    {
        _busy = true;
        var result = await Api.SendJsonAsync<UnitAdminDto>(HttpMethod.Post, $"api/admin/units/{Id}/trap-scenes/retry");
        _error = result.Error;
        if (result.Value is { } unit)
        {
            Show(unit);
            await DraftScenesAsync();
        }

        _busy = false;
    }

    private void Apply(CatalogWordAdminDto? current)
    {
        if (current is not null && _unit is { } unit)
        {
            var words = unit.Words.Select(w => w.Id == current.Id ? current : w).ToList();
            _unit = unit with
            {
                Words = words,
                Unit = unit.Unit with { Reviewed = words.Count(w => w.Status == CatalogWordStatus.Reviewed), Drafted = words.Count(w => w.TranslationUz is not null) },
            };
            Replace(current);
        }
    }

    private async Task PublishAsync()
    {
        _busy = true;
        var result = await Api.SendJsonAsync<UnitAdminSummaryDto>(HttpMethod.Post, $"api/admin/units/{Id}/publish");
        _error = result.Error;
        if (result.Value is { } summary && _unit is not null)
        {
            _unit = _unit with { Unit = summary };
            _status = "Bo‘lim nashr qilindi: endi o‘quvchilarga ko‘rinadi.";
        }

        _busy = false;
    }
}
