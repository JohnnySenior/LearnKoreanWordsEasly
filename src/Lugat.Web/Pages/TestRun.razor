@page "/sinov/{Id:guid}"
@using Lugat.Contracts
@using Lugat.Domain.Testing
@inject SessionService Api
@inject NavigationManager Nav

<PageTitle>Sinov — Koreyscha</PageTitle>

@if (_test is null)
{
    <a class="back" href="@Back">← Orqaga</a>
    <p class="muted">@(_error ?? "Yuklanmoqda…")</p>
    return;
}

@if (_test.Status == TestRunStatus.Finished && _test.Unit is { } result)
{
    @* UI handoff 1g: score and percent side by side, a calm line, the wrong answers, then what to do next. *@
    var counted = _test.Questions.Count(q => !q.Technical);
    var percent = counted == 0 ? 0 : (_test.Score ?? 0) * 100 / counted;
    var wrongs = _test.Questions.Where(q => q.IsCorrect != true && !q.Technical).ToList();
    <AppHeader Title="@_test.Title" Close="@Back" />
    <div class="result-figures @(result.Passed == true ? "passed" : "failed")">
        <div><span class="kicker">To‘g‘ri</span><b>@_test.Score<small>/@counted</small></b></div>
        <div class="result-score"><span class="kicker">Ball</span><b>@percent%</b></div>
    </div>
    <section class="result-text">
        @if (result.Passed == true)
        {
            <h4>@(result.NextUnitId is null ? "Bo‘lim tugadi." : "Bo‘lim tugadi. Keyingi bo‘lim ochildi.")</h4>
            <p class="muted small-text">@_test.Score ta to‘g‘ri javob, o‘tish uchun @result.PassMark ta kerak edi.@(result.Purpose == TestPurpose.UnitSkip ? " Bu bo‘lim so‘zlari takrorlashga qo‘shildi." : "")</p>
        }
        else
        {
            <h4>Hali emas — @result.PassMark ta kerak edi</h4>
            <p class="muted small-text">@_test.Score ta to‘g‘ri javob.@(result.Purpose == TestPurpose.UnitSkip ? " Bo‘lim qulflangan qoladi: avval oldingi bo‘limni tugating." : " Xato so‘zlarni takrorlab, testni qayta topshiring.")</p>
        }
        @if (_test.Warning is not null)
        {
            <p class="muted small-text">@_test.Warning</p>
        }
    </section>

    @if (wrongs.Count > 0)
    {
        <SectionLabel Text="@($"Xato javoblar · {wrongs.Count}")" />
        <div class="wrong-list">
            @foreach (var q in wrongs)
            {
                var korean = q.Kind is TestQuestionKind.WordMeaning ? q.Prompt : q.Correct;
                var meaning = q.Kind is TestQuestionKind.WordMeaning ? q.Correct : q.Kind is TestQuestionKind.WordListening ? q.Translation : q.Prompt;
                <div class="wrong-row">
                    <span class="ko" lang="ko">@korean</span>
                    <span>
                        <b>@meaning</b>
                        @if (string.IsNullOrEmpty(q.Given))
                        {
                            <span class="muted small-text">javob berilmadi</span>
                        }
                        else
                        {
                            <s class="muted" lang="@(q.Kind is TestQuestionKind.WordMeaning ? null : "ko")">@q.Given</s>
                        }
                    </span>
                </div>
            }
        </div>
    }

    @if (_error is not null)
    {
        <div class="notice" role="alert">@_error</div>
    }

    <div class="result-actions">
        @if (result.Passed == true)
        {
            @if (result.NextUnitId is { } next)
            {
                <a class="btn btn-primary block big" href="@($"bolimlar/{next}")"><span>Keyingi bo‘limni boshlash</span><Icon Name="arrow-right" /></a>
            }
            else
            {
                <a class="btn btn-primary block big" href="bolimlar"><span>Bo‘limlarga qaytish</span><Icon Name="arrow-right" /></a>
            }
            @if (result.WrongItemIds.Count > 0)
            {
                <button class="btn btn-secondary block" disabled="@_busy" @onclick="() => DrillWrongAsync(result.WrongItemIds)"><span>Xato @result.WrongItemIds.Count ta so‘zni takrorlash</span></button>
            }
        }
        else
        {
            @if (result.WrongItemIds.Count > 0)
            {
                <button class="btn btn-primary block big" disabled="@_busy" @onclick="() => DrillWrongAsync(result.WrongItemIds)"><span>Xato so‘zlarni takrorlash</span><Icon Name="arrow-right" /></button>
            }
            <button class="btn btn-secondary block" disabled="@_busy" @onclick="() => RetakeAsync(result)"><span>Testni qayta topshirish</span></button>
        }
    </div>
    return;
}

@if (_test.Status == TestRunStatus.Finished)
{
    <a class="back" href="@Back">@(_test.Unit is null ? "← Sinov" : "← Bo‘lim")</a>
    <header class="page-head">
        <div>
            <span class="kicker">@_test.Title</span>
            <h1>Natija</h1>
        </div>
    </header>

    <section class="card" style="border-top:0">
        <div class="big-number">@_test.Score<small> / @(_test.Questions.Count - _test.Questions.Count(q => q.Technical))</small></div>
        <dl class="facts stats" style="margin-top:12px">
            @foreach (var k in _test.ByKind)
            {
                <dt>@KindLabel(k.Kind)</dt><dd>@k.Correct / @k.Total</dd>
            }
        </dl>
        @if (IsOral)
        {
            var said = _test.Questions.Where(q => q.Kind == TestQuestionKind.OralKorean).ToList();
            var meant = _test.Questions.Where(q => q.Kind == TestQuestionKind.OralMeaning).ToList();
            <dl class="facts stats oral-summary">
                <dt>Yordam bilan</dt><dd>@_test.Questions.Count(q => q.Assisted && q.IsCorrect == true)</dd>
                <dt>Qiyin (yaqin eshitildi)</dt><dd>@_test.Questions.Count(q => q.Hard)</dd>
                <dt>Texnik xato</dt><dd>@_test.Questions.Count(q => q.Technical)</dd>
            </dl>
            <p class="muted small-text" style="margin-top:10px">Qamrov: @said.Count ta so‘z koreyschasini aytish, @meant.Count ta so‘z ma’nosini aytish yo‘nalishida tekshirildi. Har so‘z bitta yo‘nalishda so‘raldi, ikkalasida emas. Ma’nosini aytish natijasi o‘zingizning bahoyingiz. Texnik xatolar xato hisoblanmaydi, lekin to‘g‘riga ham qo‘shilmaydi. Sinov kartochkalar jadvalini o‘zgartirmaydi.</p>
        }
        @if (_test.Questions.Any(q => q.AiMade))
        {
            <p class="muted small-text" style="margin-top:10px">Gapli savollarni @(_test.Provider ?? "AI") yozgan: bu TOPIK uslubidagi mashq, rasmiy test emas.</p>
        }
        @if (_test.Warning is not null)
        {
            <p class="muted small-text" style="margin-top:10px">@_test.Warning</p>
        }
    </section>

    @if (_test.Unit is { } unit)
    {
        @* The unit's result (spec §4.4, §4.5); decided by the server. A calm note, no confetti. *@
        <section class="card unit-result">
            @if (unit.Passed == true)
            {
                <h2>Bo‘lim tugallandi</h2>
                <p>@_test.Score ta to‘g‘ri javob (o‘tish uchun @unit.PassMark ta kerak edi).@(unit.Purpose == TestPurpose.UnitSkip ? " Bu bo‘lim so‘zlari takrorlashga qo‘shildi." : "")</p>
                @if (unit.NextUnitId is { } next)
                {
                    <a class="button primary block" href="@($"bolimlar/{next}")">Keyingi bo‘limga o‘tish →</a>
                }
                else
                {
                    <a class="button primary block" href="bolimlar">Bo‘limlarga qaytish</a>
                }
            }
            else
            {
                <h2>Hali o‘tilmadi</h2>
                <p>@_test.Score ta to‘g‘ri javob, o‘tish uchun @unit.PassMark ta kerak.@(unit.Purpose == TestPurpose.UnitSkip ? " Bo‘lim qulflangan qoladi: avval oldingi bo‘limni tugating." : "")</p>
                @if (unit.Purpose == TestPurpose.UnitFinal && unit.WrongItemIds.Count > 0)
                {
                    <button class="button primary block" disabled="@_busy" @onclick="() => DrillWrongAsync(unit.WrongItemIds)">Xato qilgan @unit.WrongItemIds.Count ta so‘zni takrorlash</button>
                }
                <button class="button block" disabled="@_busy" @onclick="() => RetakeAsync(unit)">Testni qayta topshirish</button>
            }
        </section>
    }

    @if (_test.Questions.Where(q => q.IsCorrect != true).ToList() is { Count: > 0 } wrong)
    {
        <h2 class="kicker section-title">Xatolar (@wrong.Count)</h2>
        <ol class="mistakes">
            @foreach (var q in wrong)
            {
                @if (q.Kind is TestQuestionKind.OralKorean or TestQuestionKind.OralMeaning)
                {
                    var korean = q.Kind == TestQuestionKind.OralKorean ? q.Correct! : q.Prompt;
                    var uzbek = q.Kind == TestQuestionKind.OralKorean ? q.Prompt : q.Translation;
                    <li>
                        <span class="kicker">@KindLabel(q.Kind)</span>
                        <p><strong class="sentence" lang="ko">@korean</strong> — @uzbek</p>
                        @if (q.Kind == TestQuestionKind.OralKorean && !string.IsNullOrEmpty(q.Given))
                        {
                            <p><span class="muted">Eshitildi:</span> <span lang="ko">@q.Given</span>@(q.PronScore is { } ps ? $" · talaffuz {Math.Round(ps)}" : "")</p>
                        }
                        @if (q.Note is not null)
                        {
                            <p class="muted small-text">@q.Note</p>
                        }
                    </li>
                    continue;
                }
                <li>
                    <span class="kicker">@KindLabel(q.Kind)</span>
                    @if (q.Sentence is not null)
                    {
                        <p class="sentence" lang="ko">@Filled(q)</p>
                        @if (q.Translation is not null)
                        {
                            <p class="muted">@q.Translation</p>
                        }
                    }
                    else if (q.Kind == TestQuestionKind.WordListening)
                    {
                        <p><strong lang="ko">@q.Correct</strong> — @q.Translation</p>
                    }
                    else
                    {
                        <p class="@(IsKoreanPrompt(q.Kind) ? "ko" : "")" lang="@(IsKoreanPrompt(q.Kind) ? "ko" : null)"><strong>@q.Prompt</strong></p>
                    }
                    <p>
                        <span class="muted">Siz:</span> <span lang="ko">@(string.IsNullOrEmpty(q.Given) ? "—" : q.Given)</span><br />
                        <span class="muted">To‘g‘ri:</span> <strong lang="ko">@q.Correct</strong>
                    </p>
                    @if (q.Note is not null)
                    {
                        <p class="muted small-text">@q.Note</p>
                    }
                    @if (q.Explanation is not null)
                    {
                        <p class="small-text">@q.Explanation</p>
                    }
                    @if (_reported.Contains(q.Index))
                    {
                        <p class="muted small-text" role="status">Yuborildi. Admin tekshiradi; shu vaqtgacha bu savol qayta berilmaydi.</p>
                    }
                    else
                    {
                        @* Two options that both fit, a wrong "right" answer (L-37). *@
                        <button class="button small" disabled="@_busy" @onclick="() => ReportAsync(q.Index)">Bu savolda xato bor</button>
                    }
                </li>
            }
        </ol>
        @if (_test.Unit is null)
        {
            <button class="button primary block" disabled="@_busy" @onclick="RetryMistakesAsync">Xatolarni qayta ishlash</button>
        }
    }
    else
    {
        <p style="margin-top:12px"><strong>Hammasi to‘g‘ri!</strong></p>
    }

    @if (_test.Questions.Where(q => q.IsCorrect == true && q.Note is not null).ToList() is { Count: > 0 } notes)
    {
        <h2 class="kicker section-title">E’tibor bering</h2>
        <ul class="plain-list">
            @foreach (var q in notes)
            {
                <li><span lang="ko">@q.Given</span> — @q.Note</li>
            }
        </ul>
    }

    @if (_test.Unit is null)
    {
        <a class="button block" href="sinov" style="margin-top:12px">Yangi sinov</a>
    }
    return;
}

@{
    var question = _test.Questions[_position];
}

@* UI handoff 1f: X, the title, "14 / 25"; one segment per question (answered ink, current red, the rest grey). *@
<div class="session-bar">
    <a class="close" href="@Back" aria-label="Sinovdan chiqish (javoblar saqlanadi)"><Icon Name="x" Size="22" /></a>
    <span class="session-title">@_test.Title</span>
    <span class="count">@(_position + 1) / @_test.Questions.Count</span>
</div>
<div class="test-segments" role="progressbar" aria-valuemin="0" aria-valuemax="@_test.Questions.Count" aria-valuenow="@_test.Answered">
    @foreach (var q in _test.Questions)
    {
        <span class="@(q.Index == _position ? "current" : q.Given is not null || q.Technical ? "done" : "")"></span>
    }
</div>

@if (question.Kind == TestQuestionKind.OralKorean)
{
    <section class="test-question" aria-live="polite">
        <div class="tags"><span class="pill">@KindLabel(question.Kind)</span></div>
        <span class="kicker">Koreyschasini ovoz chiqarib ayting</span>
        <p class="prompt">@question.Prompt</p>
        <OralAnswer TestId="Id" Question="question" Disabled="_busy" OnAnswered="OralAnsweredAsync" />
        @if (question.Given is not null || question.Technical)
        {
            <button class="button block" style="margin-top:12px" @onclick="NextUnanswered">Keyingi →</button>
        }
    </section>
}
else if (question.Kind == TestQuestionKind.OralMeaning)
{
    <section class="test-question" aria-live="polite">
        <div class="tags"><span class="pill">@KindLabel(question.Kind)</span></div>
        <span class="kicker">Ma’nosini ovoz chiqarib ayting, keyin tekshiring</span>
        <p class="prompt ko" lang="ko">@question.Prompt</p>
        <Speak Text="@question.Prompt" />
        @if (_revealed == question.Index || question.Given is not null)
        {
            <p class="meaning-reveal">@question.Translation</p>
            <div class="options">
                @foreach (var option in question.Options)
                {
                    var o = option;
                    <button class="button option @(question.Given == o ? "chosen" : "")" aria-pressed="@(question.Given == o)" disabled="@_busy" @onclick="() => AnswerAsync(question, o)">@o</button>
                }
            </div>
        }
        else
        {
            <button class="button primary big block" style="margin-top:16px" @onclick="() => _revealed = question.Index">Javobni ko‘rsatish</button>
        }
    </section>
}
else
{
<section class="test-question" aria-live="polite">
    <div class="tags">
        <span class="pill">@KindLabel(question.Kind)</span>
        @if (question.AiMade)
        {
            <span class="pill">TOPIK uslubida</span>
        }
    </div>

    @if (question.Kind == TestQuestionKind.WordUsage && question.Sentence is not null)
    {
        @* The Uzbek meaning comes first: the point is to pick the Korean word that really says it (D-46). *@
        <span class="kicker">@question.Prompt</span>
        <p class="usage-uz">@question.Translation</p>
        <p class="sentence big" lang="ko">@Blanked(question.Sentence)</p>
    }
    else if (question.Sentence is not null)
    {
        <span class="kicker">@question.Prompt</span>
        <p class="sentence big" lang="ko">@Blanked(question.Sentence)</p>
        @if (question.Translation is not null)
        {
            <p class="muted">@question.Translation</p>
        }
    }
    else
    {
        <span class="question-ask">@(question.Kind switch { TestQuestionKind.WordMeaning => "Bu so‘z nimani bildiradi?", TestQuestionKind.WordKorean => "Koreyschasi qaysi?", TestQuestionKind.WordListening => "Eshitgan so‘zingizni tanlang", _ => "Bu so‘z nimani bildiradi?" })</span>
        @if (question.Kind == TestQuestionKind.WordListening)
        {
            @* The word is only heard (spec §4.4): the recording comes from the test, the text stays on the server. *@
            <p class="prompt">@question.Prompt</p>
            <Speak Text="@($"{Id}:{question.Index}")" Source="@($"api/tests/{Id}/questions/{question.Index}/audio")" />
        }
        else
        {
            <p class="prompt @(IsKoreanPrompt(question.Kind) ? "ko" : "")" lang="@(IsKoreanPrompt(question.Kind) ? "ko" : null)">@question.Prompt</p>
        }
        @if (question.Kind == TestQuestionKind.WordMeaning)
        {
            <Speak Text="@question.Prompt" />
        }
    }

    @if (question.Kind == TestQuestionKind.WordClozeTyped)
    {
        <label class="field">
            Javobingiz (koreyscha)
            <input class="input sentence" lang="ko" maxlength="40" autocomplete="off" @bind="_typed" @bind:event="oninput" @onkeydown="TypedKeyAsync" disabled="@_busy" />
        </label>
        <button class="button primary big" disabled="@(_busy || string.IsNullOrWhiteSpace(_typed))" @onclick="() => AnswerAsync(question, _typed)">Keyingi</button>
    }
    else
    {
        <div class="choice-list">
            @for (var i = 0; i < question.Options.Count; i++)
            {
                var o = question.Options[i];
                <button class="choice @(question.Given == o ? "chosen" : "")" aria-pressed="@(question.Given == o)" disabled="@_busy" @onclick="() => AnswerAsync(question, o)">
                    <span class="choice-letter">@((char)('A' + i))</span>
                    <span class="choice-text" lang="@(IsKoreanOption(question.Kind) ? "ko" : null)">@o</span>
                </button>
            }
        </div>
    }
</section>
}

@if (_error is not null)
{
    <div class="notice" role="alert">@_error</div>
}

<section class="test-foot">
    <p class="muted small-text">@(_test.Unit is { } u ? $"O‘tish uchun {u.PassMark} ta to‘g‘ri javob kerak. " : "")Javoblar oxirida ko‘rsatiladi.@(_test.Warning is null ? "" : $" {_test.Warning}")</p>
    @if (_test.Answered == _test.Questions.Count || _confirmFinish)
    {
        <button class="btn btn-primary block big" disabled="@_busy" @onclick="FinishAsync"><span>Yakunlash va natijani ko‘rish</span><Icon Name="arrow-right" /></button>
        @if (_test.Answered < _test.Questions.Count)
        {
            <p class="muted small-text">@(_test.Questions.Count - _test.Answered) ta savolga javob berilmagan, ular xato hisoblanadi.</p>
        }
    }
    else
    {
        <button class="btn btn-primary block big" disabled="@(_position >= _test.Questions.Count - 1)" @onclick="() => Go(_position + 1)"><span>Keyingisi</span><Icon Name="arrow-right" /></button>
        <div class="test-foot-links">
            <button class="btn btn-ghost small" disabled="@(_position == 0)" @onclick="() => Go(_position - 1)">← Oldingi</button>
            <button class="btn btn-ghost small" @onclick="() => _confirmFinish = true">Hozir yakunlash</button>
        </div>
    }
</section>

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>A unit test goes back to its unit, a practice test to the tests page.</summary>
    private string Back => _test?.Unit is { } unit ? $"bolimlar/{unit.UnitId}" : "sinov";

    private TestDto? _test;
    private int _position;
    private string _typed = "";
    private bool _busy;
    private bool _confirmFinish;
    private string? _error;

    private int? _revealed;

    private bool IsOral => _test?.Questions.Any(q => q.Kind is TestQuestionKind.OralKorean or TestQuestionKind.OralMeaning) == true;

    /// <summary>An oral answer stays on screen so the learner sees what was heard; "Keyingi" moves on.</summary>
    private void OralAnsweredAsync(TestDto updated)
    {
        _test = updated;
        _error = null;
    }

    private void NextUnanswered()
    {
        var current = _position;
        var next = _test!.Questions.Skip(current + 1).FirstOrDefault(q => q.Given is null && !q.Technical)
            ?? _test.Questions.FirstOrDefault(q => q.Given is null && !q.Technical);
        Go(next?.Index ?? Math.Min(current + 1, _test.Questions.Count - 1));
    }

    protected override async Task OnParametersSetAsync()
    {
        var result = await Api.GetAsync<TestDto>($"api/tests/{Id}");
        _error = result.Ok ? null : result.Error;
        _test = result.Value;
        if (_test is { Status: TestRunStatus.InProgress })
        {
            // Continue at the first unanswered question.
            var next = _test.Questions.FirstOrDefault(q => q.Given is null);
            Go(next?.Index ?? _test.Questions.Count - 1);
        }
    }

    private void Go(int position)
    {
        _position = Math.Clamp(position, 0, _test!.Questions.Count - 1);
        _typed = _test.Questions[_position].Given ?? "";
        _error = null;
    }

    private async Task TypedKeyAsync(KeyboardEventArgs e)
    {
        // Enter only after the Korean IME has finished the syllable.
        if (e.Key == "Enter" && !e.IsComposing && !string.IsNullOrWhiteSpace(_typed))
        {
            await AnswerAsync(_test!.Questions[_position], _typed);
        }
    }

    private async Task AnswerAsync(TestQuestionDto question, string answer)
    {
        _busy = true;
        var result = await Api.SendJsonAsync<TestDto>(HttpMethod.Post, $"api/tests/{Id}/answers", new TestAnswerRequest(question.Index, answer.Trim()));
        _busy = false;
        if (result.Value is not { } updated)
        {
            _error = result.Error;
            return;
        }

        _test = updated;
        var next = updated.Questions.Skip(question.Index + 1).FirstOrDefault(q => q.Given is null)
            ?? updated.Questions.FirstOrDefault(q => q.Given is null);
        Go(next?.Index ?? question.Index);
    }

    private async Task FinishAsync()
    {
        _busy = true;
        var result = await Api.SendJsonAsync<TestDto>(HttpMethod.Post, $"api/tests/{Id}/finish");
        _busy = false;
        _error = result.Ok ? null : result.Error;
        _test = result.Value ?? _test;
    }

    /// <summary>The words answered wrong, on the cards (spec §4.4 "Xato qilgan N ta so‘zni takrorlash").</summary>
    private async Task DrillWrongAsync(IReadOnlyList<Guid> items)
    {
        _busy = true;
        var result = await Api.SendJsonAsync<StartSessionResponse>(HttpMethod.Post, "api/sessions", new StartSessionRequest(null, true, LearningItemIds: items));
        _busy = false;
        if (result.Value?.Session is not null)
        {
            Nav.NavigateTo("mashq/kartochka");
            return;
        }

        _error = result.Value?.Message ?? result.Error;
    }

    /// <summary>A new attempt: new order, new wrong options, another mix of question types (spec §4.4).</summary>
    private async Task RetakeAsync(UnitTestInfoDto unit)
    {
        _busy = true;
        var kind = unit.Purpose == TestPurpose.UnitSkip ? UnitTestKind.Skip : UnitTestKind.Final;
        var result = await Api.SendJsonAsync<TestDto>(HttpMethod.Post, $"api/units/{unit.UnitId}/tests", new StartUnitTestRequest(Guid.NewGuid(), kind));
        _busy = false;
        if (result.Value is { } next)
        {
            Nav.NavigateTo($"sinov/{next.Id}"); // the page loads it from its new id
            return;
        }

        _error = result.Error;
    }

    private readonly HashSet<int> _reported = [];

    private async Task ReportAsync(int index)
    {
        _busy = true;
        try
        {
            var result = await Api.SendJsonAsync<object>(HttpMethod.Post, $"api/tests/{Id}/questions/{index}/report", new QuestionReportRequest(null));
            _error = result.Ok ? null : result.Error;
            if (result.Ok)
            {
                _reported.Add(index);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RetryMistakesAsync()
    {
        _busy = true;
        var result = await Api.SendJsonAsync<TestDto>(HttpMethod.Post, "api/tests", new CreateTestRequest(Guid.NewGuid(), null, 0, Id));
        _busy = false;
        if (result.Value is { } retry)
        {
            Nav.NavigateTo($"sinov/{retry.Id}");
            return;
        }

        _error = result.Error;
    }

    private static bool IsKoreanPrompt(TestQuestionKind kind) => kind is TestQuestionKind.WordMeaning;

    private static bool IsKoreanOption(TestQuestionKind kind) => kind is TestQuestionKind.WordKorean or TestQuestionKind.WordCloze or TestQuestionKind.WordListening;

    private static RenderFragment Blanked(string sentence) => builder =>
    {
        var parts = sentence.Split("___");
        for (var i = 0; i < parts.Length; i++)
        {
            builder.AddContent(0, parts[i]);
            if (i < parts.Length - 1)
            {
                builder.OpenElement(1, "span");
                builder.AddAttribute(2, "class", "blank");
                builder.AddContent(3, "      ");
                builder.CloseElement();
            }
        }
    };

    private static string Filled(TestQuestionDto q) => q.Sentence!.Replace("___", $"[{q.Correct}]");

    private static string KindLabel(TestQuestionKind kind) => kind switch
    {
        TestQuestionKind.WordMeaning => "So‘z → ma’no",
        TestQuestionKind.WordKorean => "Ma’no → so‘z",
        TestQuestionKind.WordCloze => "Gapni to‘ldirish",
        TestQuestionKind.WordClozeTyped => "Gapni to‘ldirish (yozish)",
        TestQuestionKind.OralKorean => "Koreyschasini aytish",
        TestQuestionKind.OralMeaning => "Ma’nosini aytish",
        TestQuestionKind.WordUsage => "So‘z qo‘llanishi",
        TestQuestionKind.WordListening => "Tinglash",
        _ => kind.ToString(),
    };
}
