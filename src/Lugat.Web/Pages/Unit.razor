@page "/bolimlar/{Id:guid}"
@using Lugat.Contracts
@using Lugat.Domain.Catalog
@implements IDisposable
@inject SessionService Api
@inject NavigationManager Nav

<PageTitle>@(_unit?.Unit.Label ?? "Bo‘lim") — Koreyscha</PageTitle>

@* A unit (spec §4.3): 1 table, 2 cards, 3 exercises, 4 the unit test. The steps are a guide, not a forced order;
   only the test finishes a unit (stage 4). Opening the page the first time creates the unit's cards (spec §5.3). *@
@if (_unit is null)
{
    <AppHeader Title="Bo‘lim" Back="bolimlar" />
    @if (_error is not null)
    {
        <div class="notice" role="alert">@_error</div>
    }
    else
    {
        <div aria-busy="true" style="margin-top:16px"><span class="skeleton" style="width:60%"></span><span class="skeleton" style="width:80%;margin-top:12px"></span></div>
    }
    return;
}

<AppHeader Title="@($"{_unit.Unit.Number}-bo‘lim")" Back="bolimlar">
    <Right>
        @if (_step == 1)
        {
            @* Study time (UI handoff 1d): counts down from opening the table; a tap switches 5 → 10 → 15 minutes. *@
            <button type="button" class="timer-box @(Left() is { } l && l <= TimeSpan.Zero ? "over" : "")" role="timer" aria-label="Yodlash vaqti. Bosib 5, 10 yoki 15 daqiqani tanlang" @onclick="NextMinutes">
                @TimerText()
            </button>
        }
        else if (_unit.Unit.State == UnitState.Passed)
        {
            <Tag Kind="accent">Tugallangan@(_unit.Unit.BestScorePercent is { } best ? $" · {best}%" : "")</Tag>
        }
    </Right>
</AppHeader>

<UnitStepper Current="_step" Compact="true" OnSelect="s => _step = s" />

@if (_error is not null)
{
    <div class="notice" role="alert">@_error</div>
}

@if (_step == 2)
{
    <section class="unit-step">
        <h3>Kartochka</h3>
        <p class="muted small-text">Shu bo‘limning @_unit.Words.Count ta so‘zi ikki yo‘nalishda: avval o‘zingiz eslaysiz, keyin javobni ochib baholaysiz. Javoblar takrorlash jadvaliga yoziladi.</p>
        <button class="btn btn-primary block big" disabled="@_busy" @onclick="ToCardsAsync"><span>Kartochkani boshlash · @(_unit.Words.Count * 2) karta</span><Icon Name="arrow-right" /></button>
    </section>
    return;
}

@if (_step == 3)
{
    <section class="unit-step">
        <h3>Mashq</h3>
        <ListRow Label="Yozma mashq" Note="So‘zni yozib tarjima qilish" Href="@($"mashq/yozish?unit={Id}")" />
        <ListRow Label="Qaysi so‘z to‘g‘ri?" Note="So‘zni gapda to‘g‘ri ishlatish" Href="mashq/qollanish" />
    </section>
    return;
}

@if (_step == 4)
{
    <section class="unit-step">
        <h3>Bo‘lim testi</h3>
        <p class="muted small-text">Har so‘zdan bitta savol; 80% to‘g‘ri bo‘lsa (25 savolda 20 ta) bo‘lim tugaydi va keyingisi ochiladi.</p>
        <p class="muted small-text">Savollar: so‘z → ma’no, ma’no → so‘z va eshitib tanlash. Javoblar test oxirida ko‘rsatiladi; test kartochkalar jadvalini o‘zgartirmaydi. Qayta topshirish cheklanmagan.</p>
        @* Only the server's grading opens the next unit (spec §5.3). *@
        <button class="btn btn-primary block big" disabled="@_busy" @onclick="StartTestAsync"><span>@(_unit.Unit.State == UnitState.Passed ? "Testni qayta topshirish" : "Testni boshlash")</span><Icon Name="arrow-right" /></button>
    </section>
    return;
}

<div class="cover-bar">
    <span class="muted small-text">Yopish:</span>
    <div class="seg" role="radiogroup" aria-label="Ustunni yopish">
        @foreach (var (mode, label) in Modes)
        {
            var m = mode;
            <button class="@(_cover == m ? "selected" : "")" role="radio" aria-checked="@(_cover == m)" lang="@(m == CoverMode.Korean ? "ko" : null)" @onclick="() => Cover(m)">@label</button>
        }
    </div>
</div>
@if (_cover != CoverMode.None)
{
    <p class="muted small-text cover-hint">Yopiq katakni bossangiz, faqat o‘sha so‘z ochiladi. Avval o‘zingiz eslab ko‘ring.</p>
}

<table class="word-table">
    <thead>
        <tr><th class="n">№</th><th lang="ko">한국어</th><th>O‘zbekcha</th></tr>
    </thead>
    <tbody>
        @foreach (var w in _unit.Words)
        {
            var word = w;
            var koHidden = _cover == CoverMode.Korean && !_shown.Contains(w.Id);
            var uzHidden = _cover == CoverMode.Uzbek && !_shown.Contains(w.Id);
            <tr class="@(_selected == w.Id ? "selected" : "")">
                <td class="n">@w.Order</td>
                <td class="ko" lang="ko" @onclick="() => Tap(word, koHidden)">
                    @if (koHidden)
                    {
                        <span class="covered" aria-label="Yopiq. Ochish uchun bosing"></span>
                    }
                    else
                    {
                        <span>@w.Word</span>
                        @if (ShowRomanization && w.Romanization is not null)
                        {
                            <small>@w.Romanization</small>
                        }
                    }
                </td>
                <td class="uz" @onclick="() => Tap(word, uzHidden)">
                    @if (uzHidden)
                    {
                        <span class="covered" aria-label="Yopiq. Ochish uchun bosing"></span>
                    }
                    else
                    {
                        @w.TranslationUz
                    }
                </td>
            </tr>
            @if (_selected == w.Id && !koHidden)
            {
                <tr class="speak-row">
                    <td></td>
                    <td colspan="2">
                        <Speak Text="@w.Word" />
                        @if (!uzHidden)
                        {
                            <div class="usage-note">
                                <p class="muted small-text">@w.PosUz@(w.Theme is null ? "" : $" · {w.Theme}")</p>
                                @if (w.TrapUz is not null)
                                {
                                    <div class="trap"><span class="trap-title"><Icon Name="triangle-alert" Size="14" Stroke="2.2" /> O‘zbekcha tuzoq</span><p>@w.TrapUz</p></div>
                                }
                                @if (w.ExampleKo is not null)
                                {
                                    <p class="usage-example"><span lang="ko">@w.ExampleKo</span><br /><span class="muted">@w.ExampleUz</span></p>
                                }
                            </div>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<p class="muted small-text" style="margin-top:12px">Koreyscha so‘zni bossangiz, talaffuzini, misol va tuzoqni ko‘rasiz. Jadval kartochkalarning takrorlash jadvalini o‘zgartirmaydi.</p>
<p class="muted small-text">Manba: 국립국어원 한국어 학습용 어휘 목록 (KOGL 1-tur).</p>

<div class="sticky-space"></div>
<div class="sticky-action">
    <button class="btn btn-primary block big" disabled="@_busy" @onclick="ToCardsAsync"><span>Kartochkaga o‘tish</span><Icon Name="arrow-right" /></button>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private enum CoverMode
    {
        None,
        Korean,
        Uzbek,
    }

    private static readonly int[] Minutes = [5, 10, 15];

    private static readonly (CoverMode Mode, string Label)[] Modes =
    [
        (CoverMode.None, "Hech"),
        (CoverMode.Korean, "한국어"),
        (CoverMode.Uzbek, "O‘zbekcha"),
    ];

    private UnitDto? _unit;
    private int _step = 1;

    /// <summary>The step to open, e.g. "Davom etish — kartochka" on the home page (UI handoff 1b).</summary>
    [SupplyParameterFromQuery(Name = "qadam")] public int? Qadam { get; set; }
    private string? _error;
    private int _minutes = 10;
    private DateTimeOffset? _startedAt;
    private CoverMode _cover;
    private readonly HashSet<Guid> _shown = [];
    private Guid? _selected;
    private Timer? _clock;
    private bool _busy;

    private bool ShowRomanization => Api.State.Me?.ShowRomanization != false;

    protected override async Task OnParametersSetAsync()
    {
        if (Qadam is >= 1 and <= 4)
        {
            _step = Qadam.Value;
        }

        var result = await Api.GetAsync<UnitDto>($"api/units/{Id}");
        if (result.Value is { CardsReady: false })
        {
            // First visit: the server creates the unit's cards, once (spec §5.3).
            result = await Api.SendJsonAsync<UnitDto>(HttpMethod.Post, $"api/units/{Id}/open");
        }

        _unit = result.Value;
        _error = result.Ok ? null : result.Error;
        if (_unit is not null && _startedAt is null)
        {
            Start();
        }
    }

    private void NextMinutes()
    {
        _minutes = Minutes[(Array.IndexOf(Minutes, _minutes) + 1) % Minutes.Length];
        Start();
    }

    private string TimerText() => Left() is { } left && left > TimeSpan.Zero
        ? $"{(int)left.TotalMinutes:00}:{left.Seconds:00}"
        : "00:00";

    private void Start()
    {
        _startedAt = DateTimeOffset.UtcNow;
        _clock?.Dispose();
        _clock = new Timer(_ => InvokeAsync(Tick), null, 1000, 1000);
    }

    /// <summary>Counted from the start time, so a phone that paused the page still shows the right time.</summary>
    private TimeSpan? Left() => _startedAt is { } at ? at.AddMinutes(_minutes) - DateTimeOffset.UtcNow : null;

    private void Tick()
    {
        if (Left() is { } left && left <= TimeSpan.Zero)
        {
            _clock?.Dispose();
            _clock = null;
        }

        StateHasChanged();
    }

    private void Cover(CoverMode mode)
    {
        _cover = mode;
        _shown.Clear();
    }

    private void Tap(CatalogWordDto word, bool hidden)
    {
        if (hidden)
        {
            _shown.Add(word.Id);
        }

        _selected = word.Id;
    }

    private async Task StartTestAsync()
    {
        _busy = true;
        var result = await Api.SendJsonAsync<TestDto>(HttpMethod.Post, $"api/units/{Id}/tests", new StartUnitTestRequest(Guid.NewGuid(), UnitTestKind.Final));
        _busy = false;
        if (result.Value is { } test)
        {
            Nav.NavigateTo($"sinov/{test.Id}");
            return;
        }

        _error = result.Error;
    }

    private async Task ToCardsAsync()
    {
        _busy = true;
        var result = await Api.SendJsonAsync<StartSessionResponse>(HttpMethod.Post, "api/sessions",
            new StartSessionRequest(null, true, Id));
        _busy = false;
        if (result.Value?.Session is not null)
        {
            Nav.NavigateTo("mashq/kartochka");
            return;
        }

        _error = result.Value?.Message ?? result.Error;
    }

    public void Dispose() => _clock?.Dispose();
}
