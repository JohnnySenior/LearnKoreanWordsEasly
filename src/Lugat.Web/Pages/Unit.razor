@page "/bolimlar/{Id:guid}"
@using Lugat.Contracts
@using Lugat.Domain.Catalog
@implements IDisposable
@inject SessionService Api
@inject NavigationManager Nav

<PageTitle>@(_unit?.Unit.Label ?? "Bo‘lim") — Lug‘at</PageTitle>

@* A unit (spec §4.3): 1 table, 2 cards, 3 exercises, 4 the unit test. The steps are a guide, not a forced order;
   only the test finishes a unit (stage 4). Opening the page the first time creates the unit's cards (spec §5.3). *@
<a class="back" href="bolimlar">← Bo‘limlar</a>

@if (_unit is null)
{
    <p class="muted">@(_error ?? "Yuklanmoqda…")</p>
    return;
}

<header class="page-head">
    <div>
        <h1>@_unit.Unit.Number-bo‘lim</h1>
        <span class="muted small-text">@_unit.Unit.Label · @_unit.Words.Count ta so‘z · @_unit.Words.Count(w => w.Started) tasi kartochkada boshlangan</span>
    </div>
    @if (_unit.Unit.State == UnitState.Passed)
    {
        <span class="pill pill-ok">Tugallangan@(_unit.Unit.BestScorePercent is { } best ? $" · {best}%" : "")</span>
    }
</header>

<ol class="steps" aria-label="Bo‘lim qadamlari">
    <li class="@(_step == 1 ? "current" : "")"><button class="link-btn" @onclick="() => _step = 1">1. Jadval</button></li>
    <li class="@(_step == 2 ? "current" : "")"><button class="link-btn" @onclick="() => _step = 2">2. Kartochka</button></li>
    <li class="@(_step == 3 ? "current" : "")"><button class="link-btn" @onclick="() => _step = 3">3. Mashqlar</button></li>
    <li class="@(_step == 4 ? "current" : "")"><button class="link-btn" @onclick="() => _step = 4">4. Test</button></li>
</ol>

@if (_error is not null)
{
    <div class="notice" role="alert">@_error</div>
}

@if (_step == 2)
{
    <section class="card">
        <h2>Kartochka</h2>
        <p class="muted small-text">Shu bo‘limning @_unit.Words.Count ta so‘zi ikki yo‘nalishda: avval o‘zingiz eslaysiz, keyin javobni ochib baholaysiz. Javoblar takrorlash jadvaliga yoziladi.</p>
        <button class="button primary block" disabled="@_busy" @onclick="ToCardsAsync"><span>Kartochkani boshlash</span><span class="aside">@(_unit.Words.Count * 2) karta</span></button>
    </section>
    return;
}

@if (_step == 3)
{
    <section class="card">
        <h2>Mashqlar</h2>
        <nav class="menu compact">
            <a href="@($"mashq/yozish?unit={Id}")"><span><span class="t">Yozma mashq</span><span class="s">So‘zni yozib tarjima qilish</span></span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></a>
            <a href="mashq/qollanish"><span><span class="t">Qaysi so‘z to‘g‘ri?</span><span class="s">So‘zni gapda to‘g‘ri ishlatish</span></span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg></a>
        </nav>
    </section>
    return;
}

@if (_step == 4)
{
    <section class="card">
        <h2>Bo‘lim testi</h2>
        <p class="muted small-text">25 savol, 80% (20 ta to‘g‘ri) bo‘lsa bo‘lim tugaydi va keyingisi ochiladi.</p>
        @* The unit test (spec §4.4) is stage 4; nothing here may open a unit (spec §5.3). *@
        <button class="button primary block" disabled>Testni boshlash</button>
        <p class="muted small-text">Bo‘lim testi keyingi yangilanishda qo‘shiladi.</p>
    </section>
    return;
}

<div class="study-bar">
    @if (_startedAt is null)
    {
        <div class="seg" role="radiogroup" aria-label="Yodlash vaqti">
            @foreach (var m in Minutes)
            {
                var minutes = m;
                <button class="@(_minutes == minutes ? "selected" : "")" role="radio" aria-checked="@(_minutes == minutes)" @onclick="() => _minutes = minutes">@minutes daq</button>
            }
        </div>
        <button class="button primary block" @onclick="Start">Yodlashni boshlash</button>
    }
    else if (Left() is { } left && left > TimeSpan.Zero)
    {
        <div class="row-between">
            <span class="muted small-text">Yodlash vaqti</span>
            <span class="timer" role="timer" aria-label="Qolgan vaqt">@($"{(int)left.TotalMinutes:00}:{left.Seconds:00}")</span>
        </div>
    }
    else
    {
        <p style="margin:0 0 8px"><strong>@_minutes daqiqa tugadi.</strong> Endi kartochkada eslab ko‘ring: avval o‘zingiz eslaysiz, keyin javobni ochasiz.</p>
    }

    @if (_startedAt is not null)
    {
        <button class="button @(Left() is { } l && l > TimeSpan.Zero ? "" : "primary") block" disabled="@_busy" @onclick="ToCardsAsync">
            <span>Kartochkaga o‘tish</span><span class="aside">@_unit.Words.Count so‘z</span>
        </button>
    }
</div>

<div class="seg" role="radiogroup" aria-label="Ustunni yopish" style="margin-top:12px">
    @foreach (var (mode, label) in Modes)
    {
        var m = mode;
        <button class="@(_cover == m ? "selected" : "")" role="radio" aria-checked="@(_cover == m)" @onclick="() => Cover(m)">@label</button>
    }
</div>
@if (_cover != CoverMode.None)
{
    <p class="muted small-text">Yopiq katakni bossangiz, faqat o‘sha so‘z ochiladi. Avval o‘zingiz eslab ko‘ring.</p>
}

@if (_error is not null)
{
    <div class="notice" role="alert">@_error</div>
}

<table class="word-table">
    <thead>
        <tr><th class="n">№</th><th>한국어</th><th>O‘zbekcha</th></tr>
    </thead>
    <tbody>
        @foreach (var w in _unit.Words)
        {
            var word = w;
            var koHidden = _cover == CoverMode.Korean && !_shown.Contains(w.Id);
            var uzHidden = _cover == CoverMode.Uzbek && !_shown.Contains(w.Id);
            <tr class="@(_selected == w.Id ? "selected" : "")">
                <td class="n">@w.Order</td>
                <td class="ko" lang="ko" @onclick="() => Tap(word, koHidden)">
                    @if (koHidden)
                    {
                        <span class="covered" aria-label="Yopiq. Ochish uchun bosing"></span>
                    }
                    else
                    {
                        <span>@w.Word</span>
                        @if (ShowRomanization && w.Romanization is not null)
                        {
                            <small>@w.Romanization</small>
                        }
                    }
                </td>
                <td class="uz" @onclick="() => Tap(word, uzHidden)">
                    @if (uzHidden)
                    {
                        <span class="covered" aria-label="Yopiq. Ochish uchun bosing"></span>
                    }
                    else
                    {
                        @w.TranslationUz
                    }
                </td>
            </tr>
            @if (_selected == w.Id && !koHidden)
            {
                <tr class="speak-row">
                    <td></td>
                    <td colspan="2">
                        <Speak Text="@w.Word" />
                        @if (!uzHidden)
                        {
                            <div class="usage-note">
                                <p class="muted small-text">@w.PosUz@(w.Theme is null ? "" : $" · {w.Theme}")</p>
                                @if (w.TrapUz is not null)
                                {
                                    <p class="usage-trap"><strong>O‘zbekcha tuzoq.</strong> @w.TrapUz</p>
                                }
                                @if (w.ExampleKo is not null)
                                {
                                    <p class="usage-example"><span lang="ko">@w.ExampleKo</span><br /><span class="muted">@w.ExampleUz</span></p>
                                }
                            </div>
                        }
                    </td>
                </tr>
            }
        }
    </tbody>
</table>
<p class="muted small-text">Koreyscha so‘zni bossangiz, talaffuzini, misol va tuzoqni ko‘rasiz. Jadval kartochkalarning takrorlash jadvalini o‘zgartirmaydi.</p>
<p class="muted small-text">Manba: 국립국어원 한국어 학습용 어휘 목록 (KOGL 1-tur).</p>

@code {
    [Parameter] public Guid Id { get; set; }

    private enum CoverMode
    {
        None,
        Korean,
        Uzbek,
    }

    private static readonly int[] Minutes = [5, 10, 15];

    private static readonly (CoverMode Mode, string Label)[] Modes =
    [
        (CoverMode.None, "Ochiq"),
        (CoverMode.Korean, "한국어 yopiq"),
        (CoverMode.Uzbek, "O‘zbek yopiq"),
    ];

    private UnitDto? _unit;
    private int _step = 1;
    private string? _error;
    private int _minutes = 10;
    private DateTimeOffset? _startedAt;
    private CoverMode _cover;
    private readonly HashSet<Guid> _shown = [];
    private Guid? _selected;
    private Timer? _clock;
    private bool _busy;

    private bool ShowRomanization => Api.State.Me?.ShowRomanization != false;

    protected override async Task OnParametersSetAsync()
    {
        var result = await Api.GetAsync<UnitDto>($"api/units/{Id}");
        if (result.Value is { CardsReady: false })
        {
            // First visit: the server creates the unit's cards, once (spec §5.3).
            result = await Api.SendJsonAsync<UnitDto>(HttpMethod.Post, $"api/units/{Id}/open");
        }

        _unit = result.Value;
        _error = result.Ok ? null : result.Error;
    }

    private void Start()
    {
        _startedAt = DateTimeOffset.UtcNow;
        _clock?.Dispose();
        _clock = new Timer(_ => InvokeAsync(Tick), null, 1000, 1000);
    }

    /// <summary>Counted from the start time, so a phone that paused the page still shows the right time.</summary>
    private TimeSpan? Left() => _startedAt is { } at ? at.AddMinutes(_minutes) - DateTimeOffset.UtcNow : null;

    private void Tick()
    {
        if (Left() is { } left && left <= TimeSpan.Zero)
        {
            _clock?.Dispose();
            _clock = null;
        }

        StateHasChanged();
    }

    private void Cover(CoverMode mode)
    {
        _cover = mode;
        _shown.Clear();
    }

    private void Tap(CatalogWordDto word, bool hidden)
    {
        if (hidden)
        {
            _shown.Add(word.Id);
        }

        _selected = word.Id;
    }

    private async Task ToCardsAsync()
    {
        _busy = true;
        var result = await Api.SendJsonAsync<StartSessionResponse>(HttpMethod.Post, "api/sessions",
            new StartSessionRequest(null, true, Id));
        _busy = false;
        if (result.Value?.Session is not null)
        {
            Nav.NavigateTo("mashq/kartochka");
            return;
        }

        _error = result.Value?.Message ?? result.Error;
    }

    public void Dispose() => _clock?.Dispose();
}
