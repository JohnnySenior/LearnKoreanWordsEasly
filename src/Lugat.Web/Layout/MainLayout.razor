@inherits LayoutComponentBase
@implements IDisposable
@inject SessionService Api
@inject NavigationManager Nav
@inject BrowserInterop Browser

@* The app shows only after sign-in (spec §4.1, §6.3); without a session the sign-in screen takes its place. *@
@if (_state is null || _state.Status == SessionStatus.Unknown)
{
    <div class="boot">
        <div class="boot-title">Lug‘at</div>
        <div class="boot-text">Yuklanmoqda…</div>
    </div>
    return;
}

@if (IsPublicPage)
{
    <main class="content">@Body</main>
    return;
}

@if (_state.Status != SessionStatus.SignedIn)
{
    <main class="content signin-page">
        <h1>Lug‘at</h1>
        <p class="lead-text">Koreys tili so‘zlarini o‘zbek tilida, eng ko‘p ishlatiladiganlaridan boshlab o‘rganing.</p>
        @if (_state.Status == SessionStatus.Unavailable)
        {
            <div class="notice" role="alert">@_state.Message <button class="button small" @onclick="RetryAsync">Qayta urinish</button></div>
        }
        else
        {
            <section class="card">
                <h2>Kirish</h2>
                <p class="muted small-text">Telegram yoki Google hisobingiz bilan kiring. Parol kerak emas.</p>
                <SignIn />
            </section>
        }
        <p class="muted small-text">Manba: 국립국어원 한국어 학습용 어휘 목록 (KOGL 1). <a href="maxfiylik">Maxfiylik siyosati</a></p>
    </main>
    <UpdateBanner />
    return;
}

@if (_onboarding)
{
    <Onboarding Done="() => _onboarding = false" />
    <UpdateBanner />
    return;
}

<div class="shell">
    <main class="content">
        @Body
    </main>

    <nav class="tabbar" aria-label="Asosiy bo‘limlar">
        <NavLink href="" Match="NavLinkMatch.All" class="tab"><Icon Name="home" Class="tab-icon" /><span>Bosh</span></NavLink>
        <NavLink href="bolimlar" class="tab"><Icon Name="layers" Class="tab-icon" /><span>Bo‘limlar</span></NavLink>
        <NavLink href="takrorlash" class="tab"><Icon Name="rotate-ccw" Class="tab-icon" /><span>Takror</span></NavLink>
        <NavLink href="mashq" class="tab"><Icon Name="target" Class="tab-icon" /><span>Mashq</span></NavLink>
        <NavLink href="profil" class="tab"><Icon Name="user" Class="tab-icon" /><span>Profil</span></NavLink>
    </nav>
    <UpdateBanner />
</div>

@code {
    private SessionState? _state;

    // Pages anyone may open without signing in (the privacy policy is linked from the sign-in screen).
    private bool IsPublicPage => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0] == "maxfiylik";
    private bool _onboarding;
    private bool _onboardingChecked;

    protected override async Task OnInitializedAsync()
    {
        Api.Changed += OnChanged;
        Api.PremiumRequired += OnPremiumRequired;
        _state = await Api.EnsureSignedInAsync();
        await ApplyThemeAsync();
        await CheckOnboardingAsync();
    }

    // Once per device, right after the first sign-in (spec §4.1).
    private async Task CheckOnboardingAsync()
    {
        if (_onboardingChecked || _state?.Status != SessionStatus.SignedIn)
        {
            return;
        }

        _onboardingChecked = true;
        _onboarding = await Browser.StorageGetAsync(Onboarding.SeenKey) is null;
        await ApplyReferralAsync();
    }

    // "/?ref=CODE" (spec §4.1): a teacher's promo code goes with the learner to the Premium page (spec §9.1).
    private async Task ApplyReferralAsync()
    {
        var uri = new Uri(Nav.Uri);
        var code = uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(p => p.Split('=', 2))
            .Where(p => p.Length == 2 && p[0] == "ref")
            .Select(p => Uri.UnescapeDataString(p[1]))
            .FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(code))
        {
            await Api.SendJsonAsync<object>(HttpMethod.Post, "api/me/referral", new Lugat.Contracts.ReferralRequest(code));
            Nav.NavigateTo(uri.AbsolutePath, replace: true);
        }
    }

    private async Task RetryAsync()
    {
        _state = null;
        StateHasChanged();
        _state = await Api.EnsureSignedInAsync();
        await CheckOnboardingAsync();
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        _state = Api.State;
        await ApplyThemeAsync();
        await CheckOnboardingAsync();
        StateHasChanged();
    });

    private Task ApplyThemeAsync() => Browser.SetThemeAsync(_state?.Me?.Theme ?? Lugat.Domain.Users.ThemeChoice.Device);

    private void OnPremiumRequired() => InvokeAsync(() => Nav.NavigateTo("premium"));

    public void Dispose()
    {
        Api.Changed -= OnChanged;
        Api.PremiumRequired -= OnPremiumRequired;
    }
}
