@inherits LayoutComponentBase
@implements IDisposable
@inject SessionService Api
@inject BrowserInterop Browser

@* The app shows only after sign-in (spec §4.1, §6.3); without a session the sign-in screen takes its place. *@
@if (_state is null || _state.Status == SessionStatus.Unknown)
{
    <div class="boot">
        <div class="boot-title">Lug‘at</div>
        <div class="boot-text">Yuklanmoqda…</div>
    </div>
    return;
}

@if (_state.Status != SessionStatus.SignedIn)
{
    <main class="content signin-page">
        <h1>Lug‘at</h1>
        <p class="lead-text">Koreys tili so‘zlarini o‘zbek tilida, eng ko‘p ishlatiladiganlaridan boshlab o‘rganing.</p>
        @if (_state.Status == SessionStatus.Unavailable)
        {
            <div class="notice" role="alert">@_state.Message <button class="button small" @onclick="RetryAsync">Qayta urinish</button></div>
        }
        else
        {
            <section class="card">
                <h2>Kirish</h2>
                <p class="muted small-text">Telegram yoki Google hisobingiz bilan kiring. Parol kerak emas.</p>
                <SignIn />
            </section>
        }
        <p class="muted small-text">Manba: 국립국어원 한국어 학습용 어휘 목록 (KOGL 1).</p>
    </main>
    return;
}

<div class="shell">
    <main class="content">
        @Body
    </main>

    <nav class="tabbar" aria-label="Asosiy bo‘limlar">
        <NavLink href="" Match="NavLinkMatch.All" class="tab"><svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="16" rx="2" /><path d="M3.5 9.5h17M8 2.5v4M16 2.5v4" /></svg><span>Bugun</span></NavLink>
        <NavLink href="lugatlar" class="tab"><svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v15H6.5A2.5 2.5 0 0 0 4 20.5z" /><path d="M4 20.5A2.5 2.5 0 0 0 6.5 23H20v-5" /></svg><span>Lug‘atlar</span></NavLink>
        <NavLink href="mashq" class="tab"><svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="13" height="15" rx="2" /><path d="M8 3h11a2 2 0 0 1 2 2v13" /></svg><span>Mashq</span></NavLink>
        <NavLink href="sinov" class="tab"><svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="2" /><path d="m8 12 3 3 5-6" /></svg><span>Sinov</span></NavLink>
    </nav>
</div>

@code {
    private SessionState? _state;

    protected override async Task OnInitializedAsync()
    {
        Api.Changed += OnChanged;
        _state = await Api.EnsureSignedInAsync();
        await ApplyThemeAsync();
    }

    private async Task RetryAsync()
    {
        _state = null;
        StateHasChanged();
        _state = await Api.EnsureSignedInAsync();
    }

    private void OnChanged() => InvokeAsync(async () =>
    {
        _state = Api.State;
        await ApplyThemeAsync();
        StateHasChanged();
    });

    private Task ApplyThemeAsync() => Browser.SetThemeAsync(_state?.Me?.Theme ?? Lugat.Domain.Users.ThemeChoice.Device);

    public void Dispose() => Api.Changed -= OnChanged;
}
