{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "AllowedHosts": "*",
  "Telegram": {
    "BotToken": "",
    "AllowedUserIds": [],
    "InitDataMaxAge": "00:05:00"
  },
  "Auth": {
    "AccessTokenLifetime": "01:00:00",
    "RefreshTokenLifetime": "7.00:00:00"
  },
  "Storage": {
    "Root": "App_Data/files"
  },
  "Imports": {
    "MaxFileBytes": 104857600,
    "MaxPages": 600
  }
}
