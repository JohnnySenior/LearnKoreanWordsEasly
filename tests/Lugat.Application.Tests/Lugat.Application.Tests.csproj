  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lugat.Infrastructure\Lugat.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
