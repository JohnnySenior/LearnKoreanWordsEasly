# Copy to your hosting secrets / environment. Never commit real values (spec §0 rule 9, AG03, SEC03).
# ASP.NET Core maps "__" to ":" in configuration keys.

# PostgreSQL (Npgsql key=value format, not a postgres:// URL).
# On Railway: Host=${{Postgres.PGHOST}};Port=${{Postgres.PGPORT}};... over the private network.
# "Gss Encryption Mode=Disable" stops Npgsql looking for Kerberos, which the runtime image does not ship.
ConnectionStrings__Default=Host=...;Port=5432;Database=...;Username=...;Password=...;Gss Encryption Mode=Disable

# Folder for generated audio (TTS cache). Must be a persistent volume in production.
Storage__Root=/data/files

# Data Protection keys (session tokens). Same persistent volume.
DataProtection__KeysPath=/data/keys

ASPNETCORE_ENVIRONMENT=Production

# Telegram bot: sign-in with the Login Widget (spec §6.3), reminders (D-16) and the weekly backup copy (D-37).
# The widget needs the bot's username and the app's domain set in BotFather (/setdomain).
Telegram__BotToken=
Telegram__BotUsername=

# Google Identity Services: OAuth client id of the web app (not secret; it is the ID token's audience).
# In Google Cloud console add the app's https origin to "Authorized JavaScript origins".
Google__ClientId=

# The first administrators (L-14): they get the Admin role when they sign in. Telegram user ids or Google "sub".
Auth__Admins__TelegramUserIds__0=
# Auth__Admins__GoogleSubjects__0=
# Optional limits (spec §6.4): sign-ins per minute per IP, tests started per hour per user, refresh token lifetime.
# Auth__SignInPerMinute=10
# Auth__TestStartsPerHour=20
# Auth__RefreshTokenLifetime=30.00:00:00
# Address the reminder button opens (the PWA). Empty = https://$RAILWAY_PUBLIC_DOMAIN.
# Telegram__AppUrl=
# Web Push reminders (L-63, docs/HOSTING.md): VAPID keys from `npx web-push generate-vapid-keys`. Empty = push off.
Push__PublicKey=
Push__PrivateKey=
# Push__Subject=https://koreyscha.com
# Telegram user id of the app's owner, who gets the weekly verified backup file. Empty = not sent.
Backup__TelegramChatId=

# Features that exist in code but stay hidden in v1 (spec §3.1).
# Features__Listening=false

# AI (D-21). Add one or both keys; the other one is the fallback.
Ai__Anthropic__ApiKey=
Ai__OpenAi__ApiKey=
# Optional: default service (Anthropic or OpenAi), model names and the per-learner daily call limit.
# Ai__DefaultProvider=Anthropic
# Ai__Anthropic__Model=claude-sonnet-5
# Ai__OpenAi__Model=gpt-5-mini
# Ai__MaxCallsPerUserPerDay=150
# OpenAI speech as the fallback voice (D-29)
# Ai__Tts__Model=gpt-4o-mini-tts
# Ai__Tts__Voice=coral
# Ai__Tts__MaleVoice=ash
# Ai__Tts__MaxNewPerUserPerDay=400
# Natural Korean voice (D-31): Azure Speech, Free F0
Ai__Tts__Azure__Key=
Ai__Tts__Azure__Region=
# Ai__Tts__Azure__Voice=ko-KR-SunHiNeural
# Ai__Tts__Azure__MaleVoice=ko-KR-InJoonNeural
# Pronunciation assessment (D-32) uses the same Azure key
# Ai__Tts__MaxAssessPerUserPerDay=200

# Shared calendar-month budget. Fill rates from dated provider billing; absent rates are explicitly unknown (D-50).
# Ai__TotalTimeout=00:01:40
# Ai__Budget__MonthlyLimitUsd=25
# Ai__Budget__WarningUsd=20
# Ai__Budget__HostingMonthlyUsd=
# Calls of a model with no price below are capped by count per month (hard stop without prices).
# Ai__Budget__MonthlyUnpricedCalls=2000
# Ai__Budget__Prices__0__Provider=OpenAi
# Ai__Budget__Prices__0__Model=<configured exact model>
# Ai__Budget__Prices__0__Unit=tokens
# Ai__Budget__Prices__0__InputPerMillionUsd=<dated rate>
# Ai__Budget__Prices__0__OutputPerMillionUsd=<dated rate>
# Ai__Budget__Prices__0__AsOf=<YYYY-MM-DD>
# Repeat with indexes 1, 2, ... for other text/speech models (characters or audio-ms).

# Katalog (L-17, L-21). Production'da false: so'zlar admin importi orqali (Sozlamalar → Kontent).
# Catalog__SeedSample=false

# Premium va to'lov (spec §7, L-30). Narxlar konfiguratsiyada: Premium__Plans__0__Plan=Monthly, __PriceKrw=5000, __Months=1 ...
# Premium__TrialDays=0
# L-64: birinchi bo'limdan keyin o'quvchi o'zi yoqadigan sinov (bir marta; 0 = o'chiq).
# Premium__EarnedTrialDays=3
# Premium__TrapNotesFree=true
# Bank rekvizitlari bo'sh bo'lsa Premium sahifasida "Tez orada" (spec §15 Q4). Maxfiy emas, lekin faqat Johnny kiritadi.
Payments__BankName=
Payments__AccountNumber=
Payments__AccountHolder=
Payments__ContactTelegram=
# Kunlik AI limitlari (spec §7.4): Premium o'quvchi 60, muharrir/admin 300; talaffuz baholash 60.
# Ai__MaxCallsPerUserPerDay=60
# Ai__MaxCallsPerEditorPerDay=300
# Ai__Tts__MaxAssessPerUserPerDay=60

# L-54: admin-approved introductions, narrator settings stay server-side.
# On Railway app these can reference studio.ELEVENLABS_API_KEY / VOICE_ID / MODEL.
ElevenLabs__ApiKey=
ElevenLabs__VoiceId=
# Uzbek narration requires a model that supports Uzbek (e.g. eleven_v3).
ElevenLabs__Model=eleven_v3
