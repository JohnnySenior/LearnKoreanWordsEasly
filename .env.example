# Copy to your hosting secrets / environment. Never commit real values (spec AG03, SEC03).
# ASP.NET Core maps "__" to ":" in configuration keys.

# BotFather token of the Telegram bot that opens the Mini App.
Telegram__BotToken=

# The two Telegram user IDs allowed in v1 (spec SEC02).
Telegram__AllowedUserIds__0=
Telegram__AllowedUserIds__1=
# Weekly backup copy to Telegram (D-37); empty = Telegram__AllowedUserIds__0
Backup__TelegramChatId=

# PostgreSQL (Npgsql key=value format, not a postgres:// URL).
# On Railway: Host=${{Postgres.PGHOST}};Port=${{Postgres.PGPORT}};... over the private network.
# "Gss Encryption Mode=Disable" stops Npgsql looking for Kerberos, which the runtime image does not ship.
ConnectionStrings__Default=Host=...;Port=5432;Database=...;Username=...;Password=...;Gss Encryption Mode=Disable

# Folder for original PDFs. Must be a persistent volume in production.
Storage__Root=/data/files

# Data Protection keys (session tokens). Same persistent volume.
DataProtection__KeysPath=/data/keys

ASPNETCORE_ENVIRONMENT=Production

# AI (D-21). Add one or both keys; the learner picks the service in Settings, the other one is the fallback.
Ai__Anthropic__ApiKey=
Ai__OpenAi__ApiKey=
# Optional: default service (Anthropic or OpenAi), model names and the per-learner daily call limit.
# Ai__DefaultProvider=Anthropic
# Ai__Anthropic__Model=claude-sonnet-5
# Ai__OpenAi__Model=gpt-5-mini
# Ai__MaxCallsPerUserPerDay=150
# Talaffuz (D-29): OpenAI kaliti bilan ishlaydi
# Ai__Tts__Model=gpt-4o-mini-tts
# Ai__Tts__Voice=coral
# Ai__Tts__MaleVoice=ash
# Ai__Tts__MaxNewPerUserPerDay=400
# Tabiiy koreyscha ovoz (D-31): Azure Speech, Free F0
Ai__Tts__Azure__Key=
Ai__Tts__Azure__Region=
# Ai__Tts__Azure__Voice=ko-KR-SunHiNeural
# Ai__Tts__Azure__MaleVoice=ko-KR-InJoonNeural   # tinglash dialoglaridagi erkak (D-53)
# Talaffuz tekshiruvi (D-32) shu Azure kaliti bilan ishlaydi
# Ai__Tts__MaxAssessPerUserPerDay=200


# Shared calendar-month budget. Fill rates from dated provider billing; absent rates are explicitly unknown.
# Ai__TotalTimeout=00:01:40
# Ai__Budget__MonthlyLimitUsd=25
# Ai__Budget__WarningUsd=20
# Ai__Budget__HostingMonthlyUsd=
# Ai__Budget__Prices__0__Provider=OpenAi
# Ai__Budget__Prices__0__Model=<configured exact model>
# Ai__Budget__Prices__0__Unit=tokens
# Ai__Budget__Prices__0__InputPerMillionUsd=<dated rate>
# Ai__Budget__Prices__0__OutputPerMillionUsd=<dated rate>
# Ai__Budget__Prices__0__AsOf=<YYYY-MM-DD>
# Repeat with indexes 1, 2, ... for other text/speech models (characters or audio-ms).
